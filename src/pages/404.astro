---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found">
  <section class="container-page py-24 md:py-36">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-serif text-5xl leading-tight text-ink md:text-7xl">This row didn't make it through the pipeline.</h1>
    <p class="mt-6 max-w-xl text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn btn-primary mt-8"><Icon name="arrow-left" /> Back home</a>
  </section>
</Base>
