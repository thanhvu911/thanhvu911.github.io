---
import { Image } from 'astro:assets';
import { projectImage } from '../lib/images';
import { formatDate, type NoteFrontmatter } from '../lib/notes';

interface Props {
  note: NoteFrontmatter & { url: string };
}
const { note } = Astro.props;
---

<a href={note.url} class="group block" data-reveal>
  <div class="aspect-[16/10] overflow-hidden rounded-xl border border-line bg-surface transition-colors group-hover:border-line-strong">
    <Image
      src={projectImage(note.project, note.cover)}
      alt=""
      widths={[480, 720]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      class="size-full object-cover object-left-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />
  </div>
  <h3 class="mt-4 text-lg font-medium tracking-tight text-ink transition-colors group-hover:text-accent">{note.title}</h3>
  <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-faint">
    {formatDate(note.date)} · {note.readingTime}
  </p>
  <p class="mt-2 line-clamp-3 text-sm text-muted">{note.description}</p>
</a>
