---
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { toolkit, credentials, education } from '../data/portfolio';
---

<section id="toolkit" class="border-t border-line" aria-labelledby="toolkit-title">
  <div class="container-page py-20 md:py-28">
    <SectionHeader id="toolkit-title" eyebrow="Toolkit" title="What I work with" />

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        toolkit.map((g) => (
          <div class="card p-6" data-reveal>
            <h3 class="label">{g.group}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {g.items.map((item) => (
                <li class="rounded-md border border-line bg-bg/50 px-3 py-1.5 text-sm text-ink">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div id="credentials" class="mt-4 grid gap-4 md:grid-cols-2">
      <div class="card p-6" data-reveal>
        <h3 class="label flex items-center gap-2"><Icon name="award" size={14} /> Certifications</h3>
        <ul class="mt-4 divide-y divide-line">
          {
            credentials.map((c) => (
              <li class="py-3 first:pt-0 last:pb-0">
                <p class="font-medium text-ink">{c.title}</p>
                <p class="mt-1 font-mono text-xs text-muted">{c.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card p-6" data-reveal>
        <h3 class="label flex items-center gap-2"><Icon name="graduation-cap" size={14} /> Education</h3>
        <p class="mt-4 font-medium text-ink">{education.degree}</p>
        <p class="mt-1 text-sm text-muted">
          {education.school} · {education.location} · {education.date}
        </p>
        <p class="mt-3 font-mono text-xs text-ink">{education.gpa}</p>
        <p class="mt-1 text-xs text-muted">{education.honors}</p>
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {education.coursework.map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
