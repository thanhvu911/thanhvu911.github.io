---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Assistant from '../components/Assistant.astro';
import Intro from '../components/Intro.astro';
import { profile } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = `${profile.name}, ${profile.role}. ${profile.tagline}`,
  image = '/og.png',
} = Astro.props;

const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.role} Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  sameAs: [profile.github, profile.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Lancaster', addressRegion: 'PA', addressCountry: 'US' },
  alumniOf: 'Franklin & Marshall College',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#efe6d6" data-theme-color />
    <script is:inline>
      // Apply the theme before first paint: the visitor's saved choice,
      // otherwise light.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = new URLSearchParams(location.search).get('theme');
        if (!t) {
          try { t = localStorage.getItem('theme'); } catch (e) {}
        }
        if (t === 'dark') {
          root.dataset.theme = 'dark';
          document.querySelector('[data-theme-color]').setAttribute('content', '#0e1424');
        }
        // Cross-page view transitions (global.css) reject their promises when
        // the browser skips one; nothing depends on them, so keep that quiet.
        function quiet(e) {
          var vt = e.viewTransition;
          if (vt) [vt.ready, vt.finished, vt.updateCallbackDone].forEach(function (p) { if (p) p.catch(function () {}); });
        }
        addEventListener('pageswap', quiet);
        addEventListener('pagereveal', quiet);
        // Intro: home page only, once per browser session, never for
        // reduced-motion visitors. Add ?intro to replay it.
        try {
          var home = location.pathname.replace(/\/+$/, '') === '';
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var again = new URLSearchParams(location.search).has('intro');
          if (home && !calm && (again || !sessionStorage.getItem('intro'))) {
            root.classList.add('intro-on');
            sessionStorage.setItem('intro', '1');
          }
        } catch (e) {}
        // Arriving through the page wipe: start covered, then the wipe
        // script at the end of the body slides the cover away.
        try {
          if (sessionStorage.getItem('wipe')) {
            root.classList.add('wipe-hold');
            setTimeout(function () { root.classList.remove('wipe-hold'); }, 2500);
          }
        } catch (e) {}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {
      profile.goatcounter && (
        <script is:inline async data-goatcounter={`https://${profile.goatcounter}.goatcounter.com/count`} src="//gc.zgo.at/count.js" />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-strong focus:px-4 focus:py-2 focus:text-bg"
      >Skip to content</a
    >
    <Nav />
    <main id="main" class="flex-1 pt-[4.5rem]">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <Assistant />
    {Astro.url.pathname === '/' && <Intro />}
    <div class="pwipe" aria-hidden="true">
      <span class="band"><span class="band-run"><i></i><i></i><i></i><i></i><i></i></span></span>
      <div class="pwipe-txt">
        <p class="mono" data-wipe-path></p>
        <p class="pwipe-ttl" data-wipe-title></p>
      </div>
    </div>
    <script is:inline>
      // Page wipe. Leaving: the band sweeps in from the left, then the browser
      // navigates. Arriving: the band (already in place) pulls back to the left.
      (function () {
        var root = document.documentElement;
        var path = document.querySelector('[data-wipe-path]');
        var title = document.querySelector('[data-wipe-title]');
        var names = { '': 'Home', projects: 'Projects', resume: 'Resume', academics: 'Academics' };
        function label(p) {
          var parts = p.replace(/\/+$/, '').split('/').filter(Boolean);
          var last = parts[parts.length - 1] || '';
          path.textContent = '// ' + (p.replace(/\/+$/, '') || '/');
          title.textContent = names[last] || last.replace(/-/g, ' ');
        }
        function reveal() {
          root.classList.remove('wipe-cover');
          root.classList.add('wipe-out');
          setTimeout(function () { root.classList.remove('wipe-out'); }, 560);
        }

        var arrived = null;
        try {
          arrived = sessionStorage.getItem('wipe');
          sessionStorage.removeItem('wipe');
        } catch (e) {}
        if (arrived) {
          label(arrived);
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              root.classList.remove('wipe-hold');
              reveal();
            });
          });
        }
        // Back/forward restores the page as it was left: take the cover off.
        addEventListener('pageshow', function (e) {
          if (e.persisted && root.classList.contains('wipe-cover')) reveal();
        });

        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
          var url = new URL(a.href, location.href);
          if (url.origin !== location.origin || /\.[a-z0-9]+$/i.test(url.pathname)) return;
          if (url.pathname === location.pathname && url.search === location.search) return;
          e.preventDefault();
          label(url.pathname);
          root.classList.add('wipe-cover');
          setTimeout(function () {
            try { sessionStorage.setItem('wipe', url.pathname); } catch (err) {}
            location.href = url.href;
          }, 280);
        });
      })();
    </script>
    <script>
      // Fill in phone links ([data-phone]) from reversed digits, so the number
      // never appears in the HTML that scrapers read.
      document.querySelectorAll<HTMLElement>('[data-phone]').forEach((el) => {
        const d = [...(el.dataset.phone ?? '')].reverse().join('');
        const pretty = `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
        if (el instanceof HTMLAnchorElement) el.href = `tel:+1${d}`;
        el.querySelectorAll('[data-phone-text]').forEach((t) => (t.textContent = pretty));
        el.hidden = false;
      });

      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scramble a heading's letters, then settle them left to right.
      const glyphs = 'ABCDEFGHKNOPRSTUVXYZ0123456789/#';
      const scramble = (el: HTMLElement) => {
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        const nodes: { node: Text; text: string }[] = [];
        while (walker.nextNode()) nodes.push({ node: walker.currentNode as Text, text: walker.currentNode.nodeValue ?? '' });
        const total = nodes.reduce((n, t) => n + t.text.length, 0);
        if (!total) return;
        el.setAttribute('aria-label', el.textContent?.trim() ?? '');
        el.style.height = `${el.offsetHeight}px`;
        const start = performance.now();
        const dur = 650 + total * 18;
        let last = 0;
        const tick = (now: number) => {
          const t = (now - start) / dur;
          if (now - last > 45 || t >= 1) {
            last = now;
            let i = 0;
            for (const n of nodes) {
              n.node.nodeValue = [...n.text]
                .map((ch) => (ch.trim() === '' || i++ / total < t ? ch : glyphs[(Math.random() * glyphs.length) | 0]))
                .join('');
            }
          }
          if (t < 1) return requestAnimationFrame(tick);
          nodes.forEach((n) => (n.node.nodeValue = n.text));
          el.style.height = '';
          el.removeAttribute('aria-label');
        };
        requestAnimationFrame(tick);
      };

      // Sweep the accent band (styled in global.css) across a title's first line:
      // it runs in past the start of the text, the letters scramble in over it,
      // and it pulls back, leaving hatch marks beside section titles.
      const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
      const sweep = (el: HTMLElement) => {
        const host = el.closest<HTMLElement>('.shead, section') ?? el.parentElement!;
        const range = document.createRange();
        range.selectNodeContents(el);
        const text = range.getBoundingClientRect();
        const line = range.getClientRects()[0] ?? text;
        const box = host.getBoundingClientRect();
        if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
        const band = document.createElement('span');
        band.className = 'band';
        band.setAttribute('aria-hidden', 'true');
        band.innerHTML = '<span class="band-run"><i></i><i></i><i></i><i></i><i></i></span>';
        const h = line.height;
        band.style.top = `${line.top - box.top - host.clientTop}px`;
        band.style.height = `${h}px`;
        host.append(band);
        const run = band.firstElementChild as HTMLElement;
        const runW = run.offsetWidth;
        const left = text.left - box.left - host.clientLeft;
        const at = (x: number) => ({ transform: `translateX(${x - runW}px)` });
        const out = -0.4 * h;
        const peak = Math.min(left + Math.min(text.width, box.width) * 0.55 + 2.2 * h, band.clientWidth + 2.6 * h);
        run
          .animate(
            [
              { ...at(out), easing: ease },
              { ...at(peak), offset: 0.36, easing: 'linear' },
              { ...at(peak + 0.12 * h), offset: 0.52, easing: ease },
              at(out),
            ],
            { duration: 1700, fill: 'both' },
          )
          .finished.then(() => band.remove());
        const scrambles = el.matches('.section-title, [data-scramble]');
        setTimeout(() => {
          el.classList.add('is-visible');
          if (scrambles) scramble(el);
        }, scrambles ? 280 : 0);
        setTimeout(() => el.classList.add('is-hatched'), 1150);
      };

      // Reveal [data-reveal] blocks and section titles once as they scroll into
      // view. Titles inside the home page's scroll stage (.staged) are run by
      // index.astro instead.
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            io.unobserve(el);
            if (el.closest('.staged')) return;
            if (!calm && el.matches('.section-title, [data-scramble], [data-band]')) return sweep(el);
            el.classList.add('is-visible', 'is-hatched');
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal], .section-title, [data-scramble], [data-band]').forEach((el) => io.observe(el));

      // Count key numbers ([data-count]) up from zero when they come into view,
      // keeping their prefix, suffix, and decimals ("131M+", "0.77").
      if (!calm) {
        const counter = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              counter.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const m = (el.dataset.count ?? '').match(/^([$€£]?)(\d[\d,]*(?:\.\d+)?)(.*)$/);
              if (!m) return;
              const [, pre, num, post] = m;
              const target = Number(num.replace(/,/g, ''));
              const decimals = (num.split('.')[1] ?? '').length;
              const commas = num.includes(',');
              const start = performance.now();
              const tick = (now: number) => {
                const t = Math.min((now - start) / 1200, 1);
                const v = target * (1 - Math.pow(1 - t, 3));
                const s = commas ? v.toLocaleString('en-US', { maximumFractionDigits: decimals, minimumFractionDigits: decimals }) : v.toFixed(decimals);
                el.textContent = t < 1 ? `${pre}${s}${post}` : el.dataset.count!;
                if (t < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            }),
          { threshold: 0.6 },
        );
        document.querySelectorAll('[data-count]').forEach((el) => counter.observe(el));
      }
    </script>

  </body>
</html>
