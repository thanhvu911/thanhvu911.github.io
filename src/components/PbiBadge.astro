---
// Ink Power BI tag for project cards that have an interactive dashboard;
// only the bar icon keeps Power BI's yellow, so it doesn't fight the orange accent.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['pbi-badge', className]}>
  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="0" y="6" width="3" height="6" rx="1" /><rect x="4.5" y="3" width="3" height="9" rx="1" /><rect x="9" y="0" width="3" height="12" rx="1" /></svg>
  Interactive Power BI
</span>

<style>
  .pbi-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.625rem;
    background: #111111;
    color: #f8f7f4;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .pbi-badge svg {
    fill: #f2c811;
  }
</style>
