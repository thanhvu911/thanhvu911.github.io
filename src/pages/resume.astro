---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/portfolio';
---

<Base title="Resume" description="Download Thanh Vu's resume: Data Analyst, Data Engineer, or Graduate School (M.S. Computer Science, AI) version.">
  <section class="section">
    <div class="container-page max-w-3xl">
      <h1 class="section-title">Resume</h1>
      <p class="section-lede">Three one-page versions. Pick the one that fits the role or program.</p>

      <ul class="mt-10 border-t border-line">
        {
          profile.resumes.map((r) => (
            <li class="flex flex-col gap-4 border-b border-line py-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="text-lg font-semibold">{r.label} resume</h2>
                <p class="text-[0.9375rem] text-muted">{r.note}</p>
              </div>
              <div class="flex shrink-0 gap-2">
                <a href={r.href} target="_blank" class="btn btn-outline" data-goatcounter-click={`resume-${r.id}-open`}>Open</a>
                <a href={r.href} download class="btn btn-primary" data-goatcounter-click={`resume-${r.id}`}>
                  <Icon name="download" size={16} />
                  Download PDF
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
