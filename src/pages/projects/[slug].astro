---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import ProjectDetails from '../../components/ProjectDetails.astro';
import { details } from '../../data/details';
import { projects, type Project } from '../../data/portfolio';
import { projectImage } from '../../lib/images';
import VacancyDemo from '../../components/demos/VacancyDemo.astro';
import LancasterDemo from '../../components/demos/LancasterDemo.astro';
import SalesDemo from '../../components/demos/SalesDemo.astro';
import RfmDemo from '../../components/demos/RfmDemo.astro';

// Client-side dashboards rebuilt from each project's data.
const demos: Record<string, typeof VacancyDemo> = {
  'can-mail-data-predict-housing-vacancy': VacancyDemo,
  'lancaster-economic-indicators-dashboard': LancasterDemo,
  'sales-planning-analysis': SalesDemo,
  'rfm-customer-segmentation': RfmDemo,
};

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const highlightIcons = ['trending-up', 'bar-chart', 'layers', 'target'] as const;
const cover = projectImage(project.slug, project.cover);
const detail = details[project.slug];
const Demo = demos[project.slug];
const hasDashboard = Boolean(Demo || project.powerbiEmbed);
const tabs = [
  { id: 'overview', label: 'Overview' },
  hasDashboard && { id: 'dashboard', label: 'Interactive dashboard' },
  detail && { id: 'walkthrough', label: 'Walkthrough' },
  { id: 'gallery', label: 'Gallery' },
].filter(Boolean) as { id: string; label: string }[];
---

<Base title={project.title} description={project.summary}>
  <!-- Header band in the hero colors -->
  <header class="project-hero relative isolate overflow-hidden pb-28 pt-28 text-white">
    <div class="project-grid" aria-hidden="true"></div>
    <div class="container-page max-w-6xl">
      <a href="/projects" class="inline-flex items-center gap-2 text-sm font-medium text-white/80 hover:text-white">
        <Icon name="arrow-left" size={16} />
        Back to Projects
      </a>
      <p class="mt-8 text-sm font-medium text-teal">{project.kind} · {project.year}</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">{project.title}</h1>
      <p class="mt-5 max-w-3xl text-lg text-white/85">{project.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={project.repo} target="_blank" rel="noopener" class="btn btn-teal" data-magnetic>
          <Icon name="github" size={16} />
          View Code on GitHub
        </a>
        {hasDashboard ? (
          <a href="#dashboard" class="btn btn-glass" data-tab-link="dashboard">Try the interactive dashboard</a>
        ) : (
          <a href="#walkthrough" class="btn btn-glass" data-tab-link="walkthrough">See the walkthrough</a>
        )}
      </div>
    </div>
  </header>

  <div class="container-page relative z-10 -mt-20 max-w-6xl">
    <div class="card overflow-hidden shadow-2xl shadow-navy/15" data-reveal>
      <Image
        src={cover}
        alt={project.images.find((i) => i.file === project.cover)?.caption ?? project.title}
        widths={[800, 1280, 1800]}
        sizes="(min-width: 1152px) 1104px, 100vw"
        loading="eager"
        class="h-auto w-full"
      />
    </div>

    <ul class:list={['card mt-6 grid divide-line', project.metrics.length === 3 ? 'grid-cols-3 divide-x' : 'grid-cols-2 sm:grid-cols-4 sm:divide-x']} data-stagger>
      {
        project.metrics.map((m, i) => (
          <li class="p-5 text-center">
            <Icon name={highlightIcons[i % highlightIcons.length]} size={20} class="mx-auto text-teal-ink" />
            <p class="mt-2 text-2xl font-bold text-navy">{m.value}</p>
            <p class="text-xs text-muted">{m.label}</p>
          </li>
        ))
      }
    </ul>

    <div class="tabbar mt-8 hidden" data-tabbar>
      <div class="flex gap-1 overflow-x-auto rounded-xl border border-line bg-white/90 p-1 shadow-sm backdrop-blur" role="tablist" aria-label="Project sections">
        {
          tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab-btn" data-tab={t.id}>
              {t.id === 'dashboard' && <span class="size-2 rounded-full bg-teal" aria-hidden="true" />}
              {t.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="container-page grid max-w-6xl gap-10 pb-16 pt-8 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0 space-y-6">
    <div class="space-y-6" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" data-panel="overview">
      {project.context && <p class="rounded-xl border border-teal/30 bg-teal-wash px-5 py-4 text-ink" data-reveal>{project.context}</p>}

      {detail && <ProjectDetails slug={project.slug} detail={detail} part="intro" />}

      <section class="card p-6 md:p-8" aria-labelledby="why" data-reveal>
        <h2 id="why" class="text-2xl font-bold text-navy">The business problem</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink/90">{project.problem}</p>
        <h3 class="mt-6 font-semibold text-ink">Why it matters</h3>
        <p class="mt-2 leading-relaxed text-ink/80">{project.why}</p>
      </section>

      <section class="card p-6 md:p-8" aria-labelledby="built" data-reveal>
        <h2 id="built" class="text-2xl font-bold text-navy">My role and what I built</h2>
        <p class="mt-3 text-muted">{project.role}</p>
        <ol class="mt-6 space-y-5">
          {
            project.approach.map((step, i) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-navy text-sm font-semibold text-white">{i + 1}</span>
                <p class="pt-1 leading-relaxed text-ink/85">{step}</p>
              </li>
            ))
          }
        </ol>
        <div class="mt-8 overflow-x-auto">
          <ol class="flex min-w-max items-center gap-2 text-sm" aria-label="Pipeline">
            {
              project.architecture.map((node, i) => (
                <li class="flex items-center gap-2">
                  <span class:list={['rounded-lg border px-3 py-2 font-medium', i === project.architecture.length - 1 ? 'border-teal bg-teal-wash text-teal-ink' : 'border-line bg-soft text-ink']}>{node}</span>
                  {i < project.architecture.length - 1 && <Icon name="arrow-right" size={16} class="text-muted" />}
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="card p-6 md:p-8" aria-labelledby="challenges" data-reveal>
        <h2 id="challenges" class="text-2xl font-bold text-navy">Challenges I solved</h2>
        <ul class="mt-5 space-y-4">
          {
            project.challenges.map((c) => (
              <li class="flex gap-3 leading-relaxed text-ink/85">
                <span class="icon-tile size-8 rounded-lg">
                  <Icon name="wrench" size={15} />
                </span>
                <span class="pt-1">{c}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card p-6 md:p-8" aria-labelledby="impact" data-reveal>
        <h2 id="impact" class="text-2xl font-bold text-navy">Impact and results</h2>
        <ul class="mt-5 space-y-3">
          {
            project.results.map((r) => (
              <li class="flex gap-3 leading-relaxed text-ink/85">
                <Icon name="check" size={18} class="mt-1 shrink-0 text-teal-ink" />
                {r}
              </li>
            ))
          }
        </ul>
      </section>

    </div>

    {
      hasDashboard && (
        <div class="space-y-6" role="tabpanel" id="panel-dashboard" aria-labelledby="tab-dashboard" data-panel="dashboard">
          {project.powerbiEmbed && (
            <section class="card overflow-hidden" aria-labelledby="pbi-title">
              <h2 id="pbi-title" class="px-6 pt-6 text-2xl font-bold text-navy md:px-8">Live Power BI report</h2>
              <div class="mt-4 aspect-[16/10] w-full bg-soft">
                <iframe title={`${project.title} Power BI report`} src={project.powerbiEmbed} class="size-full" loading="lazy" allowfullscreen />
              </div>
            </section>
          )}
          {Demo && (
            <section class="card p-6 md:p-8" aria-labelledby="dash-title">
              <h2 id="dash-title" class="text-2xl font-bold text-navy">Explore the data</h2>
              <p class="mt-2 text-sm text-muted">An interactive version of the report, rebuilt from the project's data so it works in any browser without a Power BI login. Use the filters; every number recalculates.</p>
              <div class="mt-6">
                <Demo />
              </div>
            </section>
          )}
        </div>
      )
    }

    {
      detail && (
        <div class="space-y-6" role="tabpanel" id="panel-walkthrough" aria-labelledby="tab-walkthrough" data-panel="walkthrough">
          <ProjectDetails slug={project.slug} detail={detail} part="walkthrough" />
        </div>
      )
    }

    <div class="space-y-6" role="tabpanel" id="panel-gallery" aria-labelledby="tab-gallery" data-panel="gallery">
      <section id="gallery" class="card scroll-mt-24 p-6 md:p-8" aria-labelledby="gallery-title" data-reveal>
        <h2 id="gallery-title" class="text-2xl font-bold text-navy">All images</h2>
        <p class="mt-2 text-sm text-muted">Click any image to view it full size.</p>
        <div class="mt-6">
          <Gallery project={project} />
        </div>
      </section>
    </div>
    </div>

    <!-- Quick facts for a recruiter skimming the page -->
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6" data-reveal>
        <h2 class="font-bold text-navy">At a glance</h2>
        <dl class="mt-4 space-y-4 text-sm">
          <div>
            <dt class="text-muted">Year</dt>
            <dd class="font-medium text-ink">{project.year}</dd>
          </div>
          <div>
            <dt class="text-muted">Type</dt>
            <dd class="font-medium text-ink">{project.kind}</dd>
          </div>
          <div>
            <dt class="text-muted">Tools</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">{project.tags.map((t) => <span class="pill">{t}</span>)}</dd>
          </div>
          <div>
            <dt class="text-muted">Skills demonstrated</dt>
            <dd>
              <ul class="dot-list mt-2 space-y-1.5 text-ink">{project.skills.map((s) => <li>{s}</li>)}</ul>
            </dd>
          </div>
        </dl>
        <a href={project.repo} target="_blank" rel="noopener" class="btn btn-teal mt-6 w-full">
          <Icon name="github" size={16} />
          Repository
        </a>
        <a href="/#contact" class="btn btn-outline mt-3 w-full">Contact me about this</a>
      </div>
    </aside>
  </div>

  <a href={`/projects/${next.slug}`} class="group block border-t border-line bg-soft/60">
    <div class="container-page flex max-w-6xl items-center justify-between gap-6 py-12">
      <div class="min-w-0">
        <p class="text-sm text-muted">Next project</p>
        <p class="mt-1 text-2xl font-bold text-navy transition-colors group-hover:text-teal-ink md:text-3xl">{next.title}</p>
      </div>
      <span class="grid size-14 shrink-0 place-items-center rounded-full bg-navy text-white transition-transform group-hover:translate-x-1">
        <Icon name="arrow-right" size={22} />
      </span>
    </div>
  </a>
</Base>

<style>
  .tab-btn {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 0.625rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .tab-btn:hover {
    color: var(--color-navy);
    background: var(--color-soft);
  }
  .tab-btn[aria-selected='true'] {
    color: #fff;
    background: var(--color-navy);
  }
  .project-hero {
    background: linear-gradient(135deg, #0f2757 0%, #175e82 100%);
  }
  .project-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 30% 40%, #000 20%, transparent 75%);
  }
</style>

<script>
  // Tabs: one panel at a time, deep-linkable with #overview, #dashboard, #walkthrough, #gallery.
  // Without JavaScript the tab bar stays hidden and every panel shows in order.
  const bar = document.querySelector<HTMLElement>('[data-tabbar]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  if (bar && tabs.length) {
    bar.classList.remove('hidden');
    const ids = tabs.map((t) => t.dataset.tab!);

    const activate = (id: string, focus = false) => {
      if (!ids.includes(id)) id = ids[0];
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      // Charts inside a hidden panel need a resize once shown.
      window.dispatchEvent(new Event('resize'));
    };

    const fromHash = () => location.hash.replace('#', '');
    const show = (id: string, scroll: boolean) => {
      activate(id);
      history.replaceState(null, '', `#${id}`);
      if (scroll) bar.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!, false));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        activate(next.dataset.tab!, true);
        history.replaceState(null, '', `#${next.dataset.tab}`);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(a.dataset.tabLink!, true);
      }),
    );

    activate(ids.includes(fromHash()) ? fromHash() : ids[0]);
    if (ids.includes(fromHash()) && fromHash() !== ids[0]) bar.scrollIntoView({ block: 'start' });
  }
</script>
