---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import ProjectDetails from '../../components/ProjectDetails.astro';
import ProjectCase from '../../components/ProjectCase.astro';
import Explainer from '../../components/Explainer.astro';
import { details } from '../../data/details';
import { projects, type Project } from '../../data/portfolio';
import { projectImage } from '../../lib/images';
import VacancyDemo from '../../components/demos/VacancyDemo.astro';
import LancasterDemo from '../../components/demos/LancasterDemo.astro';
import SalesDemo from '../../components/demos/SalesDemo.astro';
import RfmDemo from '../../components/demos/RfmDemo.astro';
import PowerBIWindow from '../../components/PowerBIWindow.astro';
import PbiVideo from '../../components/PbiVideo.astro';

// Client-side dashboards rebuilt from each project's data.
const demos: Record<string, typeof VacancyDemo> = {
  'can-mail-data-predict-housing-vacancy': VacancyDemo,
  'lancaster-economic-indicators-dashboard': LancasterDemo,
  'sales-planning-analysis': SalesDemo,
  'rfm-customer-segmentation': RfmDemo,
};

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const cover = projectImage(project.slug, project.cover);
const detail = details[project.slug];
const Demo = demos[project.slug];
// Size the title so its longest word always fits on one line.
const longestWord = Math.max(...project.title.split(/\s+/).map((w) => w.length));
// Long titles get a smaller ceiling so they stay within three lines.
const titleMax = project.title.length > 34 ? 3.5 : project.title.length > 24 ? 4.25 : 5;
const hasDashboard = Boolean(Demo || project.powerbiEmbed || project.powerbiVideo);
const tabs = [
  { id: 'overview', label: 'Case study' },
  hasDashboard && { id: 'dashboard', label: 'Interactive dashboard' },
  detail && { id: 'walkthrough', label: 'Walkthrough' },
  { id: 'gallery', label: 'Gallery' },
].filter(Boolean) as { id: string; label: string }[];
---

<Base title={project.title} description={project.summary}>
  <div class="frame">
    <header class="ph border-b border-line">
      <div class="ph-meta">
        <a href="/projects" class="mono inline-flex min-h-11 items-center gap-2 hover:text-strong">
          <Icon name="arrow-left" size={14} />
          All projects
        </a>
        <span class="sq hidden lg:block"></span>
        <p class="mono hidden lg:block">Project {project.number} // {project.kind.split(' · ')[0]}<br />{project.year}</p>
        <div class="hidden lg:block">
          <p class="mono">Stack</p>
          <p class="mt-1 font-semibold text-strong">{project.tags.slice(0, 4).join(', ')}</p>
        </div>
        <div class="hidden lg:block">
          <p class="mono">Result</p>
          <p class="mt-1 font-semibold text-strong">{project.metrics[0].value} {project.metrics[0].label.toLowerCase()}</p>
        </div>
      </div>
      <div class="ph-main">
        <p class="mono lg:hidden">Project {project.number} // {project.kind.split(' · ')[0]} · {project.year}</p>
        <h1 class="display ph-title mt-3 lg:mt-0" data-band style={`--lw:${longestWord};--max:${titleMax}rem`}>{project.title}</h1>
        <p class="mt-6 max-w-3xl text-xl leading-snug text-strong md:text-2xl">{project.headline}</p>
        <p class="mt-4 hidden max-w-3xl text-lg leading-relaxed text-muted md:block">{project.summary}</p>
        <div class="mt-8 flex flex-wrap gap-2">
          {hasDashboard ? (
            <a href="#dashboard" class="btn btn-primary" data-tab-link="dashboard">Open the dashboard</a>
          ) : detail ? (
            <a href="#walkthrough" class="btn btn-primary" data-tab-link="walkthrough">See the walkthrough</a>
          ) : (
            <a href="#gallery" class="btn btn-primary" data-tab-link="gallery">See the results</a>
          )}
          {project.repo && (
            <a href={project.repo} target="_blank" rel="noopener" class="btn btn-outline" data-goatcounter-click={`repo-${project.slug}`}>
              <Icon name="github" size={16} />
              Code on GitHub
            </a>
          )}
        </div>
      </div>
    </header>

    {
      project.animation ? (
        <div class="hero-anim border-b border-line">
          <Explainer slug={project.slug} alt={project.animation} eager />
        </div>
      ) : (
        <div class="border-b border-line bg-white">
          <Image
            src={cover}
            alt={project.images.find((i) => i.file === project.cover)?.caption ?? project.title}
            widths={[800, 1280, 1800]}
            sizes="(min-width: 1440px) 1440px, 100vw"
            loading="eager"
            class="mx-auto h-auto max-h-[44rem] w-full object-contain"
          />
        </div>
      )
    }

    <dl class:list={['cells border-b border-line', project.metrics.length === 3 ? 'grid-cols-3' : 'grid-cols-2 sm:grid-cols-4']}>
      {
        project.metrics.map((m) => (
          <div class="flex flex-col px-4 py-5 md:px-8 md:py-7">
            <dt class="order-2 mt-1 text-sm text-muted">{m.label}</dt>
            <dd class="display order-1 text-[1.5rem] text-strong md:text-[2.25rem]" data-count={m.value}>{m.value}</dd>
          </div>
        ))
      }
    </dl>


    <div class="tabbar sticky top-[4.5rem] z-30 hidden border-b border-line bg-[var(--nav-bg)] backdrop-blur" data-tabbar>
      <div class="flex overflow-x-auto" role="tablist" aria-label="Project sections">
        {
          tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab-btn" data-tab={t.id}>
              {t.id === 'dashboard' && <span class="size-2 bg-[#f2c811]" aria-hidden="true" />}
              {t.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="project-layout frame" data-project-layout>
    <div role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" data-panel="overview">
      <ProjectCase project={project} detail={detail} />
    </div>

    {
      hasDashboard && (
        <div class="panel space-y-6" role="tabpanel" id="panel-dashboard" aria-labelledby="tab-dashboard" data-panel="dashboard">
          {project.powerbiEmbed && (
            <section class="card overflow-hidden" aria-labelledby="pbi-title">
              <h2 id="pbi-title" class="display-md px-6 pt-6 text-2xl md:px-8">Live Power BI report</h2>
              <div class="mt-4 aspect-[16/10] w-full bg-soft">
                <iframe title={`${project.title} Power BI report`} src={project.powerbiEmbed} class="size-full" loading="lazy" allowfullscreen />
              </div>
            </section>
          )}
          {Demo && (
            <section aria-labelledby="dash-title">
              <h2 id="dash-title" class="display-md text-2xl">Explore the report</h2>
              <p class="mt-2 max-w-3xl text-muted">Rebuilt from the project's data so it opens in any browser, no login. Use the filters and every visual recalculates.</p>
              <div class="mt-5">
                <PowerBIWindow project={project}>
                  <Demo />
                </PowerBIWindow>
              </div>
            </section>
          )}
          {project.powerbiVideo && (
            <section aria-labelledby="rec-title" class:list={{ 'pt-6': Demo }}>
              <h2 id="rec-title" class="display-md text-2xl">See it in Power BI</h2>
              <p class="mt-2 max-w-3xl text-muted">The real report in Power BI Desktop. The subtitles explain each click.</p>
              <div class="mt-5">
                <PbiVideo name={project.powerbiVideo} />
              </div>
            </section>
          )}
        </div>
      )
    }

    {
      detail && (
        <div class="panel space-y-6" role="tabpanel" id="panel-walkthrough" aria-labelledby="tab-walkthrough" data-panel="walkthrough">
          <ProjectDetails slug={project.slug} detail={detail} part="walkthrough" />
        </div>
      )
    }

    <div class="panel" role="tabpanel" id="panel-gallery" aria-labelledby="tab-gallery" data-panel="gallery">
      <section id="gallery" class="scroll-mt-32" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="display-md text-2xl">All images</h2>
        <p class="mt-2 text-sm text-muted">Click any image to view it full size.</p>
        <div class="mt-6">
          <Gallery project={project} />
        </div>
      </section>
    </div>
  </div>

  <div class="frame border-t border-line">
    <a href={`/projects/${next.slug}`} class="go min-h-24">
      <span class="arr"><Icon name="arrow-right" size={26} /></span>
      <span class="lbl flex-col !items-start justify-center gap-1">
        <span class="mono">Next project</span>
        <span class="display-md text-lg md:text-2xl">{next.title}</span>
      </span>
    </a>
  </div>
</Base>

<style>
  .panel {
    padding: 2rem 1rem 4rem;
  }
  /* Matches the animations' own paper colour, in both themes. */
  .hero-anim {
    background: #f3f1ec;
  }
  .hero-anim :global(picture) {
    max-width: 75rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .panel {
      padding: 2.5rem 2.5rem 5rem;
    }
  }
  .ph {
    display: grid;
  }
  .ph-meta {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: 1rem 1rem 0;
  }
  .ph-main {
    min-width: 0;
    padding: 1.5rem 1rem 2.5rem;
    container-type: inline-size;
  }
  .ph-title {
    font-size: clamp(1.5rem, min(6.4vw, calc(100cqi / (var(--lw) * 0.92)), var(--max)), 5rem);
    line-height: 0.95;
  }
  @media (min-width: 768px) {
    .ph-meta {
      padding-inline: 2.5rem;
    }
    .ph-main {
      padding: 2rem 2.5rem 3rem;
    }
  }
  @media (min-width: 1024px) {
    .ph {
      grid-template-columns: 30% 1fr;
    }
    .ph-meta {
      padding-block: 2.25rem;
      border-right: 1px solid var(--color-line);
    }
    .ph-main {
      padding-block: 3rem 3.5rem;
    }
  }
  .tab-btn {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.5rem;
    padding: 0 1.5rem;
    border-right: 1px solid var(--color-line);
    color: var(--color-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .tab-btn:hover {
    background: var(--hover-bg);
  }
  .tab-btn[aria-selected='true'] {
    background: var(--color-strong);
    color: var(--color-bg);
  }
</style>

<script>
  // Tabs: one panel at a time, deep-linkable with #overview, #dashboard, #walkthrough, #gallery.
  // Without JavaScript the tab bar stays hidden and every panel shows in order.
  const bar = document.querySelector<HTMLElement>('[data-tabbar]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  if (bar && tabs.length) {
    bar.classList.remove('hidden');
    const ids = tabs.map((t) => t.dataset.tab!);

    const activate = (id: string, focus = false) => {
      if (!ids.includes(id)) id = ids[0];
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      // The dashboard gets the full width; the At a glance sidebar returns on other tabs.
      document.querySelector<HTMLElement>('[data-project-layout]')?.setAttribute('data-active-tab', id);
      // Charts inside a hidden panel need a resize once shown.
      window.dispatchEvent(new Event('resize'));
    };

    const fromHash = () => location.hash.replace('#', '');
    const show = (id: string, scroll: boolean) => {
      activate(id);
      history.replaceState(null, '', `#${id}`);
      if (scroll) bar.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!, false));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        activate(next.dataset.tab!, true);
        history.replaceState(null, '', `#${next.dataset.tab}`);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(a.dataset.tabLink!, true);
      }),
    );

    activate(ids.includes(fromHash()) ? fromHash() : ids[0]);
    if (ids.includes(fromHash()) && fromHash() !== ids[0]) bar.scrollIntoView({ block: 'start' });
  }
</script>
