---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import avatar from '../assets/photo/thanh-hero.jpg';
import { bio, credentials, education, experience, profile, projects, skills } from '../data/portfolio';

const contacts = [
  { icon: 'mail', label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'phone', label: 'Phone', value: profile.phone, href: profile.phoneHref },
  { icon: 'linkedin', label: 'LinkedIn', value: 'linkedin.com/in/thanh25', href: profile.linkedin },
  { icon: 'github', label: 'GitHub', value: 'github.com/thanhvu911', href: profile.github },
] as const;
---

<Base>
  <!-- Hero -->
  <section id="home" class="hero relative flex min-h-dvh items-center overflow-hidden">
    <div class="container-page grid items-center gap-12 pb-24 pt-28 lg:grid-cols-2">
      <div class="order-2 text-center lg:order-1 lg:text-left">
        <h1 class="text-5xl font-bold tracking-tight text-white md:text-7xl">{profile.name}</h1>
        <p class="mt-4 text-2xl font-light text-white/90 md:text-3xl">{profile.role}</p>
        <p class="mt-6 text-lg text-white/80">{profile.tagline}</p>
        <p class="mt-3 text-white/80">
          <span class="block">Data Analyst Fellow at EDC Lancaster County</span>
          <span class="block">Microsoft Certified: Fabric Data Engineer Associate (DP-700)</span>
        </p>

        <div class="mt-8 flex justify-center gap-2 lg:justify-start">
          <a href={profile.linkedin} target="_blank" rel="noopener" class="hero-icon" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
          <a href={profile.github} target="_blank" rel="noopener" class="hero-icon" aria-label="GitHub"><Icon name="github" size={20} /></a>
          <a href={`mailto:${profile.email}`} class="hero-icon" aria-label="Email"><Icon name="mail" size={20} /></a>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
          <a href="#projects" class="btn btn-teal">View Projects</a>
          <a href="#contact" class="btn btn-glass">Contact Me</a>
          <a href="/resume" class="btn btn-glass">
            <Icon name="download" size={16} />
            Resume
          </a>
        </div>
      </div>

      <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
        <div class="relative">
          <div class="absolute -inset-6 rounded-full bg-teal/20 blur-3xl" aria-hidden="true"></div>
          <Image
            src={avatar}
            alt="Thanh Vu"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 384px, 256px"
            loading="eager"
            fetchpriority="high"
            class="relative size-64 rounded-full border-8 border-white/90 object-cover shadow-2xl md:size-80 lg:size-96"
          />
        </div>
      </div>
    </div>

    <a href="#about" class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-white/80 hover:text-white" aria-label="Scroll to About">
      <Icon name="arrow-down" size={26} />
    </a>
  </section>

  <!-- About -->
  <section id="about" class="bg-gradient-to-b from-white to-soft/60 py-20">
    <div class="container-page max-w-5xl">
      <h2 class="section-title">About Me</h2>
      <div class="card mt-12 space-y-4 p-6 leading-relaxed text-muted md:p-8 md:text-lg">
        {bio.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="mt-12 text-2xl font-bold text-navy">Relevant Coursework</h3>
      <ul class="mt-5 flex flex-wrap gap-2">
        {education.coursework.map((c) => <li class="rounded-lg border border-line bg-white px-3.5 py-2 text-sm font-medium text-ink">{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="bg-white py-20">
    <div class="container-page max-w-5xl">
      <h2 class="section-title">Education</h2>
      <div class="card mt-12 p-6 md:p-8">
        <div class="flex gap-4">
          <span class="icon-tile"><Icon name="graduation-cap" size={22} /></span>
          <div class="min-w-0 flex-1">
            <h3 class="text-2xl font-bold text-navy">Bachelor of Arts, Computer Science</h3>
            <p class="mt-1 text-muted">{education.school}, {education.location}</p>
            <div class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
              <p><span class="font-semibold text-ink">Graduated:</span> <span class="text-muted">{education.date}</span></p>
              <p><span class="font-semibold text-ink">GPA:</span> <span class="font-semibold text-teal-ink">3.72/4.0</span> <span class="text-muted">(Major 3.82)</span></p>
            </div>

            <div class="mt-6 grid gap-6 border-t border-line pt-6 sm:grid-cols-2">
              <div>
                <h4 class="flex items-center gap-2 font-semibold text-ink"><Icon name="award" size={18} class="text-teal-ink" /> Honors &amp; Recognition</h4>
                <ul class="mt-3 space-y-1.5 text-sm text-muted">
                  <li>Dean's List, Spring 2022</li>
                  <li>Honors List, Fall 2021, 2023, 2024, 2025</li>
                </ul>
              </div>
              <div>
                <h4 class="flex items-center gap-2 font-semibold text-ink"><Icon name="award" size={18} class="text-teal-ink" /> Certifications</h4>
                <ul class="mt-3 space-y-1.5 text-sm text-muted">
                  {credentials.map((c) => <li><span class="text-ink">{c.title}</span>, {c.detail.split(' · ').slice(-2).join(', ')}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="bg-gradient-to-b from-soft/60 to-white py-20">
    <div class="container-page max-w-5xl">
      <h2 class="section-title">Experience</h2>
      <div class="mt-12 space-y-6">
        {
          experience.map((job) => (
            <article class="card p-6 md:p-8">
              <div class="flex gap-4">
                <span class="icon-tile">
                  <Icon name="briefcase" size={22} />
                </span>
                <div class="min-w-0 flex-1">
                  <h3 class="text-xl font-bold text-navy md:text-2xl">{job.role}</h3>
                  <p class="mt-0.5 text-muted">{job.company}</p>
                  <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
                    <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={15} /> {job.dates}</span>
                    <span class="inline-flex items-center gap-1.5"><Icon name="map-pin" size={15} /> {job.location}</span>
                  </p>
                  <ul class="dot-list mt-4 space-y-2 text-[0.9375rem] leading-relaxed text-ink/85">
                    {job.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="bg-white py-20">
    <div class="container-page">
      <h2 class="section-title">Skills</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          skills.map((g) => (
            <div class="card p-6">
              <div class="flex items-center gap-3">
                <span class="icon-tile">
                  <Icon name={g.icon as 'code'} size={22} />
                </span>
                <h3 class="text-lg font-bold leading-snug text-navy">{g.group}</h3>
              </div>
              <ul class="dot-list mt-5 space-y-2 text-[0.9375rem] text-ink/85">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="bg-gradient-to-b from-white to-soft/60 py-20">
    <div class="container-page">
      <h2 class="section-title">Featured Projects</h2>
      <p class="mt-6 text-center">
        <a href="/projects" class="inline-flex items-center gap-1.5 font-medium text-teal-ink hover:underline">
          View All Projects ({projects.length})
          <Icon name="external-link" size={15} />
        </a>
      </p>
      <div class="mt-10">
        <ProjectCarousel />
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="bg-white py-20">
    <div class="container-page max-w-5xl">
      <h2 class="section-title">Get In Touch</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <p class="text-lg text-muted">
            I'm always open to discussing new opportunities, projects, or collaborations. Feel free to reach out!
          </p>
          <ul class="mt-6 space-y-3">
            {
              contacts.map((c) => (
                <li>
                  <a
                    href={c.href}
                    target={c.href.startsWith('http') ? '_blank' : undefined}
                    rel={c.href.startsWith('http') ? 'noopener' : undefined}
                    class="flex items-center gap-4 rounded-xl bg-soft/70 p-4 transition-colors hover:bg-teal-wash"
                  >
                    <span class="icon-tile size-11">
                      <Icon name={c.icon} size={19} />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-xs text-muted">{c.label}</span>
                      <span class="block truncate font-semibold text-ink">{c.value}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <form class="card space-y-5 p-6 md:p-8" data-contact-form novalidate>
          <div>
            <label for="cf-name" class="mb-1.5 block text-sm font-semibold text-ink">Name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" placeholder="Your name" class="field" required />
          </div>
          <div>
            <label for="cf-email" class="mb-1.5 block text-sm font-semibold text-ink">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" placeholder="your.email@example.com" class="field" required />
          </div>
          <div>
            <label for="cf-message" class="mb-1.5 block text-sm font-semibold text-ink">Message</label>
            <textarea id="cf-message" name="message" rows="5" placeholder="Your message..." class="field resize-y" required></textarea>
          </div>
          <p class="hidden text-sm text-red-700" role="alert" data-form-error>Please fill in your name, email, and message.</p>
          <button type="submit" class="btn btn-teal w-full">Send Message</button>
          <p class="text-center text-xs text-muted">Opens your email app with the message ready to send.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(135deg, #0f2757 0%, #175e82 100%);
  }
  .hero-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: rgb(255 255 255 / 0.85);
    transition: background-color 150ms, color 150ms;
  }
  .hero-icon:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }
  .scroll-cue {
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translate(-50%, 8px);
    }
  }
</style>

<script>
  import { profile } from '../data/portfolio';

  // GitHub Pages has no backend, so the form hands the message to the visitor's email app.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const error = form.querySelector<HTMLElement>('[data-form-error]')!;
    if (!name || !email || !message) {
      error.classList.remove('hidden');
      form.querySelector<HTMLElement>(!name ? '#cf-name' : !email ? '#cf-email' : '#cf-message')?.focus();
      return;
    }
    error.classList.add('hidden');
    const subject = `Portfolio message from ${name}`;
    const body = `${message}\n\n${name}\n${email}`;
    window.location.href = `mailto:${profile.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
