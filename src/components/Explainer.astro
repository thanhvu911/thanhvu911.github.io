---
// The animated explainer for a project: a 60 fps looping video (square on
// phones and in cards, wide on larger screens) over its still frame. The video
// loads only when it scrolls into view and pauses off screen; with reduced
// motion only the still shows.
interface Props {
  slug: string;
  alt: string;
  /** Always use the square version (cards). */
  square?: boolean;
  eager?: boolean;
  class?: string;
}
const { slug, alt, square = false, eager = false, class: cls } = Astro.props;
const base = `/animations/${slug}`;
---

<div class:list={['explainer', cls]} data-explainer data-wide={square ? undefined : `${base}.mp4`} data-sq={`${base}-sq.mp4`}>
  <picture class="block">
    {!square && <source media="(max-width: 767px)" srcset={`${base}-sq-still.webp`} width="900" height="900" />}
    <img
      src={square ? `${base}-sq-still.webp` : `${base}-still.webp`}
      alt={alt}
      width={square ? 900 : 1200}
      height={square ? 900 : 675}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="block h-auto w-full"
    />
  </picture>
  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
</div>

<style>
  .explainer {
    position: relative;
  }
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 200ms;
  }
  video.is-playing {
    opacity: 1;
  }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const phone = matchMedia('(max-width: 767px)');
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach(({ target, isIntersecting }) => {
          const box = target as HTMLElement;
          const video = box.querySelector('video')!;
          if (!isIntersecting) return video.pause();
          if (!video.src) {
            video.src = (phone.matches ? box.dataset.sq : box.dataset.wide) ?? box.dataset.sq!;
            video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
          }
          video.play().catch(() => {});
        }),
      { threshold: 0.25 },
    );
    document.querySelectorAll('[data-explainer]').forEach((el) => io.observe(el));
  }
</script>
