---
import Icon from './Icon.astro';
import { profile } from '../data/portfolio';

const hasForm = Boolean(profile.web3formsKey);
const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${profile.email}&su=${encodeURIComponent('Opportunity for Thanh Vu')}`;

const quick = [
  { id: 'email', icon: 'mail', title: 'Email', detail: profile.email, href: `mailto:${profile.email}` },
  { id: 'gmail', icon: 'external-link', title: 'Write in Gmail', detail: 'Opens Gmail in a new tab', href: gmailHref, external: true },
  { id: 'linkedin', icon: 'linkedin', title: 'LinkedIn', detail: 'linkedin.com/in/thanh25', href: profile.linkedin, external: true },
] as const;
---

<section id="contact" class="section">
  <div class="container-page">
    <h2 class="section-title" data-reveal>Get in touch</h2>
    <p class="section-lede" data-reveal>
      Hiring for a data role, reviewing my graduate application, or interested in a project? Use whichever is easiest. I usually reply within a day.
    </p>

    <div class:list={['mt-10 grid gap-10', hasForm && 'lg:grid-cols-2']}>
      <div>
        <ul class:list={['grid gap-3', !hasForm && 'sm:grid-cols-2']}>
          {
            quick.map((q) => (
              <li>
                <a
                  href={q.href}
                  target={'external' in q ? '_blank' : undefined}
                  rel={'external' in q ? 'noopener' : undefined}
                  class="contact-row"
                  data-goatcounter-click={`contact-${q.id}`}
                >
                  <span class="icon-tile"><Icon name={q.icon} size={18} /></span>
                  <span class="min-w-0">
                    <span class="block font-semibold text-strong">{q.title}</span>
                    <span class="block truncate text-sm text-muted">{q.detail}</span>
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a href="#contact" class="contact-row" data-phone={profile.phoneReversed} data-goatcounter-click="contact-phone" hidden>
              <span class="icon-tile"><Icon name="phone" size={18} /></span>
              <span class="min-w-0">
                <span class="block font-semibold text-strong">Call or text</span>
                <span class="block text-sm text-muted" data-phone-text></span>
              </span>
            </a>
          </li>
        </ul>

        <p class="mt-5 flex items-center gap-2 text-muted">
          <Icon name="map-pin" size={17} class="shrink-0 text-teal-ink" />
          {profile.location}
        </p>

        <button
          type="button"
          class="mt-3 inline-flex min-h-11 items-center gap-2 rounded-md px-2 -ml-2 text-sm font-semibold text-teal-ink hover:bg-soft"
          data-copy-email={profile.email}
        >
          <Icon name="copy" size={16} />
          <span data-copy-label>Copy email address</span>
        </button>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </div>

      {
        hasForm && (
          <form class="card space-y-5 p-6 md:p-8" data-contact-form data-key={profile.web3formsKey} novalidate>
            <h3 class="text-lg font-semibold">Send a message</h3>
            <div>
              <label for="cf-name" class="mb-1.5 block text-sm font-semibold text-ink">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" class="field" required />
            </div>
            <div>
              <label for="cf-email" class="mb-1.5 block text-sm font-semibold text-ink">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" class="field" required />
            </div>
            <div>
              <label for="cf-message" class="mb-1.5 block text-sm font-semibold text-ink">Message</label>
              <textarea id="cf-message" name="message" rows="5" placeholder="What role, program, or project is this about?" class="field resize-y" required />
            </div>
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
            <p class="hidden rounded-md px-3 py-2 text-sm" role="status" data-form-status />
            <button type="submit" class="btn btn-primary w-full" data-submit>
              Send message
            </button>
          </form>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--card-border);
    border-radius: 0.875rem;
    background: var(--card-bg);
    transition: border-color 200ms, box-shadow 200ms;
  }
  .contact-row:hover {
    border-color: var(--card-hover-border);
    box-shadow: var(--card-hover-shadow);
  }
  .contact-row[hidden] {
    display: none;
  }
</style>

<script>
  // Copy email
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  copyBtn?.addEventListener('click', async () => {
    const label = copyBtn.querySelector('[data-copy-label]')!;
    const status = document.querySelector('[data-copy-status]')!;
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copyEmail!);
      label.textContent = 'Copied';
      status.textContent = 'Email address copied';
    } catch {
      label.textContent = copyBtn.dataset.copyEmail!;
    }
    setTimeout(() => {
      label.textContent = 'Copy email address';
      status.textContent = '';
    }, 2200);
  });

  // Web3Forms submission (only rendered when an access key is configured).
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const data = new FormData(form);
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = `rounded-md px-3 py-2 text-sm ${ok ? 'bg-teal-wash text-teal-ink' : 'bg-red-500/10 text-red-600'}`;
    };

    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    if (!name || !email || !message) {
      show('Fill in your name, email, and message to send.', false);
      form.querySelector<HTMLElement>(!name ? '#cf-name' : !email ? '#cf-email' : '#cf-message')?.focus();
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Sending…';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: form.dataset.key,
          subject: `Portfolio message from ${name}`,
          from_name: 'Thanh Vu portfolio',
          name,
          email,
          message,
          botcheck: data.get('botcheck') ? true : '',
        }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      show('Message sent. I will reply to your email soon.', true);
    } catch {
      show('The message did not go through. Email me directly or use LinkedIn instead.', false);
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send message';
    }
  });
</script>
