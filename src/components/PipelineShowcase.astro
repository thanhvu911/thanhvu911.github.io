---
// The pipeline I build, as four grid cells: public data flows through cleaning
// and a Medallion warehouse into a Power BI report. The stages light up in
// turn, and each one links to the project that built it.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import report from '../assets/projects/sales-planning-analysis/powerbi-page-3-store-manager-overview.png';

const sources = ['BLS', 'BEA', 'Census', 'USPS', 'CSV'];
const checks = ['Types cast', 'Nulls flagged', 'Duplicates removed', 'Silent bugs caught'];
const layers = [
  { name: 'Bronze', note: 'raw', color: '#c98a55', width: 100 },
  { name: 'Silver', note: 'cleaned', color: '#9fb0c6', width: 78 },
  { name: 'Gold', note: 'star schema', color: '#e4b53c', width: 56 },
];
---

<div class="pipe" aria-label="How my data pipelines work, from public data to a Power BI report">
  <ol class="stages">
    <li class="stage" style="--i:0">
      <a href="/projects/lancaster-economic-indicators-dashboard" class="node">
        <span class="mono">01 // Collect</span>
        <h3 class="display-md">Public data</h3>
        <p>Federal and public data from APIs and files.</p>
        <ul class="chips">{sources.map((s) => <li>{s}</li>)}</ul>
        <span class="more">Lancaster indicators <Icon name="arrow-right" size={14} /></span>
      </a>
    </li>
    <li class="stage" style="--i:1">
      <a href="/projects/can-mail-data-predict-housing-vacancy" class="node">
        <span class="mono">02 // Clean</span>
        <h3 class="display-md">Validate</h3>
        <p>Fabric Dataflow Gen2, Power Query, Python.</p>
        <ul class="checks">{checks.map((c, n) => <li style={`--n:${n}`}><i aria-hidden="true"><Icon name="check" size={11} /></i>{c}</li>)}</ul>
        <span class="more">Housing vacancy <Icon name="arrow-right" size={14} /></span>
      </a>
    </li>
    <li class="stage" style="--i:2">
      <a href="/projects/grocery-transaction-data-warehouse" class="node">
        <span class="mono">03 // Model</span>
        <h3 class="display-md">Warehouse</h3>
        <p>Medallion warehouse over 131M+ rows.</p>
        <ul class="layers">
          {layers.map((l, n) => (
            <li style={`--n:${n};--c:${l.color};--w:${l.width}%`}>
              <span>{l.name}</span>
              <span class="track"><span class="fill"></span></span>
            </li>
          ))}
        </ul>
        <span class="more">Grocery warehouse <Icon name="arrow-right" size={14} /></span>
      </a>
    </li>
    <li class="stage" style="--i:3">
      <a href="/projects/sales-planning-analysis#dashboard" class="node">
        <span class="mono">04 // Serve</span>
        <h3 class="display-md">Power BI</h3>
        <p>Reports people open every day.</p>
        <span class="shot">
          <span class="shot-bar" aria-hidden="true"></span>
          <Image src={report} alt="Store and manager overview page of a Power BI report" widths={[360, 540]} sizes="(min-width: 1024px) 22vw, 90vw" class="block h-auto w-full" />
        </span>
        <span class="more">Sales planning <Icon name="arrow-right" size={14} /></span>
      </a>
    </li>
  </ol>
  <div class="runbar" aria-hidden="true">
    <span class="mono">Run // <b>succeeded</b></span>
    <span class="wire"><i></i><i></i></span>
    <span class="mono">Refresh // daily</span>
  </div>
</div>

<style>
  .pipe {
    --cycle: 8s;
  }
  .stages {
    display: grid;
    gap: 1px;
    background: var(--color-line);
  }
  @media (min-width: 640px) {
    .stages {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .stages {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stage {
    position: relative;
    background: var(--color-bg);
  }
  .node {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 25rem;
    padding: 1.75rem 1rem 1.5rem;
    transition: background-color 300ms;
  }
  @media (min-width: 768px) {
    .node {
      padding-inline: 1.875rem;
    }
  }
  /* Each stage lights up in turn: a cyan rule on top and a lighter panel. */
  .node::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
    animation: rule var(--cycle) cubic-bezier(0.22, 1, 0.36, 1) infinite;
    animation-delay: calc(var(--i) * var(--cycle) / 4);
  }
  .node {
    animation: lit var(--cycle) ease infinite;
    animation-delay: calc(var(--i) * var(--cycle) / 4);
  }
  @keyframes rule {
    0% {
      transform: scaleX(0);
    }
    6%,
    25% {
      transform: scaleX(1);
    }
    31%,
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
  @keyframes lit {
    0%,
    31%,
    100% {
      background-color: transparent;
    }
    6%,
    25% {
      background-color: var(--color-surface);
    }
  }
  .node:hover {
    background-color: var(--color-surface);
  }
  .node h3 {
    margin-top: 1.25rem;
    font-size: 1.625rem;
  }
  .node > p {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1.375rem;
  }
  .chips li {
    padding: 0.3125rem 0.5625rem;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .checks {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.375rem;
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .checks i {
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    background: var(--color-strong);
    color: var(--color-bg);
  }
  .layers {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .layers li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: center;
    gap: 0.625rem;
  }
  .track {
    display: block;
    height: 0.5rem;
  }
  .fill {
    display: block;
    width: var(--w);
    height: 100%;
    background: var(--c);
    transform-origin: left;
    animation: fill var(--cycle) cubic-bezier(0.22, 1, 0.36, 1) infinite;
    animation-delay: calc(2 * var(--cycle) / 4 + var(--n) * 160ms);
  }
  @keyframes fill {
    0% {
      transform: scaleX(0.15);
    }
    14%,
    100% {
      transform: scaleX(1);
    }
  }
  .shot {
    display: block;
    margin-top: 1.375rem;
    border: 1px solid var(--color-strong);
    background: #fff;
  }
  .shot-bar {
    display: block;
    height: 6px;
    background: #f2c811;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .more :global(svg) {
    transition: transform 250ms;
  }
  .node:hover .more :global(svg) {
    transform: translateX(4px);
  }

  .runbar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 3.5rem;
    padding-inline: 1rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 768px) {
    .runbar {
      padding-inline: 2.5rem;
    }
  }
  .runbar b {
    color: var(--color-teal-ink);
    font-weight: 500;
  }
  .wire {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }
  /* Two packets travel down the wire. */
  .wire i {
    position: absolute;
    top: -3px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--color-cyan);
    animation: packet 4s linear infinite;
  }
  .wire i:nth-child(2) {
    animation-delay: -2s;
  }
  @keyframes packet {
    to {
      left: calc(100% - 7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node,
    .node::before,
    .fill,
    .wire i {
      animation: none;
    }
    .wire i:nth-child(2) {
      left: 60%;
    }
  }
</style>
