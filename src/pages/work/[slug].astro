---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { projects, type Project } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
---

<Base title={project.title} description={project.summary}>
  <article>
    <a href="/#projects" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-accent">
      <Icon name="arrow-left" size={14} />
      All projects
    </a>

    <h1 class="mt-6 text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">{project.title}</h1>
    <p class="mt-2 text-sm text-faint">{project.year}</p>
    <p class="mt-5 text-lg text-muted">{project.summary}</p>
    {project.context && <p class="mt-4 rounded-lg bg-accent-wash px-4 py-3 text-sm text-ink">{project.context}</p>}

    <div class="mt-6 flex flex-wrap items-center gap-2">
      {project.tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    <div
      class:list={[
        'mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line',
        project.metrics.length === 3 ? 'grid-cols-3' : 'grid-cols-2 sm:grid-cols-4',
      ]}
    >
      {
        project.metrics.map((m) => (
          <div class="bg-surface p-4">
            <p class="tnum text-2xl font-semibold tracking-tight text-ink">{m.value}</p>
            <p class="mt-0.5 text-sm text-muted">{m.label}</p>
          </div>
        ))
      }
    </div>

    <section class="mt-12" aria-labelledby="question">
      <h2 id="question" class="text-base font-semibold text-ink">The question</h2>
      <p class="mt-3 text-muted">{project.problem}</p>
    </section>

    <section class="mt-10" aria-labelledby="results">
      <h2 id="results" class="text-base font-semibold text-ink">Key results</h2>
      <ul class="mt-3 space-y-3">
        {
          project.results.map((r) => (
            <li class="flex gap-3 text-muted">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />
              {r}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12" aria-labelledby="images">
      <h2 id="images" class="text-base font-semibold text-ink">Dashboards, models, and code</h2>
      <div class="mt-5">
        <Gallery project={project} />
      </div>
    </section>

    <div class="mt-12 flex flex-wrap gap-2">
      <a href={project.repo} target="_blank" rel="noopener" class="btn btn-primary">
        <Icon name="github" size={15} />
        View code on GitHub
      </a>
    </div>

    <a href={`/work/${next.slug}`} class="group mt-16 flex items-center justify-between gap-4 border-t border-line pt-8">
      <span>
        <span class="block text-sm text-faint">Next project</span>
        <span class="mt-1 block text-lg font-medium text-ink transition-colors group-hover:text-accent">{next.title}</span>
      </span>
      <Icon name="arrow-right" size={20} class="shrink-0 text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent" />
    </a>
  </article>
</Base>
