---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/portfolio';
import { projectImage } from '../lib/images';

interface Props {
  project: Project;
}
const { project } = Astro.props;

// Full-size versions for the viewer (large WebP, capped width).
const items = await Promise.all(
  project.images.map(async (img) => {
    const src = projectImage(project.slug, img.file);
    const full = await getImage({ src, width: Math.min(src.width, 3000), format: 'webp', quality: 92 });
    return { ...img, src, full: full.src };
  }),
);
---

<div data-gallery>
  <ul class="mx-auto grid max-w-[68rem] gap-y-12">
    {
      items.map((img, i) => (
        <li>
          <button type="button" class="group block w-full text-left" data-open={i} data-full={img.full} data-caption={img.caption}>
            <span class="block cursor-zoom-in overflow-hidden rounded-lg border border-line bg-white shadow-[0_18px_40px_-26px_rgb(8_18_36/0.45)] transition-[border-color,box-shadow] group-hover:border-accent-bright">
              <Image
                src={img.src}
                alt={img.caption}
                widths={[960, 1440, 1920, 2560]}
                quality={90}
                sizes="(min-width: 1152px) 1088px, 100vw"
                class="block h-auto w-full"
              />
            </span>
            <span class="mt-3 block text-[0.9375rem] text-muted group-hover:text-ink">{img.caption}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="viewer" aria-label="Image viewer" data-viewer>
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 md:px-6">
        <p class="min-w-0 truncate text-sm text-white" data-v-caption></p>
        <div class="flex items-center gap-1 text-white/70">
          <span class="mr-2 text-xs tabular-nums" data-v-count></span>
          <button type="button" class="v-btn" aria-label="Previous image" data-v-prev><Icon name="arrow-left" /></button>
          <button type="button" class="v-btn" aria-label="Next image" data-v-next><Icon name="arrow-right" /></button>
          <button type="button" class="v-btn" aria-label="Close" data-v-close><Icon name="x" /></button>
        </div>
      </div>
      <div class="flex min-h-0 flex-1 items-center justify-center p-4 md:p-8">
        <img alt="" class="max-h-full max-w-full rounded-md bg-white object-contain" data-v-img />
      </div>
    </div>
  </dialog>
</div>

<style>
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 14 26 / 0.95);
  }
  .v-btn {
    flex-shrink: 0;
    min-width: 2.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .v-btn:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const openers = [...root.querySelectorAll<HTMLButtonElement>('[data-open]')];
    const dialog = root.querySelector<HTMLDialogElement>('[data-viewer]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-v-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-v-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-v-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + openers.length) % openers.length;
      const b = openers[index];
      img.src = b.dataset.full!;
      img.alt = b.dataset.caption!;
      caption.textContent = b.dataset.caption!;
      count.textContent = `${index + 1} of ${openers.length}`;
    };

    openers.forEach((b, i) =>
      b.addEventListener('click', () => {
        opener = b;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-v-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-v-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-v-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  });
</script>
