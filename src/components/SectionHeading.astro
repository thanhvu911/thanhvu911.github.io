---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<h2
  id={`${id}-title`}
  class="sticky top-0 z-10 -mx-6 mb-6 bg-bg/85 px-6 py-4 text-sm font-semibold text-ink backdrop-blur md:-mx-12 md:px-12 lg:static lg:mx-0 lg:mb-8 lg:bg-transparent lg:p-0 lg:text-base lg:backdrop-blur-none"
>
  {title}
</h2>
