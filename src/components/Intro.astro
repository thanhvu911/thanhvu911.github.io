---
import { profile } from '../data/portfolio';
---

<div class="intro" data-intro role="dialog" aria-label="Introduction to Thanh Vu">
  <i class="intro-half intro-top"></i>
  <i class="intro-half intro-bot"></i>
  <canvas class="intro-canvas" data-intro-canvas aria-hidden="true"></canvas>

  <button type="button" class="intro-skip" data-intro-skip>Skip <span aria-hidden="true">»</span></button>

  <div class="intro-top-txt">
    <p class="intro-eyebrow" data-eyebrow>Hi, I'm</p>
    <p class="intro-name" data-name aria-label={profile.name}>{profile.name}</p>
    <p class="intro-role" data-role>{profile.role}</p>
    <p class="intro-pitch" data-pitch>I turn messy data into clear answers. Here's how.</p>
  </div>

  <div class="intro-bottom-txt" aria-hidden="true">
    <div class="intro-card is-swap" data-card>
      <p class="intro-step" data-step>01 / RAW</p>
      <p class="intro-count" data-count>0</p>
      <p class="intro-countlabel" data-countlabel>&nbsp;</p>
      <p class="intro-ctitle" data-ctitle>&nbsp;</p>
      <p class="intro-ticker" data-ticker>&nbsp;</p>
    </div>
  </div>

  <div class="intro-flash" data-flash aria-hidden="true"></div>
</div>

<style is:global>
  .intro { display: none; }
  html.intro-on { overflow: hidden; }
  .assistant-launch { transition: opacity 0.5s ease; }
  html.intro-on .assistant-launch { opacity: 0; pointer-events: none; }
  html.intro-on .intro { position: fixed; inset: 0; z-index: 1000; display: block; overflow: hidden; color: var(--color-ink); }
  .intro-half { position: absolute; left: 0; right: 0; height: 50.5%; background: var(--color-bg); transition: transform 0.8s cubic-bezier(0.7, 0, 0.2, 1); }
  .intro-top { top: 0; border-bottom: 3px solid transparent; }
  .intro-bot { bottom: 0; border-top: 3px solid transparent; }
  .intro.is-open .intro-top { transform: translateY(-101%); }
  .intro.is-open .intro-bot { transform: translateY(101%); }
  .intro-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; }
  .intro-top-txt { position: absolute; left: 0; right: 0; top: 7%; text-align: center; padding: 0 1rem; transition: opacity 0.25s; pointer-events: none; }
  .intro-eyebrow { font-family: var(--font-mono); font-size: 1rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-ink); margin: 0 0 0.8rem; opacity: 0; transition: opacity 0.5s; }
  .intro-eyebrow.is-on { opacity: 1; }
  .intro-name { font-family: var(--font-display); font-size: clamp(2.6rem, 11vw, 6.6rem); line-height: 0.95; letter-spacing: 0.01em; color: var(--color-strong); margin: 0; text-transform: uppercase; overflow: hidden; padding-bottom: 0.08em; }
  .intro-name span { display: inline-block; transform: translateY(105%); transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); transition-delay: calc(var(--i) * 45ms); }
  .intro-name.is-on span { transform: none; }
  .intro-role { font-family: var(--font-sans); font-weight: 600; font-size: clamp(0.95rem, 2.6vw, 1.4rem); color: var(--color-accent-ink); margin: 0.7rem 0 0; opacity: 0; transform: translateY(10px); transition: opacity 0.6s, transform 0.6s; }
  .intro-role.is-on { opacity: 1; transform: none; }
  .intro-pitch, .intro-step, .intro-countlabel, .intro-ticker { display: none; }
  .intro-pitch { font-family: var(--font-sans); font-size: clamp(0.95rem, 2.4vw, 1.15rem); color: var(--color-ink); margin: 0.45rem 0 0; opacity: 0; transition: opacity 0.6s; }
  .intro-pitch.is-on { opacity: 1; }
  .intro-bottom-txt { position: absolute; left: 0; right: 0; bottom: 3%; text-align: center; padding: 0 1rem; transition: opacity 0.25s; pointer-events: none; }
  .intro-count { font-family: var(--font-mono); font-weight: 700; font-size: clamp(1.7rem, 5.5vw, 2.9rem); letter-spacing: -0.02em; margin: 0; color: var(--color-strong); font-variant-numeric: tabular-nums; }
  .intro-countlabel { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink); margin: 0.2rem 0 0.8rem; }
  .intro-card { max-width: 40rem; margin: 0 auto; transition: opacity 0.22s, transform 0.22s; }
  .intro-card.is-swap { opacity: 0; transform: translateY(8px); }
  .intro-step { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em; color: var(--color-accent-ink); margin: 0 0 0.2rem; font-weight: 600; }
  .intro-ctitle { font-family: var(--font-display); font-size: clamp(0.95rem, 2.6vw, 1.2rem); color: var(--color-strong); margin: 0 0 0.35rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .intro-ticker { font-family: var(--font-sans); font-size: clamp(0.95rem, 2.4vw, 1.1rem); line-height: 1.45; color: var(--color-ink); margin: 0; min-height: 2.9em; }
  .intro.is-burst .intro-top-txt, .intro.is-burst .intro-bottom-txt { opacity: 0; }
  .intro-skip {
    position: absolute; top: 1rem; right: 1rem; z-index: 3; min-height: 44px; padding: 0 1rem; cursor: pointer;
    font: 600 0.75rem var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-strong); background: var(--color-surface); border: 1px solid var(--color-line);
  }
  .intro-skip:hover, .intro-skip:focus-visible { border-color: var(--color-accent); outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .intro.is-burst .intro-skip { opacity: 0; pointer-events: none; }
  .intro-flash { position: absolute; inset: 0; background: var(--color-surface); opacity: 0; pointer-events: none; z-index: 1; }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.querySelector('[data-intro]');
    if (!el || !root.classList.contains('intro-on')) return;
    var $ = function (s) { return el.querySelector(s); };
    var canvas = $('[data-intro-canvas]');
    var ctx = canvas.getContext('2d');
    var cs = getComputedStyle(root);
    var v = function (n) { return cs.getPropertyValue(n).trim() || '#888'; };
    var C = {
      bg: v('--color-bg'), surface: v('--color-surface'), strong: v('--color-strong'), ink: v('--color-ink'), muted: v('--color-muted'),
      line: v('--color-line'), accent: v('--color-accent'), accentInk: v('--color-accent-ink'), blue: v('--color-blue'),
    };
    var mono = v('--font-mono');
    var nameEl = $('[data-name]'), roleEl = $('[data-role]'), eyebrow = $('[data-eyebrow]');
    var countEl = $('[data-count]'), tickEl = $('[data-ticker]'), flash = $('[data-flash]');
    var pitchEl = $('[data-pitch]'), cardEl = $('[data-card]'), stepEl = $('[data-step]'), labelEl = $('[data-countlabel]'), ctitleEl = $('[data-ctitle]');

    // split the name into letters that slide up
    var nm = nameEl.textContent;
    nameEl.textContent = '';
    nm.split('').forEach(function (ch, i) {
      var s = document.createElement('span');
      s.setAttribute('aria-hidden', 'true');
      s.style.setProperty('--i', i);
      s.textContent = ch === ' ' ? ' ' : ch;
      nameEl.appendChild(s);
    });

    var BURST = 6700, END = 9000;
    var low = false, lastNow = 0, slowSum = 0, slowN = 0, perfChecked = false;
    var ST = [500, 1650, 2800, 3950, 5100];   // when the data reaches each stage
    var GLOSS = ['RAW = THE ORIGINAL FILES', 'BRONZE = SAVED AS-IS', 'SILVER = CLEANED UP', 'GOLD = READY TO USE', 'POWER BI = THE REPORT TOOL'];
    var CARDS = [
      { n: 12, fmt: function (v) { return v + ' GB'; }, label: 'of messy files to start with', title: 'Start with the raw mess', text: 'Files from many different sources. I keep an untouched copy, so nothing is ever lost.' },
      { n: 131, fmt: function (v) { return v + 'M+'; }, label: 'records collected', title: 'Collect it all, safely', text: 'More than 131 million records loaded at once, with an automatic record of anything that goes wrong.' },
      { n: 1.58, fmt: function (v) { return v.toFixed(2) + 'M'; }, label: 'orders with totals that did not add up', title: 'Catch mistakes early', text: '21 automatic checks found them, so the final numbers can be trusted.' },
      { n: 43.8, fmt: function (v) { return v.toFixed(1) + 'M'; }, label: 'records organized for answers', title: 'Organize it so questions get answers', text: 'Clean data arranged into simple, tested tables that anyone can ask questions of.' },
      { n: 6, fmt: function (v) { return v + ' counties tested'; }, label: 'did mailed-letter data track housing vacancy?', title: 'Turn it into a clear report', text: 'It depends on the county. The dashboard shows where it works and where it does not.' },
    ];
    var STAGES = ['RAW', 'BRONZE', 'SILVER', 'GOLD', 'POWER BI'];

    var W = 0, H = 0, dpr = 1, x0 = 0, x1 = 0, py = 0, S = 34, mob = false, diag = 0;
    function size() {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight; mob = W < 700;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      x0 = W * (mob ? 0.12 : 0.1); x1 = W * (mob ? 0.86 : 0.88);
      py = H * 0.575; S = mob ? 36 : 54; diag = Math.hypot(W, H);
    }
    size();
    addEventListener('resize', size);

    var rnd = function (i) { var s = Math.sin(i * 127.1 + 3.7) * 43758.5453; return s - Math.floor(s); };
    var clamp = function (x, a, b) { return Math.min(b === undefined ? 1 : b, Math.max(a === undefined ? 0 : a, x)); };
    var smooth = function (x) { x = clamp(x); return x * x * (3 - 2 * x); };

    var N = mob ? 36 : 60;
    var chaosCols = [C.ink, C.muted, C.accent, C.blue];
    var ps = [];
    for (var i = 0; i < N; i++) {
      ps.push({ d: rnd(i) * 650, lane: Math.floor(rnd(i + 5) * 5) - 2, ph: rnd(i + 2) * 6.28, f: 2 + rnd(i + 8) * 3,
        s0: 3 + rnd(i + 4) * 4, c0: chaosCols[Math.floor(rnd(i + 6) * 4)], vx: 0, vy: 0, x: 0, y: 0, a: 0 });
    }
    // Keep the words to a minimum: a big number and a two-word label per step.
    var SHORT = ['Messy files', 'Records loaded', 'Bad totals found', 'Rows organized', 'One clear report'];
    CARDS.forEach(function (c, i) { c.title = SHORT[i]; c.label = ''; c.text = ''; });
    CARDS[4].fmt = function (v) { return v + ' counties'; };
    var act = ST.slice();
    // 0..1 along the rail: the data reaches stage k at time ST[k]
    function prog(u) {
      if (u <= ST[0]) return 0;
      if (u >= ST[4]) return 1;
      for (var k = 0; k < 4; k++) if (u < ST[k + 1]) return (k + (u - ST[k]) / (ST[k + 1] - ST[k])) / 4;
      return 1;
    }
    var cardStart = 0, shown = -1;
    var profile = [0.45, 0.62, 0.5, 0.78, 0.92, 0.7, 1, 0.85];

    function nodeX(k) { return x0 + (x1 - x0) * (k / 4); }
    function pos(p, t) {
      var q = prog(t - p.d);
      var A0 = Math.min(H * 0.1, 56);
      var chaos = (Math.sin(t / 1000 * p.f + p.ph) + Math.sin(t / 1000 * p.f * 1.7 + p.ph * 2) * 0.5) / 1.5;
      var y = py + chaos * A0 * (1 - smooth(q / 0.3)) + p.lane * (mob ? 7 : 10) * (1 - smooth((q - 0.5) / 0.25));
      return { q: q, x: x0 + (x1 - x0) * q, y: y };
    }

    var t0 = performance.now(), offset = 0;
    var burst = false, finished = false, tickI = -1, nameOn = false;
    var bursts = [], rings = [];

    var flyers = [], mosaic = [], photoRc = null;
    function shape(n, sz) {
      var h = sz / 2;
      if (n === 0) { ctx.strokeStyle = C.muted; ctx.lineWidth = 2; ctx.strokeRect(-h, -h, sz, sz); }
      if (n === 1) {
        ctx.strokeStyle = C.accentInk; ctx.lineWidth = 2; ctx.strokeRect(-h, -h, sz, sz);
        ctx.save(); ctx.beginPath(); ctx.rect(-h, -h, sz, sz); ctx.clip(); ctx.lineWidth = 1.5; ctx.beginPath();
        for (var hh = -sz; hh < sz; hh += Math.max(4, sz / 7)) { ctx.moveTo(hh, h); ctx.lineTo(hh + sz, -h); } ctx.stroke(); ctx.restore();
      }
      if (n === 2) { ctx.fillStyle = C.muted; ctx.fillRect(-h, -h, sz, sz); }
      if (n === 3) { ctx.fillStyle = C.accent; ctx.fillRect(-h, -h, sz, sz); }
      if (n === 4) {
        ctx.strokeStyle = C.strong; ctx.lineWidth = 2; ctx.strokeRect(-h, -h, sz, sz);
        ctx.fillStyle = C.accent; var m = sz * 0.14;
        [0.35, 0.6, 0.85].forEach(function (b, bi) { ctx.fillRect(-h + m + bi * (sz - 2 * m) / 3, h - m - (sz - 2 * m) * b, (sz - 2 * m) / 3 - 2, (sz - 2 * m) * b); });
      }
    }

    function frame(now) {
      if (finished) return;
      var t = now - t0 + offset;

      // ---- slow-phone fallback: measure early frame times ----
      if (!perfChecked) {
        if (lastNow && t > 300) { slowSum += Math.min(now - lastNow, 200); slowN++; }
        lastNow = now;
        if (t > 1500 && slowN > 8) {
          perfChecked = true;
          var avg = slowSum / slowN;
          if (avg > 90) return finish();   // far too slow: skip the intro
          if (avg > 38) low = true;        // slow: fewer particles, bigger pixels
        }
      }

      // ---- DOM text ----
      if (t > 80) eyebrow.classList.add('is-on');
      if (t > 150 && !nameOn) { nameOn = true; nameEl.classList.add('is-on'); }
      if (t > 1100) roleEl.classList.add('is-on');
      var si = -1;
      for (var k = ST.length - 1; k >= 0; k--) if (t >= ST[k]) { si = k; break; }
      if (si !== tickI) {
        tickI = si;
        if (si >= 0) {
          cardEl.classList.add('is-swap');
          var cc = CARDS[si];
          setTimeout(function () {
            stepEl.textContent = 'STEP ' + (si + 1) + ' OF 5  ·  ' + GLOSS[si];
            labelEl.textContent = cc.label; ctitleEl.textContent = cc.title; tickEl.textContent = cc.text;
            cardEl.classList.remove('is-swap');
            shown = si; cardStart = performance.now() - t0 + offset;
          }, tickI === 0 ? 0 : 180);
          cardStart = t;
        } else cardEl.classList.add('is-swap');
      }
      if (shown >= 0) {
        var cd = CARDS[shown], ce = 1 - Math.pow(1 - clamp((t - cardStart - 150) / 650), 3), cv = cd.n * (0.3 + 0.7 * ce);
        if (cd.n % 1 === 0) cv = Math.round(cv);
        countEl.textContent = cd.fmt(cv);
      }

      // ---- burst trigger ----
      if (t >= BURST && !burst) {
        burst = true;
        el.classList.add('is-burst');
        flash.animate([{ opacity: 0.8 }, { opacity: 0 }], { duration: 480, easing: 'ease-out' });
        var by = py;
        ps.forEach(function (p, pi) {
          if (pi % 2) return;
          p.c0 = pi % 4 ? C.accent : C.strong;
          var o = pos(p, BURST), ang = Math.atan2(o.y - by, o.x - W / 2) + (Math.random() - 0.5) * 1.2, sp = 250 + Math.random() * 1300;
          bursts.push({ x: o.x, y: o.y, vx: Math.cos(ang) * sp * 1.2, vy: Math.sin(ang) * sp * 0.35, s: p.s0 + 1, c: p.c0, r: Math.random() * 6, t: BURST });
        });
        // The five stage nodes fly to the real strip in the hero underneath.
        var targets = el.ownerDocument.querySelectorAll('.pipe-nodes .pn');
        for (var k2 = 0; k2 < 5; k2++) {
          var rc = targets[k2] && targets[k2].getBoundingClientRect();
          var ok = rc && rc.width > 2 && rc.top > -50 && rc.top < H;
          flyers.push({ x: nodeX(k2), y: py, s: S, tx: ok ? rc.left + rc.width / 2 : nodeX(k2), ty: ok ? rc.top + rc.height / 2 : py - 160, ts: ok ? rc.width : S * 0.5 });
        }
        // The data turns into a face: a pixel portrait builds where the hero photo is, then dissolves into the real photo.
        try {
          var im = document.querySelector('.h-photo img');
          var rc2 = im && im.getBoundingClientRect();
          if (im && im.complete && im.naturalWidth && rc2.width > 40 && rc2.top < H && rc2.bottom > 0) {
            var cell = low ? 11 : mob ? 6 : 7, cols = Math.max(6, Math.round(rc2.width / cell)), rows = Math.max(6, Math.round(rc2.height / cell));
            var oc = document.createElement('canvas'); oc.width = cols; oc.height = rows;
            var ox = oc.getContext('2d'), sc = Math.max(rc2.width / im.naturalWidth, rc2.height / im.naturalHeight), sw = rc2.width / sc, sh = rc2.height / sc;
            // Crop exactly like the real photo does (object-position), so the pixel portrait lines up with it.
            var opos = (getComputedStyle(im).objectPosition || '50% 50%').split(' '), opx = parseFloat(opos[0]), opy = parseFloat(opos[1]);
            opx = isNaN(opx) ? 0.5 : opx / 100; opy = isNaN(opy) ? 0.5 : opy / 100;
            ox.drawImage(im, (im.naturalWidth - sw) * opx, (im.naturalHeight - sh) * opy, sw, sh, 0, 0, cols, rows);
            var px2 = ox.getImageData(0, 0, cols, rows).data;
            photoRc = rc2;
            // Four tones from the stage palette, split by quartile so the face, hair and suit stay distinct whatever the photo's lighting.
            var lums = [];
            for (var li = 0; li < cols * rows; li++) lums.push((0.299 * px2[li * 4] + 0.587 * px2[li * 4 + 1] + 0.114 * px2[li * 4 + 2]) / 255);
            var sorted = lums.slice().sort(function (a, b) { return a - b; }), qa = sorted[Math.floor(sorted.length * 0.3)], qb = sorted[Math.floor(sorted.length * 0.55)], qc = sorted[Math.floor(sorted.length * 0.8)];
            for (var rr = 0; rr < rows; rr++) for (var cc2 = 0; cc2 < cols; cc2++) {
              var lum = lums[rr * cols + cc2];
              mosaic.push({ x: rc2.left + (cc2 + 0.5) * rc2.width / cols, y: rc2.top + (rr + 0.5) * rc2.height / rows, w: rc2.width / cols + 0.6, h: rc2.height / rows + 0.6,
                col: lum < qa ? C.strong : lum < qb ? C.muted : lum < qc ? C.accent : C.surface,
                d: rnd(rr * cols + cc2) * 420, o: (rr / rows) * 260 });
            }
          }
        } catch (e) {}
        rings.push({ t: BURST, c: C.accent, w: 3 }, { t: BURST + 90, c: C.strong, w: 1.5 });
        setTimeout(function () { el.classList.add('is-open'); }, 760);
      }

      // ---- canvas ----
      ctx.clearRect(0, 0, W, H);
      if (!burst) {
        // faint grid
        ctx.strokeStyle = C.line; ctx.globalAlpha = 0.35; ctx.lineWidth = 1; ctx.beginPath();
        for (var gx = 0; gx < W; gx += 56) { ctx.moveTo(gx, 0); ctx.lineTo(gx, H); }
        for (var gy = 0; gy < H; gy += 56) { ctx.moveTo(0, gy); ctx.lineTo(W, gy); }
        ctx.stroke(); ctx.globalAlpha = 1;

        // rail + progress
        ctx.strokeStyle = C.line; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(x0, py); ctx.lineTo(x1, py); ctx.stroke();
        var lead = prog(t);
        ctx.strokeStyle = C.strong; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(x0, py); ctx.lineTo(x0 + (x1 - x0) * lead, py); ctx.stroke();

        // nodes
        for (var n = 0; n < 5; n++) {
          var nx = nodeX(n), on = t >= act[n], since = t - act[n];
          var sc = on ? 1 + 0.22 * Math.max(0, 1 - since / 380) : 1, sz = S * sc, h2 = sz / 2;
          ctx.save(); ctx.translate(nx, py);
          ctx.fillStyle = C.bg; ctx.fillRect(-h2, -h2, sz, sz);
          if (!on) { ctx.setLineDash([4, 4]); ctx.strokeStyle = C.line; ctx.lineWidth = 2; ctx.strokeRect(-h2, -h2, sz, sz); ctx.setLineDash([]); }
          else {
            if (n === 0) { ctx.strokeStyle = C.muted; ctx.lineWidth = 2; ctx.strokeRect(-h2, -h2, sz, sz); }
            if (n === 1) { ctx.strokeStyle = C.accentInk; ctx.lineWidth = 2; ctx.strokeRect(-h2, -h2, sz, sz);
              ctx.beginPath(); ctx.rect(-h2, -h2, sz, sz); ctx.clip(); ctx.lineWidth = 1.5; ctx.beginPath();
              for (var hh = -sz; hh < sz; hh += 7) { ctx.moveTo(hh, h2); ctx.lineTo(hh + sz, -h2); } ctx.stroke(); }
            if (n === 2) { ctx.fillStyle = C.muted; ctx.fillRect(-h2, -h2, sz, sz); }
            if (n === 3) { ctx.fillStyle = C.accent; ctx.fillRect(-h2, -h2, sz, sz); }
            if (n === 4) { ctx.strokeStyle = C.strong; ctx.lineWidth = 2; ctx.strokeRect(-h2, -h2, sz, sz);
              ctx.fillStyle = C.accent; [0.35, 0.6, 0.85].forEach(function (b, bi) { ctx.fillRect(-h2 + 5 + bi * (sz - 10) / 3, h2 - 5 - (sz - 10) * b, (sz - 10) / 3 - 3, (sz - 10) * b); }); }
          }
          ctx.restore();
          if (on && since < 650) { // pulse ring
            ctx.strokeStyle = C.accent; ctx.globalAlpha = 1 - since / 650; ctx.lineWidth = 2;
            ctx.beginPath(); ctx.arc(nx, py, S * 0.6 + since * 0.08, 0, 6.2832); ctx.stroke(); ctx.globalAlpha = 1;
          }
          ctx.fillStyle = on ? C.strong : C.muted; ctx.font = '700 ' + (mob ? 12 : 17) + 'px ' + mono; ctx.textAlign = 'center';
          ctx.fillText(STAGES[n] + (on ? ' ✓' : ''), nx, py + S * 0.5 + (mob ? 20 : 26));
          if (on && n < 4) { // a tiny picture of what happens at this stage
            var ga = clamp(since / 450), top = py - S * 0.5 - 14, fs = mob ? 10 : 13;
            ctx.globalAlpha = ga; ctx.font = '600 ' + fs + 'px ' + mono;
            var chips = null;
            if (chips) chips.forEach(function (label, ci) {
              var cw = label.length * (fs * 0.62) + 12, cy = top - ci * (fs + 12) - (1 - ga) * 8;
              ctx.fillStyle = C.surface; ctx.fillRect(nx - cw / 2, cy - fs - 3, cw, fs + 8);
              ctx.strokeStyle = n === 0 ? C.muted : n === 1 ? C.accentInk : C.strong; ctx.lineWidth = 1; ctx.strokeRect(nx - cw / 2, cy - fs - 3, cw, fs + 8);
              ctx.fillStyle = C.strong; ctx.fillText(label, nx, cy);
            });
            if (n === 3) { // star schema: one fact table, four dimensions
              var sy = top - (mob ? 46 : 70), r = mob ? 30 : 46;
              ctx.fillStyle = C.accentInk; ctx.fillText('', nx, sy - r - (mob ? 10 : 14));
              ctx.strokeStyle = C.accentInk; ctx.lineWidth = 1.5; ctx.beginPath();
              [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(function (d) { ctx.moveTo(nx, sy); ctx.lineTo(nx + d[0] * r, sy + d[1] * r); });
              ctx.stroke();
              var fb = mob ? 16 : 24, db = mob ? 11 : 16;
              ctx.fillStyle = C.accent; ctx.fillRect(nx - fb / 2, sy - fb / 2, fb, fb);
              ctx.fillStyle = C.surface; ctx.strokeStyle = C.strong; ctx.lineWidth = 1.5;
              [[-1, -1], [1, -1], [-1, 1], [1, 1]].forEach(function (d) { ctx.fillRect(nx + d[0] * r - db / 2, sy + d[1] * r - db / 2, db, db); ctx.strokeRect(nx + d[0] * r - db / 2, sy + d[1] * r - db / 2, db, db); });
            }
            ctx.globalAlpha = 1;
          }
        }

        // rows
        var arrived = 0;
        ps.forEach(function (p, pIdx) {
          if (low && pIdx % 2) return;
          var o = pos(p, t);
          if (t < 200 + p.d * 0.5) return;
          if (o.q >= 1) arrived++;
          var q = o.q, col = q < 0.25 ? p.c0 : q < 0.5 ? C.accentInk : q < 0.75 ? C.muted : C.accent;
          var sz2 = q < 0.25 ? p.s0 : q < 0.75 ? 5 : 5 + 3 * smooth((q - 0.75) / 0.25);
          if (q >= 1) return;
          if (q > 0.25) { ctx.strokeStyle = col; ctx.globalAlpha = 0.3; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(o.x - 14, o.y); ctx.lineTo(o.x, o.y); ctx.stroke(); }
          ctx.globalAlpha = 1; ctx.fillStyle = col; ctx.fillRect(o.x - sz2 / 2, o.y - sz2 / 2, sz2, sz2);
        });

        // chart rising from the Power BI node
        var a = arrived / (low ? Math.ceil(N / 2) : N), mh = Math.min(H * 0.2, 150), cardW = mob ? 132 : 210,
          bx0 = mob ? W / 2 - cardW / 2 + 10 : Math.min(x1 - cardW / 2 + 10, W - cardW - 4), base = py - S * 0.5 - 14;
        var tops = [];
        if (a > 0.03) { // the report card the bars sit in
          var cw2 = cardW, ch2 = mh + 34;
          ctx.fillStyle = C.surface; ctx.fillRect(bx0 - 10, base - ch2 + 10, cw2, ch2);
          ctx.strokeStyle = C.strong; ctx.lineWidth = 2; ctx.strokeRect(bx0 - 10, base - ch2 + 10, cw2, ch2);
          ctx.fillStyle = C.strong; ctx.fillRect(bx0 - 10, base - ch2 + 10, cw2, 16);
        }
        if (false) { // one gold pulse closes the pipeline
          var pp = (t - 4350) / 700, px = x0 + (x1 - x0) * pp;
          ctx.fillStyle = C.accent; ctx.fillRect(Math.max(x0, px - 150), py - 5, Math.min(150, px - x0), 10);
          ctx.fillRect(px - 7, py - 12, 14, 24);
        }
        if (a > 0.03) { // the real question from the vacancy project: do two sources track each other?
          var gw = cardW - 20, gl = bx0, gt = base - ch2 + 44, gh = ch2 - 74, gp = clamp((t - 5200) / 1300);
          ctx.fillStyle = C.surface; ctx.font = '600 ' + (mob ? 8 : 10) + 'px ' + mono; ctx.textAlign = 'left';
          ctx.font = '600 ' + (mob ? 10 : 12) + 'px ' + mono;
          [].forEach(function (lg) {
            var lx = gl + (mob ? lg[2] * 56 : lg[2] * 90), ly = base + 1;
            ctx.strokeStyle = lg[1]; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(lx, ly - 3); ctx.lineTo(lx + 12, ly - 3); ctx.stroke();
            ctx.fillStyle = C.ink; ctx.fillText(lg[0], lx + 16, ly);
          });
          ctx.strokeStyle = C.line; ctx.lineWidth = 1; ctx.beginPath();
          for (var gi = 0; gi < 4; gi++) { ctx.moveTo(gl, gt + gh * gi / 3); ctx.lineTo(gl + gw, gt + gh * gi / 3); } ctx.stroke();
          [[C.strong, 0], [C.accent, 1]].forEach(function (ln) {
            ctx.strokeStyle = ln[0]; ctx.lineWidth = 2.5; ctx.beginPath();
            for (var pi2 = 0; pi2 < 15; pi2++) {
              if (pi2 / 14 > gp) break;
              var base2 = 0.55 + 0.22 * Math.sin(pi2 / 2.6) + pi2 * 0.012, v2 = base2 + (ln[1] ? (rnd(pi2 + 40) - 0.5) * 0.12 : 0);
              var gx = gl + gw * pi2 / 14, gy = gt + gh * (1 - clamp(v2));
              pi2 ? ctx.lineTo(gx, gy) : ctx.moveTo(gx, gy);
            }
            ctx.stroke();
          });
        }
      } else {
        var bt = (t - BURST) / 1000;
        bursts.forEach(function (b) {
          var dt = (t - b.t) / 1000, drag = Math.exp(-dt * 2.2);
          var x = b.x + b.vx * (1 - drag) / 2.2, y = b.y + b.vy * (1 - drag) / 2.2 + (b.big ? 200 * dt * dt : 0);
          ctx.globalAlpha = clamp(1 - dt / 1.3); ctx.fillStyle = b.c;
          ctx.save(); ctx.translate(x, y); ctx.rotate(b.r + dt * (b.big ? 3 : 6)); ctx.fillRect(-b.s / 2, -b.s / 2, b.s, b.s); ctx.restore();
        });
        rings.forEach(function (r) {
          var rt = (t - r.t) / 1000; if (rt <= 0) return;
          ctx.globalAlpha = clamp(1 - rt / 0.9); ctx.strokeStyle = r.c; ctx.lineWidth = r.w;
          ctx.beginPath(); ctx.arc(W / 2, py, rt * diag * 0.55, 0, 6.2832); ctx.stroke();
        });
        ctx.globalAlpha = 1;
        mosaic.forEach(function (m) {
          var u = (t - BURST - 80 - m.d) / 240, out = (t - BURST - 1300 - m.o) / 550;
          if (u <= 0 || out >= 1) return;
          var s = smooth(u) * (1 - smooth(out));
          ctx.fillStyle = m.col; ctx.fillRect(m.x - m.w * s / 2, m.y - m.h * s / 2, m.w * s, m.h * s);
        });
        if (photoRc) { // a friendly label under the portrait
          var ca = smooth((t - BURST - 450) / 300) * (1 - smooth((t - BURST - 1650) / 350));
          if (ca > 0) {
            ctx.globalAlpha = ca; ctx.fillStyle = C.strong; ctx.font = '700 ' + (mob ? 14 : 19) + 'px ' + mono; ctx.textAlign = 'center';
            var capW = ctx.measureText("HI, THAT'S ME").width, capX = Math.min(W - capW / 2 - 12, Math.max(capW / 2 + 12, photoRc.left + photoRc.width / 2));
            ctx.fillText("HI, THAT'S ME", capX, photoRc.bottom + (mob ? 20 : 26)); ctx.globalAlpha = 1;
          }
        }
        var fp = smooth(clamp((t - BURST - 120) / 750));
        flyers.forEach(function (f, fi) {
          var q = smooth(clamp(fp * 1.15 - fi * 0.04)), sz3 = f.s + (f.ts - f.s) * smooth(q * 1.8), x3 = f.x + (f.tx - f.x) * q, y3 = f.y + (f.ty - f.y) * q - Math.sin(q * 3.1416) * 40;
          // fade out once landed, so the real nodes underneath take over with no pop
          ctx.save(); ctx.globalAlpha = 1 - smooth((t - BURST - 1500) / 600); ctx.translate(x3, y3); ctx.fillStyle = C.bg; ctx.fillRect(-sz3 / 2, -sz3 / 2, sz3, sz3); shape(fi, sz3); ctx.restore();
        });
      }
      ctx.globalAlpha = 1;

      if (t >= END) return finish();
      requestAnimationFrame(frame);
    }

    function finish() {
      if (finished) return;
      finished = true;
      removeEventListener('resize', size);
      document.removeEventListener('keydown', onKey);
      root.classList.remove('intro-on');
    }
    function skip() {
      if (finished) return;
      if (burst) return finish();
      offset += Math.max(0, BURST - (performance.now() - t0 + offset));
    }
    function onKey(e) { if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') { e.preventDefault(); skip(); } }
    $('[data-intro-skip]').addEventListener('click', skip);
    document.addEventListener('keydown', onKey);
    $('[data-intro-skip]').focus({ preventScroll: true });
    requestAnimationFrame(frame);
  })();
</script>
