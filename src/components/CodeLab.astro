---
// Runnable code on a project page: pick SQL or Python, edit it, press Run (or
// Ctrl+Enter), and the first 10 rows come back. Everything runs in the visitor's
// browser against a small table, so nothing is sent anywhere. Python (pandas)
// loads from the Pyodide CDN only when someone first runs it.
import type { Playground } from '../data/playgrounds';
interface Props {
  slug: string;
  pg: Playground;
}
const { slug, pg } = Astro.props;
---

<section class="lab" data-lab data-table={pg.table} aria-labelledby={`lab-${slug}`}>
  <div class="lab-head">
    <p class="mono lab-kicker">Try it // runs in your browser</p>
    <h2 id={`lab-${slug}`} class="lab-title">Write your own code</h2>
    <p class="lab-blurb">{pg.blurb}</p>
    <p class="mono lab-cols">Table <b>{pg.table}</b>: {pg.columns}</p>
  </div>

  <div class="lab-modes" role="group" aria-label="Language">
    <button type="button" class="lab-mode" data-mode="sql" aria-pressed="true">SQL</button>
    <button type="button" class="lab-mode" data-mode="py" aria-pressed="false">Python</button>
  </div>

  <div class="lab-chips" role="group" aria-label="Example queries" data-chips="sql">
    {pg.queries.map((q, i) => (
      <button type="button" class="lab-chip" data-code={q.sql} aria-pressed={i === 0 ? 'true' : 'false'}>{q.label}</button>
    ))}
  </div>
  <div class="lab-chips" role="group" aria-label="Example Python snippets" data-chips="py" hidden>
    {pg.py.map((q, i) => (
      <button type="button" class="lab-chip" data-code={q.code} aria-pressed={i === 0 ? 'true' : 'false'}>{q.label}</button>
    ))}
  </div>

  <div class="lab-editor">
    <div class="lab-top" aria-hidden="true">
      <span class="lab-dots"><i></i><i></i><i></i></span>
      <span class="lab-file" data-file>query.sql</span>
    </div>
    <div class="lab-ed">
      <pre class="lab-hl" aria-hidden="true"><code data-hl></code></pre>
      <label for={`sql-${slug}`} class="sr-only">Code editor</label>
      <textarea id={`sql-${slug}`} class="lab-sql" spellcheck="false" autocapitalize="off" autocomplete="off" rows="8" data-editor>{pg.queries[0].sql}</textarea>
    </div>
    <div class="lab-bar">
      <button type="button" class="btn btn-primary lab-run" data-run>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
        Run
      </button>
      <span class="mono lab-hint" data-hint>Ctrl + Enter</span>
      <span class="mono lab-stat" data-stat role="status" aria-live="polite">Loading data...</span>
    </div>
  </div>

  <div class="lab-out" data-out>
    <p class="lab-empty">Results appear here (first 10 rows). In Python, the last expression is shown, and print() works too.</p>
  </div>
</section>

<style>
  .lab {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 1.25rem;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .lab {
      padding: 1.75rem 2rem;
    }
  }
  .lab-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .lab-modes {
    display: inline-flex;
    margin-top: 1.25rem;
    border: 1px solid var(--color-line);
  }
  .lab-mode {
    min-height: 2.75rem;
    padding: 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .lab-mode + .lab-mode {
    border-left: 1px solid var(--color-line);
  }
  .lab-mode[aria-pressed='true'] {
    background: var(--color-strong);
    color: var(--color-bg);
  }
  .lab-title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: var(--color-strong);
  }
  .lab-blurb {
    margin-top: 0.5rem;
    color: var(--color-ink);
    max-width: 46rem;
  }
  .lab-cols {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .lab-cols b {
    color: var(--color-strong);
  }
  .lab-chips[hidden] {
    display: none;
  }
  .lab-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .lab-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 150ms, background 150ms;
  }
  .lab-chip:hover {
    border-color: var(--color-strong);
  }
  .lab-chip[aria-pressed='true'] {
    background: var(--color-strong);
    color: var(--color-bg);
    border-color: var(--color-strong);
  }
  .lab-editor {
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid #1d2b43;
    border-radius: 0.6rem;
    background: #0d1829;
    box-shadow: 0 18px 40px -22px rgb(8 18 36 / 0.65);
    transition: box-shadow 200ms, border-color 200ms;
  }
  .lab-top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid #1d2b43;
    background: #0a1322;
  }
  .lab-dots {
    display: inline-flex;
    gap: 0.4rem;
  }
  .lab-dots i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: #2a3a57;
  }
  .lab-dots i:first-child {
    background: #e8c27a;
  }
  .lab-file {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: #7f93b3;
  }
  .lab-ed {
    position: relative;
    min-height: 11rem;
  }
  .lab-hl,
  .lab-sql {
    margin: 0;
    padding: 1rem 1.15rem;
    border: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
    tab-size: 4;
    white-space: pre;
    letter-spacing: 0;
  }
  .lab-hl {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: #dbe5f5;
    pointer-events: none;
  }
  .lab-hl code {
    font: inherit;
  }
  .lab-sql {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 11rem;
    resize: vertical;
    outline: 0;
    background: transparent;
    color: transparent;
    caret-color: #e8c27a;
    overflow: auto;
  }
  .lab-sql::selection {
    background: rgb(232 194 122 / 0.28);
  }
  .lab-hl :global(.k) {
    color: #e8c27a;
    font-weight: 600;
  }
  .lab-hl :global(.s) {
    color: #9fd8ae;
  }
  .lab-hl :global(.n) {
    color: #f4a98f;
  }
  .lab-hl :global(.c) {
    color: #667b9c;
    font-style: italic;
  }
  .lab-hl :global(.f) {
    color: #8fb8ff;
  }
  .lab-editor:focus-within {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 2px;
    border-color: #e8c27a;
    box-shadow: 0 0 0 3px rgb(201 154 69 / 0.28), 0 18px 40px -22px rgb(8 18 36 / 0.65);
  }
  .lab-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-top: 1px solid #1d2b43;
    background: #0a1322;
  }
  .lab-bar :global(.btn-primary) {
    background: #e8c27a;
    color: #0d1829;
    border-color: #e8c27a;
  }
  .lab-bar :global(button:focus-visible),
  .lab-bar :global(a:focus-visible) {
    outline-color: #fff;
  }
  .lab-run {
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
  }
  .lab-hint,
  .lab-stat {
    font-size: 0.75rem;
    color: #7f93b3;
  }
  .lab-stat {
    margin-left: auto;
  }
  .lab-stat.is-error {
    color: #f4a98f;
  }
  .lab-out {
    width: fit-content;
    max-width: 100%;
    min-width: min(100%, 24rem);
    margin-top: 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    background: var(--color-bg);
    min-height: 4rem;
  }
  .lab-empty {
    padding: 1.25rem 1.25rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .lab-out :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .lab-out :global(th),
  .lab-out :global(td) {
    padding: 0.7rem 1.4rem 0.7rem 1.25rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 60%, transparent);
  }
  .lab-out :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .lab-out :global(th) {
    position: sticky;
    top: 0;
    padding-block: 0.8rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .lab-out :global(td) {
    color: var(--color-ink);
  }
  .lab-out :global(td:first-child) {
    color: var(--color-strong);
    font-weight: 600;
  }
  .lab-out :global(th.num),
  .lab-out :global(td.num) {
    text-align: right;
  }
  .lab-out :global(tbody tr:nth-child(even) td) {
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }
  .lab-out :global(tbody tr:hover td) {
    background: var(--color-accent-wash);
  }
  .lab-out :global(tr.row-in) {
    animation: lab-row 320ms ease-out both;
  }
  .lab-out :global(.lab-print) {
    margin: 0.75rem 0 0;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    white-space: pre-wrap;
    color: var(--color-ink);
  }
  @keyframes lab-row {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-out :global(tr.row-in) {
      animation: none;
    }
  }
</style>

<script>
  type Rows = Record<string, unknown>[];
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const PYODIDE = 'https://cdn.jsdelivr.net/pyodide/v0.26.4/full/';
  let pyReady: Promise<any> | null = null;
  const loadPy = () =>
    (pyReady ??= new Promise((resolve, reject) => {
      const el = document.createElement('script');
      el.src = PYODIDE + 'pyodide.js';
      el.onload = async () => {
        try {
          const py = await (window as any).loadPyodide({ indexURL: PYODIDE });
          await py.loadPackage('pandas');
          await py.runPythonAsync(`
import ast, io, json, contextlib
import pandas as pd

def _run(code):
    out = io.StringIO()
    shown = None
    with contextlib.redirect_stdout(out):
        tree = ast.parse(code)
        last = None
        if tree.body and isinstance(tree.body[-1], ast.Expr):
            last = ast.Expression(tree.body.pop().value)
        exec(compile(tree, '<code>', 'exec'), globals())
        if last is not None:
            shown = eval(compile(last, '<code>', 'eval'), globals())
    table = None
    total = 0
    if isinstance(shown, pd.Series):
        shown = shown.to_frame().reset_index() if shown.name is not None else shown.reset_index()
    if isinstance(shown, pd.DataFrame):
        table = shown.head(500).to_json(orient='records')
        total = len(shown)
    elif shown is not None:
        out.write(repr(shown) + chr(10))
    return json.dumps({'text': out.getvalue(), 'table': table, 'total': total})
`);
          resolve(py);
        } catch (e) {
          pyReady = null;
          reject(e);
        }
      };
      el.onerror = () => {
        pyReady = null;
        reject(new Error('Could not load Python. Check your connection and try again.'));
      };
      document.head.appendChild(el);
    }));

  document.querySelectorAll<HTMLElement>('[data-lab]').forEach((lab) => {
    const table = lab.dataset.table!;
    const editor = lab.querySelector<HTMLTextAreaElement>('[data-editor]')!;
    const out = lab.querySelector<HTMLElement>('[data-out]')!;
    const stat = lab.querySelector<HTMLElement>('[data-stat]')!;
    const runBtn = lab.querySelector<HTMLButtonElement>('[data-run]')!;
    const hint = lab.querySelector<HTMLElement>('[data-hint]')!;
    const modes = [...lab.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const chipBoxes = [...lab.querySelectorAll<HTMLElement>('[data-chips]')];
    const first = (m: string) => lab.querySelector<HTMLElement>(`[data-chips="${m}"] [data-code]`)!.dataset.code!;
    const drafts: Record<string, string> = { sql: editor.value, py: first('py') };
    let mode = 'sql';
    let db: any = null;
    let loading: Promise<any> | null = null;
    let rowsText = '';

    const data = () => (rowsText ? Promise.resolve(rowsText) : fetch(`/data/${table}.json`).then((r) => r.text()).then((t) => (rowsText = t)));

    const load = () =>
      (loading ??= (async () => {
        const [{ default: alasql }, text] = await Promise.all([import('alasql'), data()]);
        const rows = JSON.parse(text);
        alasql(`CREATE TABLE ${table}`);
        (alasql.tables as any)[table].data = rows;
        db = alasql;
        stat.textContent = `${rows.length.toLocaleString()} rows loaded`;
        return db;
      })());

    const file = lab.querySelector<HTMLElement>('[data-file]')!;
    const hl = lab.querySelector<HTMLElement>('[data-hl]')!;
    const SQLK = new Set('select from where group by order having limit offset as and or not in is null like between case when then else end distinct join left right inner outer on union all asc desc count sum avg min max round'.split(' '));
    const PYK = new Set('import from as def return if elif else for in while not and or is None True False lambda with try except class print'.split(' '));
    const paint = () => {
      const kw = mode === 'sql' ? SQLK : PYK;
      const re = mode === 'sql' ? /(--[^\n]*)|('(?:[^'\\]|\\.)*')|\b(\d+(?:\.\d+)?)\b|\b([A-Za-z_][A-Za-z0-9_]*)\b(\s*\()?/g : /(#[^\n]*)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|\b(\d+(?:\.\d+)?)\b|\b([A-Za-z_][A-Za-z0-9_]*)\b(\s*\()?/g;
      const src = editor.value;
      let outHtml = '';
      let at = 0;
      src.replace(re, (m: string, c: string, str: string, num: string, word: string, call: string, idx: number) => {
        outHtml += esc(src.slice(at, idx));
        at = idx + m.length;
        if (c) outHtml += `<span class="c">${esc(c)}</span>`;
        else if (str) outHtml += `<span class="s">${esc(str)}</span>`;
        else if (num) outHtml += `<span class="n">${esc(num)}</span>`;
        else if (kw.has(mode === 'sql' ? word.toLowerCase() : word)) outHtml += `<span class="k">${esc(word)}</span>${esc(call ?? '')}`;
        else if (call) outHtml += `<span class="f">${esc(word)}</span>${esc(call)}`;
        else outHtml += esc(word);
        return m;
      });
      outHtml += esc(src.slice(at));
      hl.innerHTML = outHtml + '\n';
      hl.parentElement!.scrollTop = editor.scrollTop;
      hl.parentElement!.scrollLeft = editor.scrollLeft;
      file.textContent = mode === 'sql' ? 'query.sql' : 'analysis.py';
    };

    const draw = (rows: Rows, total: number, ms: number) => {
      if (!rows.length) {
        out.innerHTML = '<p class="lab-empty">The code ran but returned no rows.</p>';
        stat.textContent = `0 rows in ${ms.toFixed(0)} ms`;
        return;
      }
      const cols = Object.keys(rows[0]);
      const shown = rows.slice(0, 10);
      const head = cols.map((c) => `<th scope="col"${typeof rows[0][c] === 'number' ? ' class="num"' : ''}>${esc(c)}</th>`).join('');
      const body = shown
        .map((r, i) => `<tr class="row-in" style="animation-delay:${i * 35}ms">${cols.map((c) => `<td${typeof r[c] === 'number' ? ' class="num"' : ''}>${esc(typeof r[c] === 'number' ? (Number.isInteger(r[c]) ? (r[c] as number).toLocaleString() : r[c]) : r[c])}</td>`).join('')}</tr>`)
        .join('');
      out.innerHTML = `<table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
      stat.classList.remove('is-error');
      stat.textContent = total > 10 ? `Showing 10 of ${total.toLocaleString()} rows, ${ms.toFixed(0)} ms` : `${total} row${total === 1 ? '' : 's'}, ${ms.toFixed(0)} ms`;
    };

    const runSql = async () => {
      const a = await load();
      const sql = editor.value.trim();
      if (!/^select\b/i.test(sql)) throw new Error('Only SELECT queries are allowed here.');
      const t0 = performance.now();
      const rows = a(sql) as Rows;
      const list = Array.isArray(rows) ? rows : [];
      draw(list, list.length, performance.now() - t0);
    };

    const runPy = async () => {
      stat.classList.remove('is-error');
      stat.textContent = pyReady ? 'Running...' : 'Loading Python and pandas (about 10 MB, first run only)...';
      const [py, text] = await Promise.all([loadPy(), data()]);
      py.globals.set('_rows_json', text);
      await py.runPythonAsync(`import json\ndf = pd.DataFrame(json.loads(_rows_json))\n${table} = df`);
      const t0 = performance.now();
      py.globals.set('_user_code', editor.value);
      const res = JSON.parse(await py.runPythonAsync('_run(_user_code)'));
      const ms = performance.now() - t0;
      if (res.table) {
        draw(JSON.parse(res.table), res.total, ms);
        if (res.text) out.insertAdjacentHTML('beforeend', `<pre class="lab-print">${esc(res.text)}</pre>`);
      } else {
        out.innerHTML = res.text ? `<pre class="lab-print">${esc(res.text)}</pre>` : '<p class="lab-empty">The code ran and printed nothing. End with an expression such as df.head() to see a table.</p>';
        stat.textContent = `done in ${ms.toFixed(0)} ms`;
      }
    };

    const run = async () => {
      runBtn.disabled = true;
      try {
        await (mode === 'sql' ? runSql() : runPy());
      } catch (e) {
        stat.classList.add('is-error');
        const m = String((e as any)?.message ?? e).trim().split('\n');
        stat.textContent = (m[m.length - 1] || 'Error').slice(0, 200);
      } finally {
        runBtn.disabled = false;
      }
    };

    const setMode = (m: string) => {
      drafts[mode] = editor.value;
      mode = m;
      modes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      chipBoxes.forEach((c) => (c.hidden = c.dataset.chips !== m));
      editor.value = drafts[m];
      paint();
      hint.textContent = m === 'sql' ? 'Ctrl + Enter' : 'Ctrl + Enter. Python loads on first run';
      stat.classList.remove('is-error');
    };
    modes.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode!)));

    runBtn.addEventListener('click', run);
    editor.addEventListener('input', paint);
    editor.addEventListener('scroll', () => {
      hl.parentElement!.scrollTop = editor.scrollTop;
      hl.parentElement!.scrollLeft = editor.scrollLeft;
    });
    paint();
    editor.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        run();
      }
    });
    lab.querySelectorAll<HTMLButtonElement>('[data-code]').forEach((chip) =>
      chip.addEventListener('click', () => {
        chip.parentElement!.querySelectorAll('[data-code]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        editor.value = chip.dataset.code!;
        paint();
        run();
      }),
    );
    new IntersectionObserver((es, io) => {
      if (es.some((e) => e.isIntersecting)) {
        io.disconnect();
        if (mode === 'sql') run();
      }
    }, { threshold: 0.2 }).observe(lab);
  });
</script>
