---
// The case study for one project. "In short" shows the question, what was built,
// and what it found at a glance; the full five-part write-up (problem, approach,
// stack, results, lessons) sits below in folded sections a reader can open.
import Icon from './Icon.astro';
import type { ProjectDetail } from '../data/details';
import { repoFile, type Project } from '../data/portfolio';

interface Props {
  project: Project;
  detail?: ProjectDetail;
}
const { project, detail } = Astro.props;
const kindLabel = { fact: 'Fact table', dim: 'Dimension', measures: 'Measures' } as const;
---

<div class="case">
  <section class="short" aria-labelledby="case-short">
    <h2 id="case-short" class="mono flex items-center gap-2"><span class="sq"></span>In short</h2>
    <div class="cells mt-5 lg:grid-cols-3">
      <div class="cell">
        <p class="mono">The question</p>
        <p class="q">{project.problem}</p>
      </div>
      <div class="cell">
        <p class="mono">What I built</p>
        <ol class="mt-4 space-y-2" aria-label="Pipeline">
          {
            project.architecture.map((node, i) => (
              <li class="flex items-center gap-3">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class:list={['flow', { last: i === project.architecture.length - 1 }]}>{node}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="cell">
        <p class="mono">What it found</p>
        <ul class="mt-4 space-y-3">
          {
            project.results.slice(0, 3).map((r) => (
              <li class="result">
                <Icon name="check" size={15} class="mt-1 shrink-0 text-accent-ink" />
                <span>{r}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
        {project.tags.map((t) => <li class="pill">{t}</li>)}
      </ul>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noopener" class="btn btn-primary" data-goatcounter-click={`repo-${project.slug}`}>
            <Icon name="github" size={16} />
            Repository
          </a>
        )
      }
      {
        project.repo &&
          project.pbix?.map((f) => (
            <a href={repoFile(project.repo, f.file)} class="btn btn-outline" data-goatcounter-click={`pbix-${project.slug}`}>
              <Icon name="download" size={16} />
              {f.label.replace(/ \(.*/, '')} (.pbix)
            </a>
          ))
      }
    </div>
  </section>

  <p class="mono full">Full case study // tap a section to open it</p>

  <details class="acc">
    <summary><span class="mono">01</span>Problem &amp; context<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      <p class="lead">{project.problem}</p>
      <p class="mt-5 max-w-[46rem] leading-relaxed text-ink">{project.why}</p>
      {project.context && <p class="note mt-5">{project.context}</p>}
      {
        detail && (
          <div class="mt-6 max-w-[46rem] space-y-3 leading-relaxed text-muted">
            {detail.overview.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )
      }
    </div>
  </details>

  <details class="acc">
    <summary><span class="mono">02</span>My role &amp; approach<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      <p class="font-medium text-strong">{project.role}</p>
      <ol class="mt-6 space-y-4">
        {
          project.approach.map((step, i) => (
            <li class="flex gap-4">
              <span class="num pt-0.5">{String(i + 1).padStart(2, '0')}</span>
              <p class="max-w-[46rem] leading-relaxed text-ink">{step}</p>
            </li>
          ))
        }
      </ol>
      <h3 class="mono mt-10">Hard parts I solved</h3>
      <ul class="dot-list mt-4 max-w-[46rem] space-y-3 leading-relaxed text-ink">
        {project.challenges.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </details>

  <details class="acc">
    <summary><span class="mono">03</span>Tech stack{detail?.model && <> &amp; data model</>}<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      {
        detail ? (
          <ul class="cells sm:grid-cols-2">
            {detail.tools.map((t) => (
              <li class="tool">
                <h3 class="font-semibold text-strong">{t.name}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.use}</p>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <li class="pill">{t}</li>
            ))}
          </ul>
        )
      }
      {
        detail?.model && (
          <>
            <h3 class="mono mt-10">Data model</h3>
            <p class="mt-3 max-w-[46rem] leading-relaxed text-ink">{detail.model.note}</p>
            <ul class="cells mt-5 sm:grid-cols-2">
              {detail.model.tables.map((t) => (
                <li class:list={['tool', { fact: t.kind === 'fact' }]}>
                  <p class="mono">{kindLabel[t.kind]}</p>
                  <h4 class="mt-1 font-mono text-sm font-semibold text-strong">{t.name}</h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.desc}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h3 class="mono mt-10">Skills shown</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.skills.map((s) => <li class="pill">{s}</li>)}
      </ul>
    </div>
  </details>

  <details class="acc">
    <summary><span class="mono">04</span>Results &amp; impact<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      <ul class="space-y-4">
        {
          project.results.map((r) => (
            <li class="result">
              <Icon name="check" size={16} class="mt-1 shrink-0 text-accent-ink" />
              <span>{r}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </details>

  {
    (project.learned || project.improve) && (
      <details class="acc">
        <summary>
          <span class="mono">05</span>What I learned &amp; would improve
          <Icon name="chevron-down" size={18} class="chev" />
        </summary>
        <div class="body grid gap-8 md:grid-cols-2 md:gap-10">
          {project.learned && (
            <div>
              <h3 class="mono">Lessons</h3>
              <ul class="dot-list mt-4 space-y-3 leading-relaxed text-ink">
                {project.learned.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </div>
          )}
          {project.improve && (
            <div>
              <h3 class="mono">What I would do next</h3>
              <ul class="mt-4 space-y-3 leading-relaxed text-ink">
                {project.improve.map((l) => (
                  <li class="flex gap-3">
                    <Icon name="arrow-right" size={15} class="mt-1.5 shrink-0 text-accent-ink" />
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </details>
    )
  }
</div>

<style>
  .short {
    padding: 1.75rem 1rem 2rem;
    border-bottom: 1px solid var(--color-line);
  }
  .cell {
    padding: 1.25rem 1.125rem 1.5rem;
  }
  .q {
    margin-top: 0.875rem;
    color: var(--color-strong);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.45;
  }
  .full {
    padding: 1.5rem 1rem 0.75rem;
  }
  .acc {
    border-bottom: 1px solid var(--color-line);
  }
  .acc summary {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 3.75rem;
    padding: 0.875rem 1rem;
    color: var(--color-strong);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms;
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc summary:hover {
    background: var(--color-surface);
  }
  .acc summary :global(.chev) {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform 250ms;
  }
  .acc[open] summary :global(.chev) {
    transform: rotate(180deg);
  }
  .acc[open] summary {
    box-shadow: inset 4px 0 0 var(--color-accent);
  }
  .body {
    min-width: 0;
    padding: 0.5rem 1rem 2.25rem;
  }
  @media (min-width: 768px) {
    .short {
      padding: 2.5rem 2.5rem 2.75rem;
    }
    .cell {
      padding: 1.5rem 1.5rem 1.75rem;
    }
    .full,
    .acc summary,
    .body {
      padding-inline: 2.5rem;
    }
    .acc summary {
      font-size: 1.1875rem;
    }
    .body {
      padding-bottom: 2.75rem;
    }
  }
  .lead {
    max-width: 46rem;
    color: var(--color-strong);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .note {
    max-width: 46rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-wash);
    color: var(--color-ink);
  }
  .num {
    flex-shrink: 0;
    width: 1.75rem;
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .flow {
    display: inline-block;
    padding: 0.4375rem 0.75rem;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .flow.last {
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
    color: var(--color-strong);
  }
  .tool {
    padding: 1.125rem 1.25rem;
  }
  .tool.fact {
    box-shadow: inset 3px 0 0 var(--color-accent);
  }
  .result {
    display: flex;
    gap: 0.625rem;
    max-width: 48rem;
    color: var(--color-strong);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
