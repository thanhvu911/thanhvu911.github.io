---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/portfolio';

const [first, second, ...rest] = projects;
---

<section id="work" class="container-page py-20 md:py-28" aria-labelledby="work-title">
  <SectionHeader
    id="work-title"
    eyebrow="Work"
    title="Selected work"
    description="Pipelines, warehouses, and BI models built on public and business data, each with the architecture, data model, and results."
    link={{ href: '/work', label: `All ${projects.length} projects` }}
  />
  <div class="mt-12 grid gap-x-6 gap-y-12 md:grid-cols-2">
    <ProjectCard project={first} size="lg" />
    <ProjectCard project={second} size="lg" />
  </div>
  <div class="mt-12 grid gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
    {rest.slice(0, 3).map((p) => <ProjectCard project={p} />)}
  </div>
</section>
