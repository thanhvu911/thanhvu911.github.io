---
import Icon from './Icon.astro';
---

<button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to dark theme">
  <Icon name="moon" size={18} class="theme-icon-moon" />
  <Icon name="sun" size={18} class="theme-icon-sun hidden" />
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    btn?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    btn?.querySelector('.theme-icon-moon')?.classList.toggle('hidden', dark);
    btn?.querySelector('.theme-icon-sun')?.classList.toggle('hidden', !dark);
  };

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
  sync();
</script>
