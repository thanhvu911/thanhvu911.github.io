---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { credentials, education, profile, research } from '../data/portfolio';

const gradResume = profile.resumes.find((r) => r.id === 'grad-school')!;
---

<Base
  title="Academics"
  description="Thanh Vu's research interests, coursework, and research projects, for M.S. Computer Science (AI) admissions, Fall 2027."
>
  <section class="section">
    <div class="container-page max-w-5xl">
      <h1 class="section-title">Academics</h1>
      <p class="section-lede">For admissions committees and faculty. {research.applying}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={gradResume.href} target="_blank" class="btn btn-primary" data-goatcounter-click="resume-grad-school">
          <Icon name="download" size={16} />
          Graduate school resume
        </a>
        <a href="/#contact" class="btn btn-outline">Contact me</a>
      </div>

      <div class="mt-14">
        <div class="cv-row">
          <h2 class="cv-label">Research interests</h2>
          <p class="serif text-2xl leading-snug text-ink">{research.interests}</p>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Education</h2>
          <div>
            <h3 class="text-xl font-semibold tracking-tight">{education.school}, {education.location}</h3>
            <p class="mt-1 text-muted">Bachelor of Arts in Computer Science, {education.date}</p>
            <p class="mt-3">GPA 3.72 overall, 3.82 in the major</p>
            <p class="mt-1 text-muted">Honors List, Fall 2021, 2023, 2024, and 2025. Dean's List, Spring 2022.</p>
          </div>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Coursework</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {
              research.coursework.map((g) => (
                <div>
                  <h3 class="font-semibold">{g.group}</h3>
                  <ul class="dot-list mt-2 space-y-1 text-ink/90">
                    {g.items.map((c) => <li>{c}</li>)}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Research and applied projects</h2>
          <ol class="space-y-8">
            {
              research.projects.map((p) => (
                <li>
                  <h3 class="text-lg font-semibold leading-snug tracking-tight">
                    {p.slug ? <a href={`/projects/${p.slug}`} class="hover:underline hover:underline-offset-4">{p.title}</a> : p.title}
                  </h3>
                  <p class="mt-0.5 text-sm text-muted">{p.meta}</p>
                  <ul class="dot-list mt-3 max-w-[44rem] space-y-2 leading-relaxed text-ink/90">
                    {p.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                  {p.slug && <a href={`/projects/${p.slug}`} class="text-link mt-3 inline-block text-[0.9375rem]">Read the case study</a>}
                </li>
              ))
            }
          </ol>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Certifications</h2>
          <ul class="space-y-2">
            {
              credentials.map((c) => (
                <li>
                  <span class="font-semibold">{c.title}</span>
                  <span class="block text-sm text-muted">{c.detail.split(' · ').slice(-2).join(', ')}{'note' in c && `. ${c.note}`}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Leadership</h2>
          <div>
            <h3 class="font-semibold">{research.leadership.title}</h3>
            <p class="text-sm text-muted">{research.leadership.meta}</p>
            <p class="mt-2 leading-relaxed text-ink/90">{research.leadership.detail}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cv-row {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 768px) {
    .cv-row {
      grid-template-columns: 13rem 1fr;
      gap: 2.5rem;
    }
  }
  .cv-label {
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.6;
  }
</style>
