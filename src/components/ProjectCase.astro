---
// The case study for one project. "In short" shows the question, what was built,
// and what it found at a glance; the full five-part write-up (problem, approach,
// stack, results, lessons) sits below in folded sections a reader can open.
import Icon from './Icon.astro';
import FlowSteps from './FlowSteps.astro';
import ResultBars from './ResultBars.astro';
import { sectionMotion, skillSteps } from '../data/sectionMotion';
import type { ProjectDetail } from '../data/details';
import { repoFile, type Project } from '../data/portfolio';

interface Props {
  project: Project;
  detail?: ProjectDetail;
}
const { project, detail } = Astro.props;
const motion = sectionMotion[project.slug];
const stepMap = skillSteps[project.slug] ?? {};
const stepSkills = project.architecture.map((_, i) => project.skills.filter((s) => stepMap[s] === i));
// "What it found" already shows the first three results; the folded section holds only the rest.
const moreResults = project.results.slice(3);
const learnNo = moreResults.length ? '05' : '04';
const kindLabel = { fact: 'Fact table', dim: 'Dimension', measures: 'Measures' } as const;
---

<div class="case">
  <section class="short" aria-labelledby="case-short">
    <h2 id="case-short" class="mono flex items-center gap-2"><span class="sq"></span>In short</h2>
    <div class="mt-10">
      <p class="mono">The question</p>
      <p class="q">{project.problem}</p>
    </div>
    <div class="cols">
      <div class="cell">
        <p class="mono">What I built</p>
        <FlowSteps steps={project.architecture} notes={motion?.flowNotes} skills={stepSkills} />
      </div>
      <div class="cell">
        <p class="mono">What it found</p>
        {motion?.bars && <ResultBars groups={motion.bars} />}
        <ul class="mt-4 space-y-4">
          {
            project.results.slice(0, 3).map((r) => (
              <li class="result">
                <Icon name="check" size={15} class="mt-1 shrink-0 text-accent-ink" />
                <span>{r}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
        {project.tags.map((t) => <li class="pill">{t}</li>)}
      </ul>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {
        project.repo && (
          <a href={project.repo} target="_blank" rel="noopener" class="btn btn-primary" data-goatcounter-click={`repo-${project.slug}`}>
            <Icon name="github" size={16} />
            Repository
          </a>
        )
      }
      {
        project.repo &&
          project.pbix?.map((f) => (
            <a href={repoFile(project.repo, f.file)} class="btn btn-outline" data-goatcounter-click={`pbix-${project.slug}`}>
              <Icon name="download" size={16} />
              {f.label.replace(/ \(.*/, '')} (.pbix)
            </a>
          ))
      }
    </div>
  </section>

  <p class="mono full">Full case study // tap a section to open it</p>

  <details class="acc">
    <summary><span class="mono">01</span>Problem &amp; context<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      <p class="lead">{project.problem}</p>
      <p class="mt-5 max-w-[46rem] leading-relaxed text-ink">{project.why}</p>
      {project.context && <p class="note mt-5">{project.context}</p>}
      {
        detail && (
          <div class="mt-6 max-w-[46rem] space-y-3 leading-relaxed text-muted">
            {detail.overview.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )
      }
    </div>
  </details>

  <details class="acc">
    <summary><span class="mono">02</span>My role &amp; approach<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      <p class="font-medium text-strong">{project.role}</p>
      <ol class="rv tl mt-6" data-inview>
        {
          project.approach.map((step, i) => (
            <li class="rv-i tl-i flex gap-4" style={`--k:${i}`}>
              <span class="num pt-0.5">{String(i + 1).padStart(2, '0')}</span>
              <p class="max-w-[46rem] leading-relaxed text-ink">{step}</p>
            </li>
          ))
        }
      </ol>
      <h3 class="mono mt-10">Problems I hit and how I handled them</h3>
      <ul class="rv dot-list mt-4 max-w-[46rem] space-y-3 leading-relaxed text-ink" data-inview>
        {project.challenges.map((c, i) => <li class="rv-i" style={`--k:${i}`}>{c}</li>)}
      </ul>
    </div>
  </details>

  <details class="acc">
    <summary><span class="mono">03</span>Tech stack{detail?.model && <> &amp; data model</>}<Icon name="chevron-down" size={18} class="chev" /></summary>
    <div class="body">
      {
        detail ? (
          <ul class="rv cells sm:grid-cols-2" data-inview>
            {detail.tools.map((t, i) => (
              <li class="tool rv-i glow" data-glow style={`--k:${i}`}>
                <h3 class="font-semibold text-strong">{t.name}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.use}</p>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <li class="pill">{t}</li>
            ))}
          </ul>
        )
      }
      {
        detail?.model && (
          <>
            <h3 class="mono mt-10">Data model</h3>
            <p class="mt-3 max-w-[46rem] leading-relaxed text-ink">{detail.model.note}</p>
            <ul class="rv cells mt-5 sm:grid-cols-2" data-inview>
              {detail.model.tables.map((t, i) => (
                <li class:list={['tool rv-i glow', { fact: t.kind === 'fact' }]} data-glow style={`--k:${i}`}>
                  <p class="mono">{kindLabel[t.kind]}</p>
                  <h4 class="mt-1 font-mono text-sm font-semibold text-strong">{t.name}</h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.desc}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h3 class="mono mt-10">Skills shown</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.skills.map((s) => <li class="pill">{s}</li>)}
      </ul>
    </div>
  </details>

  {
    moreResults.length > 0 && (
      <details class="acc" open>
        <summary><span class="mono">04</span>More results<Icon name="chevron-down" size={18} class="chev" /></summary>
        <div class="body">
          <ul class="rv space-y-4" data-inview>
            {moreResults.map((r, i) => (
              <li class="result rv-i" style={`--k:${i}`}>
                <Icon name="check" size={16} class="mt-1 shrink-0 text-accent-ink" />
                <span>{r}</span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    )
  }

  {
    (project.learned || project.improve) && (
      <details class="acc">
        <summary>
          <span class="mono">{learnNo}</span>What I learned &amp; would improve
          <Icon name="chevron-down" size={18} class="chev" />
        </summary>
        <div class="body grid gap-8 md:grid-cols-2 md:gap-10">
          {project.learned && (
            <div>
              <h3 class="mono">Lessons</h3>
              <ul class="rv dot-list mt-4 space-y-3 leading-relaxed text-ink" data-inview>
                {project.learned.map((l, i) => (
                  <li class="rv-i" style={`--k:${i}`}>{l}</li>
                ))}
              </ul>
            </div>
          )}
          {project.improve && (
            <div>
              <h3 class="mono">What I would do next</h3>
              <ul class="rv mt-4 space-y-3 leading-relaxed text-ink" data-inview>
                {project.improve.map((l, i) => (
                  <li class="rv-i flex gap-3" style={`--k:${i}`}>
                    <Icon name="arrow-right" size={15} class="mt-1.5 shrink-0 text-accent-ink" />
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </details>
    )
  }
</div>

<style>
  .short {
    padding: 2.5rem 1rem 3rem;
    border-bottom: 1px solid var(--color-line);
  }
  .cols {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }
  .cell {
    min-width: 0;
  }
  .q {
    max-width: 48rem;
    margin-top: 1rem;
    color: var(--color-strong);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .full {
    padding: 1.5rem 1rem 0.75rem;
  }
  .acc {
    border-bottom: 1px solid var(--color-line);
  }
  .acc summary {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 4.75rem;
    padding: 1.1rem 1rem;
    color: var(--color-strong);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms;
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc summary:hover {
    background: var(--color-surface);
  }
  .acc summary :global(.chev) {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform 250ms;
  }
  .acc[open] summary :global(.chev) {
    transform: rotate(180deg);
  }
  .acc[open] summary {
    box-shadow: inset 4px 0 0 var(--color-accent);
  }
  .body {
    min-width: 0;
    padding: 0.75rem 1rem 3rem;
  }
  @media (min-width: 1024px) {
    .cols {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 5rem;
    }
  }
  @media (min-width: 768px) {
    .short {
      padding: 4rem 2.5rem 4.5rem;
    }
    .full,
    .acc summary,
    .body {
      padding-inline: 2.5rem;
    }
    .acc summary {
      font-size: 1.1875rem;
    }
    .body {
      padding-top: 1rem;
      padding-bottom: 4rem;
    }
  }
  .lead {
    max-width: 46rem;
    color: var(--color-strong);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .note {
    max-width: 46rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-wash);
    color: var(--color-ink);
  }
  .num {
    flex-shrink: 0;
    width: 1.75rem;
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .flow {
    display: inline-block;
    padding: 0.4375rem 0.75rem;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .flow.last {
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
    color: var(--color-strong);
  }
  .tool {
    padding: 1.125rem 1.25rem;
  }
  /* Folded sections: items rise in one after another when the section is opened or scrolled to. */
  .rv-i {
    transition:
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--k) * 80ms),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--k) * 80ms);
  }
  :global(.js) .rv:not(.is-in) .rv-i {
    opacity: 0;
    transform: translateY(10px);
  }
  /* the approach as a timeline: a gold line draws from step to step */
  .tl-i {
    position: relative;
    padding-bottom: 1.1rem;
  }
  .tl-i:not(:last-child)::before,
  .tl-i:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    top: 1.75rem;
    bottom: 0.2rem;
    width: 2px;
  }
  .tl-i:not(:last-child)::before {
    background: var(--color-line);
  }
  .tl-i:not(:last-child)::after {
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(1);
    transition: transform 460ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--k) * 80ms + 240ms);
  }
  :global(.js) .tl:not(.is-in) .tl-i::after {
    transform: scaleY(0);
  }
  /* cards: a faint gold highlight follows the cursor */
  .glow {
    position: relative;
  }
  .glow::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(180px circle at var(--mx, 50%) var(--my, 50%), var(--color-accent-wash), transparent 70%);
    opacity: 0;
    transition: opacity 300ms;
    pointer-events: none;
  }
  .glow:hover::before {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-i,
    .tl-i::after,
    .glow::before {
      transition: none !important;
    }
  }
  .tool.fact {
    box-shadow: inset 3px 0 0 var(--color-accent);
  }
  .result {
    display: flex;
    gap: 0.625rem;
    max-width: 48rem;
    color: var(--color-strong);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>

<script>
  import { watchInView, glowCards } from '../lib/inview';
  watchInView();
  glowCards();
</script>
