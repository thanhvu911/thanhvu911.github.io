---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/photo/thanh-portrait.jpg';
import { credentials, education, experience, profile, projects, skills } from '../data/portfolio';

// Six projects, one strength each: pipelines, warehousing, ML evaluation, BI, statistics, reporting.
const featuredOrder = ['can-mail-data-predict-housing-vacancy', 'grocery-transaction-data-warehouse', 'vacancy-nowcast-ml', 'sales-planning-analysis', 'medical-cost-regression', 'lancaster-economic-indicators-dashboard'];
const featured = featuredOrder.map((slug) => projects.find((p) => p.slug === slug)!).filter(Boolean);
const facts = [
  { label: 'Now', value: 'Data Analyst Fellow, EDC Lancaster County' },
  { label: 'Education', value: `${education.degree}, ${education.school}, ${education.honorsShort}` },
  { label: 'Certified', value: 'Fabric Data Engineer Associate (DP-700)' },
  { label: 'Based in', value: profile.location },
];
---

<Base>
  <!-- Hero and About share a scroll stage: on laptops the page holds while the
       accent band sweeps across, the hero pans out left, and About pans in. -->
  <div class="stage" data-stage>
  <div class="stage-pin">
  <!-- Hero: a measured grid with my name, my photo, and my role. -->
  <section id="home" class="border-b border-line">
    <div class="frame hero">
      <p class="h-blurb rise" style="--d:0">
        <span class="sq mb-5 hidden lg:block"></span>
        <span class="lg:hidden">Pipelines, warehouses, Power BI. Data Analyst Fellow at EDC Lancaster County.</span>
        <span class="hidden lg:inline">Data engineer and analyst in Lancaster, PA. I build data pipelines, warehouses, and Power BI reports. At EDC Lancaster County I turn federal data (BLS, BEA) into star-schema dashboards that refresh daily. I also test machine-learning models against simple baselines; in one project, last year’s value matched or beat all eight models I compared.</span>
      </p>
      <h1 class="h-name display" aria-label="Thanh Vu">
        <span class="line"><span style="--d:1">Thanh</span></span>
        <span class="line"><span style="--d:2">Vu</span></span>
      </h1>
      <p class="h-lab1 mono rise" style="--d:3">Source //<br />BLS · BEA<br />Census · USPS</p>
      <!-- The pipeline at work: records flow from raw files through the
           Bronze, Silver, and Gold layers into a Power BI chart. -->
      <div class="h-band" aria-hidden="true">
        <div class="pipe">
          <span class="pipe-track">{[-7, 5, -3, 8, -6, 2, 7, -4].map((y, i) => <span class="pkt" style={`--i:${i};--jy:${y}px`}></span>)}</span>
          <ol class="pipe-nodes">
            <li><span class="pn pn-raw"></span><span class="pl mono">Raw</span></li>
            <li><span class="pn pn-bronze"></span><span class="pl mono">Bronze</span></li>
            <li><span class="pn pn-silver"></span><span class="pl mono">Silver</span></li>
            <li><span class="pn pn-gold"></span><span class="pl mono">Gold</span></li>
            <li><span class="pn pn-bi"><i></i><i></i><i></i><i></i></span><span class="pl mono">Power BI</span></li>
          </ol>
        </div>
      </div>
      <figure class="h-photo">
        <div class="frame-img">
          <Image
            src={portrait}
            alt="Portrait of Thanh Vu"
            widths={[360, 520, 720, 960]}
            sizes="(min-width: 1024px) 28vw, 92vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover object-[50%_22%]"
          />
        </div>
        <figcaption class="mono mt-2.5">Lancaster, PA</figcaption>
      </figure>
      <p class="h-role display rise" style="--d:3">Data engineer<br /><span class="text-accent-ink">&amp; analyst</span></p>
      <p class="h-lab2 mono rise" style="--d:4"><span class="sq mb-4 block"></span>131M-row warehouse<br />// SQL Server, synthetic retail data</p>
      <a href="#projects" class="h-go go">
        <span class="arr"><Icon name="arrow-right" size={24} /></span>
        <span class="lbl">See my work</span>
      </a>
      <div class="h-strip">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <li><a href={profile.github} target="_blank" rel="noopener" class="soc" data-goatcounter-click="hero-github">GitHub <Icon name="arrow-up-right" size={13} /></a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener" class="soc" data-goatcounter-click="hero-linkedin">LinkedIn <Icon name="arrow-up-right" size={13} /></a></li>
          <li><a href={`mailto:${profile.email}`} class="soc" data-goatcounter-click="hero-email">Email <Icon name="arrow-up-right" size={13} /></a></li>
          <li><a href="/resume" class="soc">Resume <Icon name="arrow-up-right" size={13} /></a></li>
        </ul>
        <a href="#about" class="mono hidden items-center gap-2 hover:text-strong lg:inline-flex">Scroll <Icon name="arrow-down" size={14} class="cue" /></a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">02 // About</span></p>
        <h2 class="ttl section-title" data-reveal>About me</h2>
      </div>
      <div class="about">
        <dl class="facts">
          {
            facts.map((f) => (
              <div data-reveal>
                <dt class="mono">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="about-txt" data-reveal>
          <p>
            At EDC Lancaster County I turn federal data from <mark>BLS, BEA, Census, and USPS</mark> into Power BI reports that refresh every day, so staff can brief officials and investors without rebuilding a spreadsheet first.
          </p>
          <p>
            In personal projects I build the same way: land raw data once, clean it, test it, model it. Projects include a <mark>131M-row SQL Server warehouse</mark> and a Fabric pipeline. USPS and Census vacancy rates correlate at 0.77 across six counties but at −0.01 in one, so I report results county by county.
          </p>
        </div>
      </div>
    </div>
  </section>
  </div>
  </div>

  <!-- Selected work -->
  <section id="projects" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">03 // Selected work<br />{projects.length} projects in total</span></p>
        <h2 class="ttl section-title" data-reveal>Selected work</h2>
      </div>
      <p class="mono px-4 py-4 text-[0.78rem] leading-relaxed text-muted md:px-10">I choose the questions and the tests, and use AI tools the way a good engineer uses a code reviewer: to extend my skills and catch edge cases.</p>
      <div class="cells md:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((p, i) => (
            <div>
              <ProjectCard project={p} position={i + 1} />
            </div>
          ))
        }
      </div>
      <a href="/projects" class="go border-t border-line">
        <span class="arr"><Icon name="arrow-right" size={24} /></span>
        <span class="lbl">See all {projects.length} projects</span>
      </a>
    </div>
  </section>

  <!-- Skills, each group backed by a project -->
  <section id="skills" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">04 // Skills<br />Each group links to proof</span></p>
        <h2 class="ttl section-title" data-reveal>Skills</h2>
      </div>
      <ul class="cells sm:grid-cols-2 lg:grid-cols-5">
        {
          skills.map((g, n) => (
            <li class="skill" data-reveal style={`--reveal-delay:${n * 70}ms`}>
              <span class="mono">0{n + 1}</span>
              <h3 class="display-md mt-4 text-lg">{g.group}</h3>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {g.items.map((i) => (
                  <li class="pill">{i}</li>
                ))}
              </ul>
              <a href={g.proof.href} class="proof">
                <span class="mono">Seen in</span>
                <span class="flex items-center gap-1.5">{g.proof.label} <Icon name="arrow-right" size={13} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Experience and education -->
  <section id="experience" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">05 // Experience</span></p>
        <h2 class="ttl section-title" data-reveal>Experience</h2>
      </div>
      <ol>
        {
          experience.map((job) => (
            <li class:list={['job', { 'is-now': 'current' in job && job.current }]} data-reveal>
              <p class="job-when mono">
                {job.dates}
                <br />
                {job.location}
              </p>
              <div class="job-what">
                <h3 class="display-md text-[1.375rem] md:text-[1.625rem]">{job.role}</h3>
                <p class="mt-1 font-medium text-strong">{job.company}</p>
                <p class="mt-2 max-w-[38rem] leading-relaxed text-muted">{job.bullets[0]}</p>
              </div>
              <ul class="job-tags flex flex-wrap content-start gap-1.5" aria-label="Tools used">
                {job.tech.map((t) => (
                  <li class="pill">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <div id="education" class="cells md:grid-cols-3">
        <div class="edu" data-reveal>
          <p class="mono">Education</p>
          <h3 class="display-md mt-4 text-xl">{education.school}</h3>
          <p class="mt-2 text-muted">{education.degree}, {education.date}. {education.gpa.replace(' · ', ', ')}. {education.honorsShort}.</p>
          <a href="/academics" class="text-link mt-4 inline-block text-[0.9375rem]">Coursework and projects</a>
        </div>
        {
          credentials.map((c) => (
            <div class="edu" data-reveal>
              <p class="mono">Certification</p>
              <h3 class="display-md mt-4 text-xl">{c.title.replace('Microsoft Certified: ', '')}</h3>
              <p class="mt-2 text-muted">{c.detail.split(' · ').reverse().slice(0, 2).reverse().join(', ')}</p>
              {'note' in c && <p class="mono mt-3">{c.note}</p>}
            </div>
          ))
        }
      </div>
      <a href="/resume" class="go border-t border-line">
        <span class="arr"><Icon name="arrow-right" size={24} /></span>
        <span class="lbl">View full resume</span>
      </a>
    </div>
  </section>

  <div class="frame">
    <ContactSection />
  </div>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'blurb' 'name' 'photo' 'role' 'lab1' 'go' 'strip';
  }
  .h-blurb {
    grid-area: blurb;
    max-width: 22rem;
    padding: 2rem 1rem 0;
    color: var(--color-strong);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .h-name {
    grid-area: name;
    padding: 1.75rem 1rem 2rem;
    font-size: clamp(3.5rem, 17.5vw, 9.75rem);
  }
  .h-name .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .h-name .line > span {
    display: block;
    animation: up 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--d) * 110ms);
  }
  .h-lab1 {
    grid-area: lab1;
    display: none;
  }
  .h-band {
    grid-area: band;
    height: 4.75rem;
    padding: 0 1rem 1rem;
  }
  .h-photo {
    grid-area: photo;
    padding: 0 1rem 1.75rem;
  }
  .frame-img {
    aspect-ratio: 1 / 1.04;
    overflow: hidden;
    border: 1px solid var(--color-strong);
    background: var(--color-surface);
    animation: wipe 1200ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
  }
  .frame-img :global(img) {
    animation: settle 1800ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
  }
  .h-role {
    grid-area: role;
    padding: 1.75rem 1rem 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-strong);
    font-size: clamp(2rem, 8.5vw, 6rem);
  }
  .h-lab2 {
    grid-area: lab2;
    display: none;
  }
  .h-go {
    grid-area: go;
    border-top: 1px solid var(--color-line);
  }
  .h-strip {
    grid-area: strip;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1rem;
    border-top: 1px solid var(--color-line);
  }
  .soc {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    color: var(--color-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .soc:hover {
    color: var(--color-accent-ink);
  }
  .cue {
    animation: nudge 2.4s ease-in-out infinite;
  }

  @media (min-width: 640px) {
    .h-photo {
      max-width: 32rem;
    }
    .h-name,
    .h-role,
    .h-blurb,
    .h-photo,
    .h-strip {
      padding-inline: 2.5rem;
    }
  }

  /* Phones and tablets: name with a small photo beside it, then the role,
     a one-line blurb, and the button, all on the first screen. */
  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name photo' 'role role' 'band band' 'blurb blurb' 'go go' 'strip strip';
    }
    .h-name {
      align-self: center;
      padding: 1.75rem 0.75rem 1.5rem 1rem;
      /* "THANH" is about 4.6em wide; leave room for the photo column. */
      font-size: calc((73vw - 3rem) / 4.75);
    }
    .h-photo {
      align-self: center;
      width: calc(27vw + 1rem);
      max-width: 13rem;
      padding: 1.75rem 1rem 1.5rem 0;
    }
    .h-photo figcaption {
      display: none;
    }
    .h-role {
      padding-block: 1.25rem;
    }
    .h-blurb {
      max-width: none;
      padding: 0 1rem 1.5rem;
      color: var(--color-muted);
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .h-name {
      padding-left: 2.5rem;
      font-size: calc((73vw - 6rem) / 4.75);
    }
    .h-photo {
      width: calc(27vw + 2.5rem);
      max-width: 14.5rem;
      padding-right: 2.5rem;
    }
    .h-blurb,
    .h-band {
      padding-inline: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 30% 1fr 15%;
      /* Sized by height too, so the whole hero fits one screen. */
      grid-template-rows: auto clamp(6rem, 14svh, 8.5rem) 1fr auto;
      grid-template-areas:
        'blurb name  lab1'
        'photo band  band'
        'photo role  lab2'
        'go    strip strip';
      min-height: min(calc(100svh - 4.5rem), 62rem);
    }
    .hero > * {
      min-width: 0;
    }
    .h-blurb {
      max-width: none;
      padding: clamp(2.5rem, 7svh, 5rem) 2.5rem 2rem;
      border-right: 1px solid var(--color-line);
      border-bottom: 1px solid var(--color-line);
    }
    .h-blurb {
      padding-right: 3.5rem;
    }
    .h-name {
      align-self: stretch;
      padding: clamp(2rem, 5svh, 3.5rem) 2.5rem clamp(1.75rem, 4svh, 3rem);
      border-bottom: 1px solid var(--color-line);
      font-size: min(calc((55vw - 5rem) / 5.2), 9.5rem, 14svh);
    }
    .h-lab1 {
      display: block;
      padding: 2.75rem 1.5rem;
      border-left: 1px solid var(--color-line);
      border-bottom: 1px solid var(--color-line);
    }
    /* A hatched band between the name and the role, drawn in on load. */
    .h-band {
      position: relative;
      height: auto;
      padding: 0 2.5rem 0 clamp(4.5rem, 9vw, 9rem);
      border-bottom: 1px solid var(--color-line);
      background:
        repeating-linear-gradient(0deg, transparent 0 calc(2.125rem - 1px), var(--color-line) calc(2.125rem - 1px) 2.125rem),
        repeating-linear-gradient(-58deg, transparent 0 3.5rem, var(--color-line) 3.5rem calc(3.5rem + 1px));
      animation: draw 1400ms cubic-bezier(0.65, 0, 0.35, 1) 500ms both;
    }
    .h-photo {
      position: relative;
      z-index: 1;
      align-self: start;
      max-width: none;
      margin-right: clamp(-6rem, -5vw, -3rem);
      padding: 2rem 0 2.25rem clamp(2.5rem, 7.5vw, 7rem);
      border-right: 1px solid var(--color-line);
    }
    .h-photo .frame-img {
      width: min(100%, 30svh);
    }
    .h-photo,
    .h-go {
      border-right: 1px solid var(--color-line);
    }
    .h-photo {
      border-right: 0;
    }
    .h-role {
      align-self: end;
      padding: clamp(1.5rem, 3.5svh, 2.5rem) 1.5rem clamp(1.75rem, 4svh, 2.75rem) clamp(4.5rem, 9vw, 9rem);
      border-top: 0;
      /* "Data engineer" (about 10.2em) stays on one line. */
      font-size: clamp(2.5rem, min((min(100vw, 90rem) * 0.55 - clamp(4.5rem, 9vw, 9rem) - 1.5rem) / 10.6, 8svh), 5.75rem);
    }
    .h-lab2 {
      display: block;
      align-self: end;
      padding: 2rem 1.5rem 2.75rem;
      border-left: 1px solid var(--color-line);
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
    .h-strip {
      padding-inline: 2.5rem;
    }
    /* The column rule under the photo. */
    .hero {
      background: linear-gradient(var(--color-line), var(--color-line)) no-repeat 30% 0 / 1px 100%;
    }
  }

  .rise {
    animation: rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--d) * 110ms);
  }
  @keyframes up {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.12);
    }
  }
  @keyframes draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* ---------- Pipeline strip ----------
     Records (small squares) leave the raw files scattered, line up at Bronze,
     darken through Silver, turn orange at Gold, and feed the Power BI bars.
     Transform-only CSS animation, so it runs at the display's frame rate. */
  .pipe {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    overflow: clip;
  }
  .pipe-track {
    position: absolute;
    top: 50%;
    left: 1.75rem;
    right: 1.75rem;
    height: 1px;
    background: var(--color-line);
  }
  .pkt {
    position: absolute;
    inset: 0;
    animation: flow 4.8s linear infinite;
    animation-delay: calc(var(--i) * -0.6s);
  }
  .pkt::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    width: 8px;
    height: 8px;
    background: #a8a29a;
    animation: tint 4.8s linear infinite;
    animation-delay: inherit;
  }
  .pipe-nodes {
    position: relative;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .pipe-nodes li {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
  }
  .pn {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--color-strong);
    background: var(--color-bg);
  }
  .pn-raw {
    border-style: dashed;
    border-color: var(--color-muted);
  }
  .pn-bronze {
    background: repeating-linear-gradient(-55deg, var(--color-bg) 0 3px, var(--color-muted) 3px 4px);
  }
  .pn-silver {
    background: var(--color-muted);
  }
  .pn-gold {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .pn-bi {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    padding: 3px;
  }
  .pn-bi i {
    flex: 1;
    height: 100%;
    background: var(--color-strong);
    transform-origin: bottom;
    animation: bars 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .pn-bi i:nth-child(2) {
    background: var(--color-accent);
    animation-delay: -0.6s;
  }
  .pn-bi i:nth-child(3) {
    animation-delay: -1.2s;
  }
  .pn-bi i:nth-child(4) {
    background: var(--color-accent);
    animation-delay: -1.8s;
  }
  .pl {
    position: absolute;
    top: calc(100% + 0.375rem);
    padding-inline: 0.25rem;
    background: var(--color-bg);
    font-size: 0.625rem;
    white-space: nowrap;
  }
  @keyframes flow {
    to {
      transform: translateX(100%);
    }
  }
  @keyframes tint {
    0% {
      opacity: 0;
      transform: translateY(var(--jy));
    }
    5% {
      opacity: 1;
    }
    21% {
      transform: none;
    }
    25% {
      background: #a8a29a;
    }
    25.1%,
    50% {
      background: var(--color-muted);
    }
    50.1%,
    75% {
      background: var(--color-strong);
    }
    75.1% {
      background: var(--color-accent);
    }
    95% {
      opacity: 1;
      transform: none;
      background: var(--color-accent);
    }
    100% {
      opacity: 0;
      transform: scale(0.3);
      background: var(--color-accent);
    }
  }
  @keyframes bars {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pkt,
    .pkt::before,
    .pn-bi i {
      animation-play-state: paused;
    }
  }

  /* ---------- Scroll stage (laptops, set by the script below) ----------
     The pin holds for 135vh of scrolling. About sits on top of the hero:
     its text above the band row, its title in the band row (lined up with
     the hero's pipeline strip), and its facts below. */
  .stage.staged {
    height: calc(100svh - 4.5rem + 135vh);
  }
  .staged .stage-pin {
    position: sticky;
    top: 4.5rem;
    height: calc(100svh - 4.5rem);
    overflow: hidden;
  }
  .staged #home {
    border-bottom: 0;
  }
  .staged #about {
    position: absolute;
    inset: 0;
    border-bottom: 0;
  }
  .staged #about > .frame {
    display: grid;
    grid-template-columns: 30% minmax(0, 1fr);
    grid-template-rows: var(--band-y) var(--band-h) minmax(0, 1fr);
    height: 100%;
  }
  .staged #about .shead,
  .staged #about .about {
    display: contents;
  }
  .staged #about [data-reveal] {
    opacity: 1;
    transition: none;
  }
  .staged #about .idx {
    grid-area: 1 / 1;
    align-self: end;
    padding: 0 2.5rem 1.75rem;
    border: 0;
  }
  .staged #about .about-txt {
    grid-area: 1 / 2;
    align-self: end;
    padding: 0 2.5rem 1.75rem;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
  }
  .staged #about .ttl {
    --tpt: 0px;
    --tpb: 0px;
    grid-area: 2 / 2;
    align-self: center;
    padding: 0 2.5rem;
  }
  .staged #about .facts {
    grid-area: 3 / 1 / 4 / 3;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-content: start;
    padding: 2rem 2.5rem;
    border: 0;
    border-top: 1px solid var(--color-line);
  }
  .staged #about .idx,
  .staged #about .about-txt,
  .staged #about .facts {
    will-change: transform;
  }
  .staged #about > .frame::before {
    content: '';
    grid-area: 2 / 1 / 3 / 3;
    border-top: 1px solid var(--color-line);
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
  }
  .facts {
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .facts dd {
    margin-top: 0.125rem;
    color: var(--color-strong);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .about-txt {
    padding: 2rem 1rem 2.5rem;
    color: var(--color-ink);
    font-size: 1.1875rem;
    line-height: 1.6;
  }
  .about-txt p + p {
    margin-top: 1.25rem;
  }
  .about-txt mark {
    background: linear-gradient(transparent 60%, rgb(201 154 69 / 0.3) 0);
    color: var(--color-strong);
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .facts,
    .about-txt {
      padding-inline: 2.5rem;
    }
    .about-txt {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .about {
      grid-template-columns: 30% 1fr;
    }
    .facts {
      align-content: start;
      gap: 1.5rem;
      padding-block: 2.5rem;
      border-right: 1px solid var(--color-line);
      border-bottom: 0;
    }
    .about-txt {
      max-width: 58rem;
      padding-block: 1.25rem 1.25rem;
      font-size: 1.2rem;
    }
  }
  /* ---------- Skills ---------- */
  .skill {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1rem 1.5rem;
    transition: background-color 250ms;
  }
  .skill:hover {
    background: var(--color-surface);
  }
  @media (min-width: 768px) {
    .skill {
      padding: 2rem 1.75rem 1.75rem;
    }
  }
  .proof {
    display: grid;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: 1.75rem;
    color: var(--color-strong);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .proof:hover {
    color: var(--color-accent-ink);
  }

  /* ---------- Experience ---------- */
  .job {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    border-bottom: 1px solid var(--color-line);
    transition: background-color 250ms;
  }
  .job:hover {
    background: var(--color-surface);
  }
  .job.is-now {
    background: var(--color-surface);
    box-shadow: inset 4px 0 0 var(--color-accent);
  }
  @media (min-width: 768px) {
    .job {
      grid-template-columns: 13rem 1fr;
      padding-inline: 2.5rem;
    }
    .job-tags {
      grid-column: 2;
    }
  }
  @media (min-width: 1024px) {
    .job {
      grid-template-columns: 30% minmax(0, 1fr) clamp(13rem, 20vw, 18rem);
      gap: 0;
      padding: 0;
    }
    .job > * {
      min-width: 0;
      padding: 1.875rem 2.5rem;
    }
    .job-when {
      align-self: stretch;
      border-right: 1px solid var(--color-line);
    }
    .job-tags {
      grid-column: auto;
      padding-left: 0;
    }
  }
  .edu {
    padding: 1.75rem 1rem 2rem;
  }
  @media (min-width: 768px) {
    .edu {
      padding: 2rem 2.5rem 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-name .line > span,
    .rise,
    .frame-img,
    .frame-img :global(img),
    .h-band,
    .cue {
      animation: none;
    }
  }
</style>

<script>
  // Scroll stage (laptops): while the hero is pinned, the accent band grows
  // across its middle row, the hero pans out left as About pans in, "About me"
  // scrambles in over the band, and the band pulls back, leaving hatch marks.
  // Everything follows the scroll position, so scrolling up plays it backwards.
  // Phones and reduced motion get the normal page, where the About title
  // animates like every other section title.
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const pin = stage.firstElementChild as HTMLElement;
  const hero = pin.querySelector<HTMLElement>('#home')!;
  const about = pin.querySelector<HTMLElement>('#about')!;
  const aboutTxt = about.querySelector<HTMLElement>('.about-txt')!;
  // Height the About text needs (its cell may be stretched taller by the facts column).
  const aboutNeed = () => {
    const last = aboutTxt.lastElementChild as HTMLElement;
    return last.offsetTop + last.offsetHeight + parseFloat(getComputedStyle(aboutTxt).paddingBottom);
  };
  const strip = hero.querySelector<HTMLElement>('.h-band')!;
  const title = pin.querySelector<HTMLElement>('#about .section-title')!;
  const panIn = [...pin.querySelectorAll<HTMLElement>('#about .idx, #about .about-txt, #about .facts')];
  const wide = matchMedia('(min-width: 1024px) and (min-height: 720px) and (prefers-reduced-motion: no-preference)');

  const band = document.createElement('span');
  band.className = 'band';
  band.setAttribute('aria-hidden', 'true');
  band.innerHTML = '<span class="band-run"><i></i><i></i><i></i><i></i><i></i></span>';
  const run = band.firstElementChild as HTMLElement;

  const glyphs = 'ABCDEFGHKNOPRSTUVXYZ0123456789/#';
  const label = title.textContent?.trim() ?? '';
  const walker = document.createTreeWalker(title, NodeFilter.SHOW_TEXT);
  const nodes: { node: Text; text: string }[] = [];
  while (walker.nextNode()) nodes.push({ node: walker.currentNode as Text, text: walker.currentNode.nodeValue ?? '' });
  const total = nodes.reduce((n, t) => n + t.text.length, 0);
  // Letters left of share s are settled; the rest show random glyphs.
  const letters = (s: number) => {
    let i = 0;
    for (const n of nodes) {
      n.node.nodeValue = s >= 1 ? n.text : [...n.text].map((ch) => (ch.trim() === '' || i++ / total < s ? ch : glyphs[(Math.random() * glyphs.length) | 0])).join('');
    }
    title.classList.toggle('is-visible', s > 0);
  };

  const inOut = (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2);
  const clamp = (x: number) => Math.min(Math.max(x, 0), 1);
  const seg = (p: number, a: number, b: number) => inOut(clamp((p - a) / (b - a)));

  let on = false;
  let raf = 0;
  let lastS = -1;
  let W = 0, h = 0, runW = 0, mid = 0, peak = 0, dist = 1, top = 0;

  const measure = () => {
    hero.style.transform = '';
    const pr = pin.getBoundingClientRect();
    const sr = strip.getBoundingClientRect();
    stage.style.setProperty('--band-y', `${sr.top - pr.top}px`);
    stage.style.setProperty('--band-h', `${sr.height}px`);
    band.style.top = `${sr.top - pr.top}px`;
    band.style.height = `${sr.height}px`;
    W = pin.clientWidth;
    h = sr.height;
    runW = run.offsetWidth;
    dist = Math.max(stage.offsetHeight - pin.offsetHeight, 1);
    top = parseFloat(getComputedStyle(pin).top) || 0;
    letters(1);
    const range = document.createRange();
    range.selectNodeContents(title);
    const tr = range.getBoundingClientRect();
    mid = 0.42 * W;
    peak = Math.min(tr.left - pr.left + tr.width * 0.55 + 2.2 * h, W + 2.6 * h);
    lastS = -1;
  };

  // The stage chases the scroll position with easing instead of tracking it
  // one-to-one, so a flick of the wheel glides rather than jumps.
  let cur = -1;
  let lastT = 0;
  const update = (now = performance.now()) => {
    raf = 0;
    const dt = Math.min(now - lastT || 16.7, 64);
    lastT = now;
    const target = clamp((top - stage.getBoundingClientRect().top) / dist);
    // Time-based easing, so the glide feels the same at 60, 120, or 144 fps.
    cur = cur < 0 ? target : cur + (target - cur) * (1 - Math.exp(-dt / 85));
    if (Math.abs(target - cur) < 0.0005) cur = target;
    const p = cur;
    if (cur !== target) raf = requestAnimationFrame(update);
    const out = -0.4 * h;
    const front = p < 0.66 ? out + (mid - out) * seg(p, 0, 0.32) + (peak - mid) * seg(p, 0.3, 0.58) : peak + (out - peak) * seg(p, 0.66, 0.94);
    run.style.transform = `translateX(${front - runW}px)`;
    const q = seg(p, 0.16, 0.56);
    hero.style.transform = q ? `translateX(${-q * W}px)` : '';
    hero.inert = q > 0.5;
    panIn.forEach((el) => (el.style.transform = `translateX(${(1 - q) * W}px)`));
    const s = clamp((p - 0.36) / 0.34);
    if (s !== lastS) letters(s);
    lastS = s;
    title.classList.toggle('is-hatched', p > 0.84);
  };
  const onScroll = () => {
    if (!raf) raf = requestAnimationFrame(update);
  };

  const setup = () => {
    // Only pin when the whole hero fits the screen under the nav.
    const room = innerHeight - 72 + 2;
    // Measure in the pinned layout, where the About text sits in its own cell.
    const was = stage.classList.contains('staged');
    if (wide.matches) stage.classList.add('staged');
    const want = wide.matches && hero.offsetHeight <= room && about.scrollHeight <= room && aboutNeed() <= strip.getBoundingClientRect().top - pin.getBoundingClientRect().top + 2;
    stage.classList.toggle('staged', was);
    if (want === on) {
      if (on) {
        measure();
        update();
      }
      return;
    }
    on = want;
    stage.classList.toggle('staged', on);
    if (on) {
      title.setAttribute('aria-label', label);
      pin.append(band);
      cur = -1;
      measure();
      update();
      addEventListener('scroll', onScroll, { passive: true });
      if (location.hash === '#about') scrollTo(0, stage.getBoundingClientRect().top + scrollY - top + dist);
    } else {
      removeEventListener('scroll', onScroll);
      band.remove();
      hero.style.transform = '';
      hero.inert = false;
      panIn.forEach((el) => (el.style.transform = ''));
      letters(1);
      title.removeAttribute('aria-label');
      title.classList.add('is-hatched');
    }
  };
  setup();
  addEventListener('resize', setup);

  // The hero's "Scroll" link plays the stage through to About.
  document.querySelectorAll('a[href="#about"]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!on) return;
      e.preventDefault();
      scrollTo({ top: stage.getBoundingClientRect().top + scrollY - top + dist, behavior: 'smooth' });
    }),
  );
  // One scroll, one section (laptops): a wheel flick glides to the next section
  // with an eased curve instead of dribbling through it. Tall sections still
  // scroll normally until their edge is reached. Keyboard, touch, phones and
  // reduced motion keep native scrolling.
  const navGap = 88;
  const sectionIds = ['projects', 'skills', 'experience', 'contact'];
  let animating = false;
  let glideEnd = 0;
  let lastWheel = 0;
  let frame = 0;

  const pages = () => {
    const list: { a: number; z: number }[] = [];
    const base = scrollY;
    if (on) {
      const s0 = stage.getBoundingClientRect().top + base - top;
      list.push({ a: s0, z: s0 }, { a: s0 + dist, z: s0 + dist });
    } else {
      for (const id of ['home', 'about']) {
        const el = document.getElementById(id);
        if (el) {
          const t = el.getBoundingClientRect().top + base - navGap;
          list.push({ a: t, z: Math.max(t, el.getBoundingClientRect().bottom + base - innerHeight) });
        }
      }
    }
    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const r = el.getBoundingClientRect();
      const t = r.top + base - navGap;
      list.push({ a: t, z: Math.max(t, r.bottom + base - innerHeight) });
    }
    return list;
  };

  const canScrollInside = (node: EventTarget | null, dir: number) => {
    let el = node instanceof Element ? node : null;
    while (el && el !== document.body) {
      const st = getComputedStyle(el);
      if (/(auto|scroll)/.test(st.overflowY) && el.scrollHeight > el.clientHeight + 1) {
        if (dir > 0 ? el.scrollTop + el.clientHeight < el.scrollHeight - 1 : el.scrollTop > 0) return true;
      }
      el = el.parentElement;
    }
    return false;
  };

  const glide = (to: number) => {
    const from = scrollY;
    const dist2 = Math.abs(to - from);
    if (dist2 < 2) return;
    const dur = Math.min(Math.max(520 + dist2 * 0.32, 680), 1150);
    const root = document.documentElement;
    root.style.scrollBehavior = 'auto';
    animating = true;
    const t0 = performance.now();
    const step = (now: number) => {
      const t = clamp((now - t0) / dur);
      scrollTo(0, from + (to - from) * inOut(t));
      if (t < 1 && animating) {
        frame = requestAnimationFrame(step);
      } else {
        animating = false;
        root.style.scrollBehavior = '';
        glideEnd = performance.now();
      }
    };
    frame = requestAnimationFrame(step);
  };
  const stopGlide = () => {
    if (!animating) return;
    animating = false;
    cancelAnimationFrame(frame);
    document.documentElement.style.scrollBehavior = '';
  };

  addEventListener(
    'wheel',
    (e: WheelEvent) => {
      if (!wide.matches || e.ctrlKey || e.defaultPrevented || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      const now = performance.now();
      const gap = now - lastWheel;
      lastWheel = now;
      if (animating) return void e.preventDefault();
      // Swallow the trackpad's inertia tail: a continuous stream of wheel events
      // right after a glide is the tail of the same flick, not a new one.
      if (now - glideEnd < 1400 && gap < 90) return void e.preventDefault();
      const dir = Math.sign(e.deltaY);
      if (!dir || Math.abs(e.deltaY) < 6 || canScrollInside(e.target, dir)) return;
      const list = pages();
      const y = scrollY;
      let i = 0;
      list.forEach((pg, k) => {
        if (y >= pg.a - 4) i = k;
      });
      const cur2 = list[i];
      let target: number | null = null;
      if (dir > 0) {
        if (y < cur2.z - 3) return;
        if (list[i + 1]) target = list[i + 1].a;
      } else if (y > cur2.z + 3) {
        target = cur2.z;
      } else if (y > cur2.a + 3) {
        return;
      } else if (list[i - 1]) {
        target = list[i - 1].z;
      }
      if (target === null) return;
      e.preventDefault();
      glide(target);
    },
    { passive: false },
  );
  ['pointerdown', 'keydown', 'touchstart'].forEach((ev) => addEventListener(ev, stopGlide, { passive: true }));
</script>
