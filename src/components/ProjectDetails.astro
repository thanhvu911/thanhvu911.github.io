---
// Lovable-style deep dive for a project: overview, tools, data model, and a
// walkthrough of each dashboard or diagram. Images open full size on click.
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { ProjectDetail } from '../data/details';
import { projectImage } from '../lib/images';

interface Props {
  slug: string;
  detail: ProjectDetail;
  /** Render the intro (overview, tools, model), the walkthrough, or both. */
  part?: 'intro' | 'walkthrough' | 'all';
}
const { slug, detail, part = 'all' } = Astro.props;
const showIntro = part !== 'walkthrough';
const showWalk = part !== 'intro';

const steps = await Promise.all(
  detail.walkthrough.map(async (w) => {
    const src = projectImage(slug, w.image);
    const full = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
    return { ...w, src, full: full.src };
  }),
);
const kindLabel = { fact: 'Fact table', dim: 'Dimension', measures: 'Measures' } as const;
---

{showIntro && (
<>
<section class="card p-6 md:p-8" aria-labelledby="overview">
  <h2 id="overview" class="display-md text-2xl">Project overview</h2>
  <div class="mt-4 space-y-4 leading-relaxed text-ink/85">
    {detail.overview.map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="card p-6 md:p-8" aria-labelledby="tools">
  <h2 id="tools" class="display-md text-2xl">Tools and technologies used</h2>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      detail.tools.map((t) => (
        <li class="rounded-xl border border-line bg-soft/60 p-5 transition-colors hover:border-teal">
          <h3 class="flex items-center gap-2 font-bold text-strong">
            <span class="size-2 bg-cyan" aria-hidden="true" />
            {t.name}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/80">{t.use}</p>
        </li>
      ))
    }
  </ul>
</section>

{
  detail.model && (
    <section class="card p-6 md:p-8" aria-labelledby="model">
      <h2 id="model" class="display-md text-2xl">Data model breakdown</h2>
      <p class="mt-3 leading-relaxed text-ink/80">{detail.model.note}</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {detail.model.tables.map((t) => (
          <li
            class:list={[
              'rounded-xl border p-4',
              t.kind === 'fact' && 'border-cyan/30 bg-cyan/10 text-strong',
              t.kind === 'dim' && 'border-teal/40 bg-teal-wash/60',
              t.kind === 'measures' && 'border-line bg-soft',
            ]}
          >
            <p class:list={['text-xs font-semibold uppercase tracking-wide', t.kind === 'fact' ? 'text-teal' : 'text-teal-ink']}>{kindLabel[t.kind]}</p>
            <h3 class:list={['mt-1 font-mono text-sm font-bold', t.kind === 'fact' ? 'text-teal-ink' : 'text-strong']}>{t.name}</h3>
            <p class:list={['mt-2 text-sm leading-relaxed', 'text-ink/85']}>{t.desc}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

</>
)}

{showWalk && (
<section class="card p-6 md:p-8" aria-labelledby="walkthrough" data-zoom-root>
  <h2 id="walkthrough" class="display-md text-2xl">Walkthrough</h2>
  <p class="mt-2 text-sm text-muted">What each dashboard and diagram shows, and why it matters. Click an image to enlarge it.</p>
  <ol class="mt-8 space-y-12">
    {
      steps.map((s, i) => (
        <li>
          <button type="button" class="group block w-full cursor-zoom-in overflow-hidden rounded-xl border border-line bg-soft" data-zoom={s.full} data-zoom-alt={s.title}>
            <Image
              src={s.src}
              alt={s.title}
              widths={[640, 960, 1400]}
              sizes="(min-width: 1024px) 720px, 100vw"
              class="h-auto w-full transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </button>
          <div class="mt-5 flex gap-4">
            <span class="grid size-9 shrink-0 place-items-center bg-strong font-mono text-xs font-semibold text-bg">{i + 1}</span>
            <div class="min-w-0">
              <h3 class="display-md text-lg">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-ink/85">{s.summary}</p>
              <ul class="mt-4 space-y-2.5">
                {s.points.map((pt) => (
                  <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink/85">
                    <Icon name="chevron-right" size={16} class="mt-1 shrink-0 text-teal-ink" />
                    {pt}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <dialog class="zoom-dialog" aria-label="Enlarged image" data-zoom-dialog>
    <button type="button" class="zoom-close" aria-label="Close" data-zoom-close><Icon name="x" size={22} /></button>
    <img alt="" class="max-h-[90dvh] max-w-[94vw] rounded-lg bg-white object-contain" data-zoom-img />
  </dialog>
</section>
)}

<style>
  .zoom-dialog {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    display: none;
    place-items: center;
    background: rgb(8 14 26 / 0.92);
  }
  .zoom-dialog[open] {
    display: grid;
  }
  .zoom-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    cursor: pointer;
  }
  .zoom-close:hover {
    background: rgb(255 255 255 / 0.22);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-zoom-root]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-zoom-dialog]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-zoom-img]')!;
    let opener: HTMLElement | null = null;
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        img.src = btn.dataset.zoom!;
        img.alt = btn.dataset.zoomAlt ?? '';
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-zoom-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  });
</script>
