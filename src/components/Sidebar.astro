---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import ResumeMenu from './ResumeMenu.astro';
import CopyEmail from './CopyEmail.astro';
import avatar from '../assets/photo/thanh-avatar.jpg';
import { profile, sections } from '../data/portfolio';

const onHome = Astro.url.pathname === '/';
---

<header class="flex flex-col lg:sticky lg:top-0 lg:h-dvh lg:justify-between lg:py-20">
  <div>
    <a href="/" class="group inline-flex items-center gap-4">
      <Image
        src={avatar}
        alt="Thanh Vu"
        width={112}
        height={112}
        loading="eager"
        class="size-16 rounded-full object-cover ring-2 ring-line"
      />
      <span>
        <span class="block text-3xl font-semibold tracking-tight text-ink sm:text-[2.75rem] sm:leading-none">{profile.name}</span>
        <span class="mt-2 block text-lg font-medium text-accent">{profile.role}</span>
      </span>
    </a>

    <p class="mt-6 max-w-sm text-lg leading-relaxed text-muted">{profile.tagline}</p>

    <p class="mt-5 flex items-center gap-2 text-sm text-muted">
      <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
      {profile.availability}
    </p>
    <p class="mt-1.5 flex items-center gap-2 text-sm text-muted">
      <Icon name="map-pin" size={14} />
      {profile.location}. {profile.locationNote}
    </p>

    <nav class="mt-14 hidden lg:block" aria-label="Sections">
      <ul class="space-y-1">
        {
          sections.map((s) => (
            <li>
              <a href={onHome ? `#${s.id}` : `/#${s.id}`} class="nav-link group flex items-center gap-4 py-2" data-nav={s.id}>
                <span class="nav-line h-px w-8 bg-faint transition-all group-hover:w-14 group-hover:bg-ink" />
                <span class="text-sm font-medium text-muted transition-colors group-hover:text-ink">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-1 lg:mt-0">
    <ResumeMenu up />
    <CopyEmail compact />
    <a href={profile.github} class="icon-btn" aria-label="GitHub" target="_blank" rel="noopener">
      <Icon name="github" size={18} />
    </a>
    <a href={profile.linkedin} class="icon-btn" aria-label="LinkedIn" target="_blank" rel="noopener">
      <Icon name="linkedin" size={17} />
    </a>
    <ThemeToggle />
  </div>
</header>

<style>
  .nav-link.is-active .nav-line {
    width: 3.5rem;
    background: var(--accent);
  }
  .nav-link.is-active span:last-child {
    color: var(--ink);
  }
</style>

<script>
  // Highlight the section currently in view (home page only).
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]),
  );
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('is-active'));
          links.get(e.target.id)?.classList.add('is-active');
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
