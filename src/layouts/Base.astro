---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Assistant from '../components/Assistant.astro';
import { profile } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = `${profile.name}, ${profile.role}. ${profile.tagline}`,
  image = '/og.png',
} = Astro.props;

const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.role} Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  sameAs: [profile.github, profile.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Lancaster', addressRegion: 'PA', addressCountry: 'US' },
  alumniOf: 'Franklin & Marshall College',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" data-theme-color />
    <script is:inline>
      // Apply the saved theme before first paint (light unless the visitor chose dark).
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'dark') {
          root.dataset.theme = 'dark';
          document.querySelector('[data-theme-color]').setAttribute('content', '#050b18');
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {
      profile.goatcounter && (
        <script is:inline async data-goatcounter={`https://${profile.goatcounter}.goatcounter.com/count`} src="//gc.zgo.at/count.js" />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-navy focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <div class="spotlight" aria-hidden="true"></div>
    <Nav />
    <main id="main" class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <Assistant />
    <script>
      // Fill in phone links ([data-phone]) from reversed digits, so the number
      // never appears in the HTML that scrapers read.
      document.querySelectorAll<HTMLElement>('[data-phone]').forEach((el) => {
        const d = [...(el.dataset.phone ?? '')].reverse().join('');
        const pretty = `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
        if (el instanceof HTMLAnchorElement) el.href = `tel:+1${d}`;
        el.querySelectorAll('[data-phone-text]').forEach((t) => (t.textContent = pretty));
        el.hidden = false;
      });

      // Reveal [data-reveal] blocks once as they scroll into view.
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // A soft light that follows the pointer on desktop.
      const spot = document.querySelector<HTMLElement>('.spotlight');
      if (spot && matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let frame = 0;
        window.addEventListener('pointermove', (e) => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            spot.style.setProperty('--x', `${e.clientX}px`);
            spot.style.setProperty('--y', `${e.clientY}px`);
            spot.classList.add('is-on');
          });
        });
      }
    </script>

    <style>
      .spotlight {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(36rem circle at var(--x, 50%) var(--y, 50%), var(--spot), transparent 60%);
        transition: opacity 600ms;
      }
      .spotlight.is-on {
        opacity: 1;
      }
    </style>
  </body>
</html>
