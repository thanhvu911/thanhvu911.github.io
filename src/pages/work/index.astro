---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/portfolio';
---

<Base title="Work" description="Data engineering and analytics projects by Thanh Vu: Microsoft Fabric, SQL Server warehouses, Power BI, and statistics.">
  <section class="container-page py-14 md:py-20">
    <p class="eyebrow">Work</p>
    <h1 class="mt-4 max-w-3xl font-serif text-5xl leading-[1.02] tracking-tight text-ink md:text-7xl">
      Every project, from raw files to decisions
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      {projects.length} end-to-end projects. Each case study covers the question, the pipeline, the data model, data-quality
      work, and what the results actually say.
    </p>
    <div class="mt-14 grid gap-x-6 gap-y-14 md:grid-cols-2">
      {projects.map((p, i) => <ProjectCard project={p} size={i < 2 ? 'lg' : 'sm'} />)}
    </div>
  </section>
</Base>
