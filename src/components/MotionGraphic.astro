---
// The live explainer for a project: crisp SVG motion graphics drawn from the
// project's own results (see src/lib/motion.ts). It starts when it scrolls into
// view, loops, pauses off screen, and has a Replay button. With reduced motion
// it shows the finished frame.
interface Props {
  slug: string;
  alt: string;
  /** Always use the tall layout (cards). */
  compact?: boolean;
  class?: string;
}
const { slug, alt, compact = false, class: cls } = Astro.props;
---

<div class:list={['mg', compact && 'mg-compact', cls]} data-motion={slug} data-alt={alt} data-compact={compact ? '' : undefined}>
  <span class="sr-only">{alt}</span>
  <button type="button" data-replay class="mg-replay" aria-label="Replay animation">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.8-3.8M3 2.5V5.2h2.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    Replay
  </button>
</div>

<style>
  .mg {
    position: relative;
    aspect-ratio: 1200 / 675;
    background: var(--color-surface);
    overflow: hidden;
  }
  .mg-compact {
    aspect-ratio: 480 / 600;
  }
  @media (max-width: 767px) {
    .mg {
      aspect-ratio: 480 / 600;
    }
  }
  .mg-replay {
    position: absolute;
    right: 0.6rem;
    top: 0.6rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-strong);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms, border-color 160ms;
  }
  .mg:hover .mg-replay,
  .mg-replay:focus-visible {
    opacity: 1;
  }
  .mg-replay:hover {
    border-color: var(--color-strong);
  }
  @media (hover: none) {
    .mg-replay {
      opacity: 1;
    }
  }
</style>

<script>
  import { initMotion } from '../lib/motion';
  // Start after the page has painted, so the text shows first.
  const start = () => setTimeout(() => initMotion(), 150);
  if (document.readyState === 'complete') start();
  else addEventListener('load', start, { once: true });
</script>
