---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroViz from '../components/HeroViz.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/photo/thanh-portrait.jpg';
import { credentials, education, experience, profile, projects, research, skills } from '../data/portfolio';
import { projectImage } from '../lib/images';

const featured = projects.filter((p) => p.featured);

const facts = [
  { count: 131, suffix: 'M+', label: 'transaction rows modeled in a SQL Server warehouse' },
  { count: projects.length, label: 'end-to-end data projects, all on GitHub' },
  { text: 'DP-700', label: 'Microsoft Certified: Fabric Data Engineer Associate' },
  { count: 3.82, decimals: 2, label: 'major GPA, B.A. Computer Science, Franklin & Marshall' },
];
const skillIcons = ['code', 'layers', 'database', 'wrench'] as const;
---

<Base>
  <!-- Hero -->
  <section id="home" class="pb-6 pt-10 md:pt-16">
    <div class="container-page grid items-center gap-10 md:grid-cols-[1fr_16rem] lg:grid-cols-[1fr_19rem] lg:gap-16">
      <div class="hero-copy">
        <p class="inline-flex items-center gap-2.5 rounded-full border border-cyan/30 bg-cyan/10 px-3.5 py-1.5 text-sm font-medium text-teal-ink">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-cyan opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-cyan"></span>
          </span>
          Data Analyst Fellow, EDC Lancaster County
        </p>
        <div class="mt-6 flex items-center gap-4">
          <Image src={portrait} alt="" widths={[160]} sizes="72px" loading="eager" class="size-[4.5rem] rounded-xl object-cover object-top ring-1 ring-cyan/40 md:hidden" />
          <h1 class="text-gradient pb-1 text-[3.25rem] font-bold leading-[0.95] tracking-[-0.045em] sm:text-7xl lg:text-8xl">{profile.name}</h1>
        </div>
        <p class="mt-6 max-w-[34rem] text-xl font-medium leading-snug text-strong md:text-2xl">
          Data analyst and data engineer, applying to M.S. programs in Computer Science (AI) for Fall 2027.
        </p>
        <p class="mt-4 max-w-[36rem] text-lg leading-relaxed text-muted">{profile.tagline}</p>
        <p class="mt-4 flex items-center gap-2 text-muted">
          <Icon name="map-pin" size={17} class="shrink-0 text-teal-ink" />
          {profile.location}. Open to data roles in New York or remote.
        </p>

        <div class="mt-8 flex flex-wrap gap-2">
          {
            profile.resumes.map((r, i) => (
              <a href={r.href} target="_blank" class:list={['btn', i === 0 ? 'btn-primary' : 'btn-outline']} data-goatcounter-click={`resume-${r.id}`}>
                <Icon name="download" size={16} />
                {r.label} resume
              </a>
            ))
          }
        </div>

        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]">
          <li><a href={`mailto:${profile.email}`} class="inline-flex items-center gap-2 text-link" data-goatcounter-click="hero-email"><Icon name="mail" size={16} />Email</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-link" data-goatcounter-click="hero-linkedin"><Icon name="linkedin" size={16} />LinkedIn</a></li>
          <li><a href={profile.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-link" data-goatcounter-click="hero-github"><Icon name="github" size={16} />GitHub</a></li>
        </ul>
      </div>

      <div class="hero-photo relative hidden md:block">
        <div class="photo-glow" aria-hidden="true"></div>
        <div class="photo-frame">
          <Image
            src={portrait}
            alt="Portrait of Thanh Vu"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 304px, 256px"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full rounded-[1.1rem] object-cover"
          />
        </div>
      </div>
    </div>

    <div class="container-page mt-14 md:mt-20" data-reveal>
      <HeroViz />
    </div>

    <dl class="container-page mt-4 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {
        facts.map((f, i) => (
          <div class="card flex flex-col p-5 md:p-6" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <dt class="order-2 mt-1.5 text-sm leading-snug text-muted">{f.label}</dt>
            <dd class="order-1 text-3xl font-semibold tabular-nums tracking-tight text-strong md:text-4xl">
              {'count' in f ? (
                <>
                  <span data-count={f.count} data-decimals={f.decimals ?? 0}>{f.count}</span>
                  {f.suffix}
                </>
              ) : (
                <span class="text-gradient">{f.text}</span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Selected projects -->
  <section id="projects" class="section">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <h2 class="section-title">Selected projects</h2>
          <p class="section-lede">
            Research on public data, a data warehouse, and a Power BI report. Each has a written case study and the full code, and the Power BI work has a dashboard you can use in the browser.
          </p>
        </div>
        <a href="/projects" class="text-link">See all {projects.length} projects</a>
      </div>

      <div class="mt-12 space-y-6">
        {
          featured.map((p, i) => {
            const lead = p.metrics[0];
            return (
              <article class="card card-hover group grid overflow-hidden md:grid-cols-12" data-reveal>
                <a
                  href={`/projects/${p.slug}`}
                  class:list={['relative block overflow-hidden border-line bg-white md:col-span-7', i % 2 === 1 ? 'md:order-2 md:border-l' : 'md:border-r', 'border-b md:border-b-0']}
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <Image
                    src={projectImage(p.slug, p.cover)}
                    alt=""
                    widths={[560, 840, 1120]}
                    sizes="(min-width: 1152px) 640px, (min-width: 768px) 58vw, 100vw"
                    class="aspect-[16/10] size-full object-cover object-left-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                </a>
                <div class="flex flex-col justify-center p-6 md:col-span-5 md:p-10">
                  <p class="text-sm text-muted">{p.kind.replaceAll(' · ', ' / ')}, {p.year}</p>
                  <h3 class="mt-2 text-2xl font-semibold leading-tight tracking-tight md:text-[1.75rem]">
                    <a href={`/projects/${p.slug}`} class="hover:text-teal-ink">{p.title}</a>
                  </h3>
                  <p class="serif mt-3 text-xl leading-snug text-ink">{p.headline}</p>
                  <p class="mt-3 leading-relaxed text-muted">{p.summary}</p>
                  <p class="mt-6 flex items-baseline gap-3">
                    <span class="text-gradient text-4xl font-semibold tabular-nums tracking-tight">{lead.value}</span>
                    <span class="text-sm text-muted">{lead.label}</span>
                  </p>
                  <div class="mt-6 flex flex-wrap gap-2">
                    <a href={`/projects/${p.slug}`} class="btn btn-primary">Read the case study</a>
                    <a href={p.repo} target="_blank" rel="noopener" class="btn btn-outline" data-goatcounter-click={`repo-${p.slug}`}>
                      <Icon name="github" size={16} />
                      Code
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="section">
    <div class="container-page">
      <h2 class="section-title" data-reveal>Experience</h2>
      <ol class="timeline mt-12 space-y-5">
        {
          experience.map((job) => (
            <li class="relative pl-8 md:pl-12" data-reveal>
              <span class:list={['timeline-dot', job.current && 'is-current']} aria-hidden="true" />
              <article class="card grid gap-3 p-6 md:grid-cols-[12rem_1fr] md:gap-8 md:p-8">
                <div class="text-sm">
                  <p class="font-semibold text-strong">{job.dates}</p>
                  <p class="mt-0.5 text-muted">{job.location}</p>
                  {job.current && <p class="mt-2 inline-flex rounded-full bg-cyan/15 px-2.5 py-0.5 text-xs font-semibold text-teal-ink">Current role</p>}
                </div>
                <div>
                  <h3 class="text-xl font-semibold tracking-tight">{job.role}</h3>
                  <p class="mt-0.5 text-muted">{job.company}</p>
                  <ul class="dot-list mt-4 max-w-[46rem] space-y-2 leading-relaxed">
                    {job.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tools used">
                    {job.tech.map((t) => <li class="pill">{t}</li>)}
                  </ul>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Education and research -->
  <section id="education" class="section">
    <div class="container-page">
      <h2 class="section-title" data-reveal>Education and research</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <div class="card p-6 md:p-8" data-reveal>
          <span class="icon-tile"><Icon name="graduation-cap" size={20} /></span>
          <h3 class="mt-5 text-xl font-semibold tracking-tight">{education.school}</h3>
          <p class="mt-1 text-muted">Bachelor of Arts in Computer Science, {education.date}</p>
          <dl class="mt-6 space-y-4 text-[0.9375rem]">
            <div>
              <dt class="font-semibold text-strong">GPA</dt>
              <dd class="text-muted">3.72 overall, 3.82 in the major</dd>
            </div>
            <div>
              <dt class="font-semibold text-strong">Honors</dt>
              <dd class="text-muted">Honors List, Fall 2021, 2023, 2024, and 2025. Dean's List, Spring 2022.</dd>
            </div>
            <div>
              <dt class="font-semibold text-strong">Certifications</dt>
              <dd>
                <ul class="space-y-1 text-muted">
                  {credentials.map((c) => <li>{c.title}, {c.detail.split(' · ').slice(-2).join(', ')}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </div>
        <div class="card flex flex-col p-6 md:p-8" data-reveal style="--reveal-delay:100ms">
          <span class="icon-tile"><Icon name="target" size={20} /></span>
          <h3 class="mt-5 text-xl font-semibold tracking-tight">Research interests</h3>
          <p class="serif mt-3 text-xl leading-relaxed text-strong">{research.interests}</p>
          <p class="mt-4 leading-relaxed text-muted">
            My applied research tests whether public data can act as a predictive signal, such as USPS mail data as an early warning for Census housing vacancy.
          </p>
          <div class="mt-auto pt-6">
            <a href="/academics" class="btn btn-outline">Coursework, research, and grad school resume</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="section">
    <div class="container-page">
      <h2 class="section-title" data-reveal>Skills</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          skills.map((g, i) => (
            <div class="card p-6" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="icon-tile"><Icon name={skillIcons[i]} size={20} /></span>
              <h3 class="mt-5 text-base font-semibold">{g.group}</h3>
              <ul class="mt-3 space-y-1.5 text-[0.9375rem]">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .photo-frame {
    position: relative;
    padding: 1px;
    border-radius: 1.2rem;
    background: linear-gradient(150deg, rgb(103 232 249 / 0.9), rgb(96 165 250 / 0.25) 45%, rgb(148 170 220 / 0.12));
  }
  .photo-glow {
    position: absolute;
    inset: 12% -10% -6%;
    border-radius: 2rem;
    background: radial-gradient(closest-side, var(--glow), transparent);
    filter: blur(30px);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, rgb(34 211 238 / 0.7), rgb(96 165 250 / 0.25) 60%, transparent);
  }
  @media (min-width: 768px) {
    .timeline::before {
      left: 0.6875rem;
    }
  }
  .timeline {
    position: relative;
  }
  .timeline-dot {
    position: absolute;
    left: 0;
    top: 2rem;
    width: 0.9375rem;
    height: 0.9375rem;
    border: 2px solid var(--color-cyan);
    border-radius: 999px;
    background: var(--color-bg);
  }
  @media (min-width: 768px) {
    .timeline-dot {
      left: 0.25rem;
    }
  }
  .timeline-dot.is-current {
    background: var(--color-cyan);
    box-shadow: 0 0 0 5px rgb(34 211 238 / 0.15), 0 0 18px rgb(34 211 238 / 0.8);
  }

  /* One entrance on load. */
  .hero-copy,
  .hero-photo {
    animation: settle 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-photo {
    animation-delay: 150ms;
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>

<script>
  // Count the key numbers up once, when they first scroll into view.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const end = Number(el.dataset.count);
          const decimals = Number(el.dataset.decimals ?? 0);
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min((now - start) / 1400, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = (end * eased).toFixed(decimals);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => io.observe(el));
  }
</script>
