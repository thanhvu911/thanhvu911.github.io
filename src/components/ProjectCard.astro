---
import { Image } from 'astro:assets';
import type { Project } from '../data/portfolio';
import { projectImage } from '../lib/images';

interface Props {
  project: Project;
  size?: 'lg' | 'sm';
}
const { project, size = 'sm' } = Astro.props;
const cover = projectImage(project.slug, project.cover);
---

<a href={`/work/${project.slug}`} class="group block" data-reveal>
  <div
    class:list={[
      'relative overflow-hidden rounded-xl border border-line bg-surface transition-colors group-hover:border-line-strong',
      size === 'lg' ? 'aspect-[16/10]' : 'aspect-[16/11]',
    ]}
  >
    <Image
      src={cover}
      alt=""
      widths={size === 'lg' ? [640, 960, 1280] : [480, 720]}
      sizes={size === 'lg' ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'}
      class="size-full object-cover object-left-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg/70 via-transparent to-transparent"></div>
    <span class="absolute left-4 top-4 rounded-md border border-line-strong bg-bg/80 px-2 py-1 font-mono text-[11px] text-ink backdrop-blur">
      {project.number}
    </span>
    <div class="absolute bottom-4 left-4 right-4 flex flex-wrap gap-1.5">
      {
        project.metrics.slice(0, 2).map((m) => (
          <span class="rounded-md bg-bg/85 px-2 py-1 font-mono text-[11px] text-ink backdrop-blur">
            <span class="text-accent">{m.value}</span> {m.label.toLowerCase()}
          </span>
        ))
      }
    </div>
  </div>
  <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.12em] text-accent">{project.kind}</p>
  <h3
    class:list={[
      'mt-1.5 font-medium tracking-tight text-ink transition-colors group-hover:text-accent',
      size === 'lg' ? 'text-xl md:text-2xl' : 'text-lg',
    ]}
  >
    {project.title}
  </h3>
  <p class="mt-2 line-clamp-2 text-sm text-muted">{project.summary}</p>
</a>
