---
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { experience } from '../data/portfolio';
---

<section id="experience" class="border-t border-line" aria-labelledby="experience-title">
  <div class="container-page py-20 md:py-28">
    <SectionHeader id="experience-title" eyebrow="Experience" title="Where I've worked" />

    <ol class="mt-12 border-t border-line">
      {
        experience.map((job, i) => (
          <li class="border-b border-line" data-reveal>
            <details class="group" open={i === 0}>
              <summary class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-center gap-4 py-6 md:grid-cols-[11rem_1fr_auto] md:gap-8 [&::-webkit-details-marker]:hidden">
                <span class="order-2 col-span-2 font-mono text-xs text-muted md:order-none md:col-span-1">
                  {job.dates}
                </span>
                <span class="min-w-0">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="text-lg font-medium tracking-tight text-ink">{job.role}</span>
                    {job.current && (
                      <span class="rounded-full bg-accent-soft px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent">
                        Now
                      </span>
                    )}
                  </span>
                  <span class="mt-1 block text-sm text-muted">
                    {job.company} · {job.location}
                  </span>
                </span>
                <span class="grid size-9 place-items-center rounded-full border border-line text-muted transition-transform group-open:rotate-180">
                  <Icon name="chevron-down" size={16} />
                </span>
              </summary>
              <ul class="grid gap-3 pb-7 md:ml-[13rem] md:max-w-3xl">
                {job.bullets.map((b) => (
                  <li class="relative pl-5 text-[0.9375rem] leading-relaxed text-muted before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-accent">
                    {b}
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>
