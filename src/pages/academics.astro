---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { credentials, education, profile, research } from '../data/portfolio';

const gradResume = profile.resumes.find((r) => r.id === 'grad-school')!;
---

<Base
  title="Academics"
  description="Thanh Vu's research interests, coursework, research projects, and certifications."
>
  <div class="frame">
    <div class="shead">
      <p class="idx"><span class="sq"></span><span class="mono">Academics //<br />Franklin &amp; Marshall College</span></p>
      <div class="ttl">
      <h1 class="section-title">Academics</h1>
      <p class="section-lede">Research interests, coursework, and research projects from my Computer Science degree and my work since.</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href={gradResume.href} target="_blank" class="btn btn-primary" data-goatcounter-click="resume-grad-school">
          <Icon name="download" size={16} />
          Graduate school resume
        </a>
        <a href="/#contact" class="btn btn-outline">Contact me</a>
      </div>
      </div>
    </div>

      <div>
        <div class="cv-row">
          <h2 class="cv-label">Research interests</h2>
          <p class="max-w-[52rem] text-xl leading-snug text-strong md:text-2xl">{research.interests}</p>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Education</h2>
          <div>
            <h3 class="display-md text-xl">{education.school}, {education.location}</h3>
            <p class="mt-1 text-muted">Bachelor of Arts in Computer Science, {education.date}</p>
            <p class="mt-3">GPA 3.72</p>
            <p class="mt-1 text-muted">{education.honors.replaceAll(' · ', '. ')}.</p>
          </div>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Coursework</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {
              research.coursework.map((g) => (
                <div>
                  <h3 class="mono">{g.group}</h3>
                  <ul class="dot-list mt-2 space-y-1 text-ink/90">
                    {g.items.map((c) => <li>{c}</li>)}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Research and applied projects</h2>
          <ol class="space-y-8">
            {
              research.projects.map((p) => (
                <li>
                  <h3 class="display-md text-lg">
                    {p.slug ? <a href={`/projects/${p.slug}`} class="hover:underline hover:underline-offset-4">{p.title}</a> : p.title}
                  </h3>
                  <p class="mt-0.5 text-sm text-muted">{p.meta}</p>
                  <ul class="dot-list mt-3 max-w-[44rem] space-y-2 leading-relaxed text-ink/90">
                    {p.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                  {p.slug && <a href={`/projects/${p.slug}`} class="text-link mt-3 inline-block text-[0.9375rem]">Read the case study</a>}
                </li>
              ))
            }
          </ol>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Certifications</h2>
          <ul class="space-y-2">
            {
              credentials.map((c) => (
                <li>
                  <span class="font-semibold">{c.title}</span>
                  <span class="block text-sm text-muted">{c.detail.split(' · ').slice(-2).join(', ')}{'note' in c && `. ${c.note}`}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Leadership</h2>
          <div>
            <h3 class="font-semibold">{research.leadership.title}</h3>
            <p class="text-sm text-muted">{research.leadership.meta}</p>
            <p class="mt-2 leading-relaxed text-ink/90">{research.leadership.detail}</p>
          </div>
        </div>

        <div class="cv-row">
          <h2 class="cv-label">Service</h2>
          <div>
            <h3 class="font-semibold">{research.service.title}</h3>
            <p class="text-sm text-muted">{research.service.meta}</p>
            <p class="mt-2 leading-relaxed text-ink/90">{research.service.detail}</p>
          </div>
        </div>
      </div>
  </div>
</Base>

<style>
  .cv-row {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 768px) {
    .cv-row {
      padding-inline: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .cv-row {
      grid-template-columns: 30% 1fr;
      gap: 0;
      padding: 0;
    }
    .cv-row > * {
      padding: 2.25rem 2.5rem 2.5rem;
    }
    .cv-row > .cv-label {
      border-right: 1px solid var(--color-line);
    }
  }
  .cv-label {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.55;
    text-transform: uppercase;
  }
  .cv-label::before {
    content: '';
    flex-shrink: 0;
    width: 0.625rem;
    height: 0.625rem;
    margin-top: 0.1875rem;
    background: var(--color-accent);
  }
</style>
