---
// Ctrl+K / ⌘K palette: jump to any page, project, resume, or contact link by
// typing, or hand the question to the "Ask about Thanh" assistant.
import Icon from './Icon.astro';
import { profile, projects } from '../data/portfolio';

interface Item {
  group: string;
  label: string;
  hint?: string;
  href?: string;
  action?: 'copy-email';
  external?: boolean;
  keys: string;
}

const items: Item[] = [
  { group: 'Pages', label: 'Home', href: '/', keys: 'home start' },
  { group: 'Pages', label: 'All projects', href: '/projects', keys: 'projects work portfolio' },
  { group: 'Pages', label: 'Experience', href: '/#experience', keys: 'experience jobs work history edc kcc kpim' },
  { group: 'Pages', label: 'Academics', hint: 'Coursework and research', href: '/academics', keys: 'academics education gpa coursework research grad school masters admissions' },
  { group: 'Pages', label: 'Skills', href: '/#skills', keys: 'skills sql python power bi fabric dax tools' },
  { group: 'Pages', label: 'Contact', href: '/#contact', keys: 'contact hire email phone' },
  ...projects.map((p) => ({
    group: 'Projects',
    label: p.title,
    hint: p.tags.slice(0, 3).join(', '),
    href: `/projects/${p.slug}`,
    keys: `${p.title} ${p.tags.join(' ')} ${p.kind} ${p.summary}`.toLowerCase(),
  })),
  ...profile.resumes.map((r) => ({
    group: 'Resumes',
    label: `${r.label} resume`,
    hint: 'PDF',
    href: r.href,
    external: true,
    keys: `resume cv pdf download ${r.label} ${r.note}`.toLowerCase(),
  })),
  { group: 'Links', label: 'Email Thanh', hint: profile.email, href: `mailto:${profile.email}`, keys: 'email mail contact' },
  { group: 'Links', label: 'Copy email address', action: 'copy-email', keys: 'copy email clipboard' },
  { group: 'Links', label: 'LinkedIn', href: profile.linkedin, external: true, keys: 'linkedin profile social' },
  { group: 'Links', label: 'GitHub', href: profile.github, external: true, keys: 'github code repositories' },
];
---

<dialog class="palette" aria-label="Search the site" data-palette data-items={JSON.stringify(items)} data-email={profile.email}>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" size={18} class="shrink-0 text-muted" />
    <input
      type="text"
      class="h-14 w-full bg-transparent text-base text-strong outline-none placeholder:text-muted"
      placeholder="Search projects, pages, or ask a question"
      aria-label="Search"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      autocomplete="off"
      data-palette-input
    />
    <kbd class="kbd">Esc</kbd>
  </div>
  <ul id="palette-list" class="max-h-[min(24rem,60dvh)] overflow-y-auto p-2" role="listbox" data-palette-list></ul>
  <p class="flex flex-wrap gap-x-4 gap-y-1 border-t border-line px-4 py-2.5 text-xs text-muted">
    <span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> to move</span>
    <span><kbd class="kbd">Enter</kbd> to open</span>
  </p>
</dialog>

<style>
  .palette {
    width: min(38rem, calc(100vw - 2rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--card-border);
    border-radius: 0;
    background: var(--panel-bg);
    color: var(--color-ink);
    box-shadow: 0 40px 100px -20px rgb(2 8 23 / 0.5), 0 0 60px -24px var(--glow);
  }
  .palette::backdrop {
    background: rgb(2 6 16 / 0.6);
    backdrop-filter: blur(4px);
  }
  .palette[open] {
    animation: palette-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  .kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--chip-border);
    border-radius: 0;
    background: var(--chip-bg);
    color: var(--color-muted);
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
  }
  .palette :global(.p-group) {
    padding: 0.625rem 0.625rem 0.25rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .palette :global(.p-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0;
    color: var(--color-ink);
    cursor: pointer;
  }
  .palette :global(.p-item[aria-selected='true']) {
    background: var(--color-accent-wash);
    color: var(--color-strong);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .palette :global(.p-hint) {
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .palette :global(.p-ask) {
    color: var(--color-accent-ink);
    font-weight: 600;
  }
</style>

<script>
  interface Item {
    group: string;
    label: string;
    hint?: string;
    href?: string;
    action?: 'copy-email';
    external?: boolean;
    keys: string;
    ask?: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-palette-list]')!;
  const items: Item[] = JSON.parse(dialog.dataset.items ?? '[]');
  let shown: Item[] = [];
  let active = 0;

  const filter = (q: string): Item[] => {
    const words = q.toLowerCase().split(/\s+/).filter(Boolean);
    const hits = words.length ? items.filter((it) => words.every((w) => `${it.label} ${it.keys}`.toLowerCase().includes(w))) : items;
    const ask: Item[] = q.trim() ? [{ group: 'Ask', label: `Ask the assistant: “${q.trim()}”`, keys: '', ask: q.trim() }] : [];
    return hits.length ? [...hits, ...ask] : ask;
  };

  const render = () => {
    shown = filter(input.value);
    active = Math.min(active, Math.max(shown.length - 1, 0));
    list.replaceChildren();
    let group = '';
    shown.forEach((it, i) => {
      if (it.group !== group) {
        group = it.group;
        const h = document.createElement('li');
        h.className = 'p-group';
        h.setAttribute('role', 'presentation');
        h.textContent = group;
        list.append(h);
      }
      const li = document.createElement('li');
      li.className = 'p-item';
      li.id = `p-opt-${i}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(i === active));
      const label = document.createElement('span');
      label.textContent = it.label;
      if (it.ask) label.className = 'p-ask';
      li.append(label);
      if (it.hint) {
        const hint = document.createElement('span');
        hint.className = 'p-hint';
        hint.textContent = it.hint;
        li.append(hint);
      }
      li.addEventListener('pointermove', () => setActive(i));
      li.addEventListener('click', () => run(it));
      list.append(li);
    });
    input.setAttribute('aria-activedescendant', shown.length ? `p-opt-${active}` : '');
  };

  const setActive = (i: number) => {
    if (i === active) return;
    active = i;
    list.querySelectorAll('.p-item').forEach((el, j) => el.setAttribute('aria-selected', String(j === active)));
    list.querySelector(`#p-opt-${active}`)?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', `p-opt-${active}`);
  };

  const run = async (it: Item) => {
    dialog.close();
    if (it.ask) {
      window.dispatchEvent(new CustomEvent('assistant:open', { detail: { question: it.ask } }));
    } else if (it.action === 'copy-email') {
      await navigator.clipboard?.writeText(dialog.dataset.email ?? '').catch(() => {});
    } else if (it.href) {
      if (it.external) window.open(it.href, '_blank', 'noopener');
      else location.href = it.href;
    }
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    active = 0;
    render();
    dialog.showModal();
    input.focus();
  };

  input.addEventListener('input', () => {
    active = 0;
    render();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const n = shown.length;
      if (n) setActive((active + (e.key === 'ArrowDown' ? 1 : -1) + n) % n);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (shown[active]) run(shown[active]);
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close(); // click on the backdrop
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  window.addEventListener('palette:open', open);
</script>
