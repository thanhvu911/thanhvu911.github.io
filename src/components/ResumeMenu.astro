---
import Icon from './Icon.astro';
import { profile } from '../data/portfolio';

interface Props {
  /** Open the menu above the button (for use near the bottom of the screen). */
  up?: boolean;
}
const { up = false } = Astro.props;
---

<details class="resume-menu relative">
  <summary class="btn btn-ghost list-none [&::-webkit-details-marker]:hidden">
    <Icon name="download" />
    Resume
    <Icon name="chevron-down" size={14} class="chevron transition-transform" />
  </summary>
  <ul
    class:list={[
      'absolute left-0 z-30 w-64 rounded-lg border border-line bg-surface p-1 shadow-xl shadow-black/10',
      up ? 'bottom-full mb-2' : 'mt-2',
    ]}
  >
    {
      profile.resumes.map((r) => (
        <li>
          <a href={r.href} target="_blank" class="flex flex-col rounded-md px-3 py-2.5 hover:bg-accent-wash">
            <span class="text-sm font-medium text-ink">{r.label} resume</span>
            <span class="text-xs text-muted">{r.note}, PDF</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .resume-menu[open] .chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  // Close any open resume menu on outside click or Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.resume-menu[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.resume-menu[open]').forEach((d) => {
      d.open = false;
      d.querySelector('summary')?.focus();
    });
  });
</script>
