---
// Runnable code on a project page: pick SQL or Python, edit it, press Run (or
// Ctrl+Enter), and the first 10 rows come back. Everything runs in the visitor's
// browser against a small table, so nothing is sent anywhere. Python (pandas)
// loads from the Pyodide CDN only when someone first runs it.
import type { Playground } from '../data/playgrounds';
interface Props {
  slug: string;
  pg: Playground;
}
const { slug, pg } = Astro.props;
---

<section class="lab" data-lab data-table={pg.table} aria-labelledby={`lab-${slug}`}>
  <div class="lab-head">
    <p class="mono lab-kicker">Try it // runs in your browser</p>
    <h2 id={`lab-${slug}`} class="lab-title">Write your own code</h2>
    <p class="lab-blurb">{pg.blurb}</p>
    <p class="mono lab-cols">Table <b>{pg.table}</b>: {pg.columns}</p>
  </div>

  <div class="lab-modes" role="group" aria-label="Language">
    <button type="button" class="lab-mode" data-mode="sql" aria-pressed="true">SQL</button>
    <button type="button" class="lab-mode" data-mode="py" aria-pressed="false">Python</button>
  </div>

  <div class="lab-chips" role="group" aria-label="Example queries" data-chips="sql">
    {pg.queries.map((q, i) => (
      <button type="button" class="lab-chip" data-code={q.sql} aria-pressed={i === 0 ? 'true' : 'false'}>{q.label}</button>
    ))}
  </div>
  <div class="lab-chips" role="group" aria-label="Example Python snippets" data-chips="py" hidden>
    {pg.py.map((q, i) => (
      <button type="button" class="lab-chip" data-code={q.code} aria-pressed={i === 0 ? 'true' : 'false'}>{q.label}</button>
    ))}
  </div>

  <div class="lab-editor">
    <label for={`sql-${slug}`} class="sr-only">Code editor</label>
    <textarea id={`sql-${slug}`} class="lab-sql" spellcheck="false" autocapitalize="off" autocomplete="off" rows="7" data-editor>{pg.queries[0].sql}</textarea>
    <div class="lab-bar">
      <button type="button" class="btn btn-primary lab-run" data-run>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
        Run
      </button>
      <span class="mono lab-hint" data-hint>Ctrl + Enter</span>
      <span class="mono lab-stat" data-stat role="status" aria-live="polite">Loading data...</span>
    </div>
  </div>

  <div class="lab-out" data-out>
    <p class="lab-empty">Results appear here (first 10 rows). In Python, the last expression is shown, and print() works too.</p>
  </div>
</section>

<style>
  .lab {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 1.25rem;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .lab {
      padding: 1.75rem 2rem;
    }
  }
  .lab-kicker {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .lab-modes {
    display: inline-flex;
    margin-top: 1.25rem;
    border: 1px solid var(--color-line);
  }
  .lab-mode {
    min-height: 2.5rem;
    padding: 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .lab-mode + .lab-mode {
    border-left: 1px solid var(--color-line);
  }
  .lab-mode[aria-pressed='true'] {
    background: var(--color-strong);
    color: var(--color-bg);
  }
  .lab-title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: var(--color-strong);
  }
  .lab-blurb {
    margin-top: 0.5rem;
    color: var(--color-ink);
    max-width: 46rem;
  }
  .lab-cols {
    margin-top: 0.5rem;
    font-size: 0.74rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .lab-cols b {
    color: var(--color-strong);
  }
  .lab-chips[hidden] {
    display: none;
  }
  .lab-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .lab-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color 150ms, background 150ms;
  }
  .lab-chip:hover {
    border-color: var(--color-strong);
  }
  .lab-chip[aria-pressed='true'] {
    background: var(--color-strong);
    color: var(--color-bg);
    border-color: var(--color-strong);
  }
  .lab-editor {
    margin-top: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .lab-sql {
    display: block;
    width: 100%;
    resize: vertical;
    min-height: 8rem;
    padding: 0.9rem 1rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    tab-size: 2;
    white-space: pre;
    overflow-x: auto;
  }
  .lab-editor:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(201 154 69 / 0.3);
  }
  .lab-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .lab-run {
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.74rem;
  }
  .lab-hint,
  .lab-stat {
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .lab-stat {
    margin-left: auto;
  }
  .lab-stat.is-error {
    color: var(--color-accent-ink);
  }
  .lab-out {
    margin-top: 0.75rem;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    min-height: 4rem;
  }
  .lab-empty {
    padding: 1.1rem 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .lab-out :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .lab-out :global(th),
  .lab-out :global(td) {
    padding: 0.5rem 0.9rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--color-line);
  }
  .lab-out :global(th) {
    color: var(--color-muted);
    font-weight: 500;
    letter-spacing: 0.04em;
    background: var(--color-surface);
  }
  .lab-out :global(td) {
    color: var(--color-strong);
  }
  .lab-out :global(td.num) {
    text-align: right;
  }
  .lab-out :global(tr.row-in) {
    animation: lab-row 320ms ease-out both;
  }
  .lab-out :global(.lab-print) {
    margin: 0.75rem 0 0;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    white-space: pre-wrap;
    color: var(--color-ink);
  }
  @keyframes lab-row {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lab-out :global(tr.row-in) {
      animation: none;
    }
  }
</style>

<script>
  type Rows = Record<string, unknown>[];
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const PYODIDE = 'https://cdn.jsdelivr.net/pyodide/v0.26.4/full/';
  let pyReady: Promise<any> | null = null;
  const loadPy = () =>
    (pyReady ??= new Promise((resolve, reject) => {
      const el = document.createElement('script');
      el.src = PYODIDE + 'pyodide.js';
      el.onload = async () => {
        try {
          const py = await (window as any).loadPyodide({ indexURL: PYODIDE });
          await py.loadPackage('pandas');
          await py.runPythonAsync(`
import ast, io, json, contextlib
import pandas as pd

def _run(code):
    out = io.StringIO()
    shown = None
    with contextlib.redirect_stdout(out):
        tree = ast.parse(code)
        last = None
        if tree.body and isinstance(tree.body[-1], ast.Expr):
            last = ast.Expression(tree.body.pop().value)
        exec(compile(tree, '<code>', 'exec'), globals())
        if last is not None:
            shown = eval(compile(last, '<code>', 'eval'), globals())
    table = None
    total = 0
    if isinstance(shown, pd.Series):
        shown = shown.to_frame().reset_index() if shown.name is not None else shown.reset_index()
    if isinstance(shown, pd.DataFrame):
        table = shown.head(500).to_json(orient='records')
        total = len(shown)
    elif shown is not None:
        out.write(repr(shown) + chr(10))
    return json.dumps({'text': out.getvalue(), 'table': table, 'total': total})
`);
          resolve(py);
        } catch (e) {
          pyReady = null;
          reject(e);
        }
      };
      el.onerror = () => {
        pyReady = null;
        reject(new Error('Could not load Python. Check your connection and try again.'));
      };
      document.head.appendChild(el);
    }));

  document.querySelectorAll<HTMLElement>('[data-lab]').forEach((lab) => {
    const table = lab.dataset.table!;
    const editor = lab.querySelector<HTMLTextAreaElement>('[data-editor]')!;
    const out = lab.querySelector<HTMLElement>('[data-out]')!;
    const stat = lab.querySelector<HTMLElement>('[data-stat]')!;
    const runBtn = lab.querySelector<HTMLButtonElement>('[data-run]')!;
    const hint = lab.querySelector<HTMLElement>('[data-hint]')!;
    const modes = [...lab.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const chipBoxes = [...lab.querySelectorAll<HTMLElement>('[data-chips]')];
    const first = (m: string) => lab.querySelector<HTMLElement>(`[data-chips="${m}"] [data-code]`)!.dataset.code!;
    const drafts: Record<string, string> = { sql: editor.value, py: first('py') };
    let mode = 'sql';
    let db: any = null;
    let loading: Promise<any> | null = null;
    let rowsText = '';

    const data = () => (rowsText ? Promise.resolve(rowsText) : fetch(`/data/${table}.json`).then((r) => r.text()).then((t) => (rowsText = t)));

    const load = () =>
      (loading ??= (async () => {
        const [{ default: alasql }, text] = await Promise.all([import('alasql'), data()]);
        const rows = JSON.parse(text);
        alasql(`CREATE TABLE ${table}`);
        (alasql.tables as any)[table].data = rows;
        db = alasql;
        stat.textContent = `${rows.length.toLocaleString()} rows loaded`;
        return db;
      })());

    const draw = (rows: Rows, total: number, ms: number) => {
      if (!rows.length) {
        out.innerHTML = '<p class="lab-empty">The code ran but returned no rows.</p>';
        stat.textContent = `0 rows in ${ms.toFixed(0)} ms`;
        return;
      }
      const cols = Object.keys(rows[0]);
      const shown = rows.slice(0, 10);
      const head = cols.map((c) => `<th scope="col">${esc(c)}</th>`).join('');
      const body = shown
        .map((r, i) => `<tr class="row-in" style="animation-delay:${i * 35}ms">${cols.map((c) => `<td${typeof r[c] === 'number' ? ' class="num"' : ''}>${esc(typeof r[c] === 'number' ? (Number.isInteger(r[c]) ? (r[c] as number).toLocaleString() : r[c]) : r[c])}</td>`).join('')}</tr>`)
        .join('');
      out.innerHTML = `<table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
      stat.classList.remove('is-error');
      stat.textContent = total > 10 ? `Showing 10 of ${total.toLocaleString()} rows, ${ms.toFixed(0)} ms` : `${total} row${total === 1 ? '' : 's'}, ${ms.toFixed(0)} ms`;
    };

    const runSql = async () => {
      const a = await load();
      const sql = editor.value.trim();
      if (!/^select\b/i.test(sql)) throw new Error('Only SELECT queries are allowed here.');
      const t0 = performance.now();
      const rows = a(sql) as Rows;
      const list = Array.isArray(rows) ? rows : [];
      draw(list, list.length, performance.now() - t0);
    };

    const runPy = async () => {
      stat.classList.remove('is-error');
      stat.textContent = pyReady ? 'Running...' : 'Loading Python and pandas (about 10 MB, first run only)...';
      const [py, text] = await Promise.all([loadPy(), data()]);
      py.globals.set('_rows_json', text);
      await py.runPythonAsync(`import json\ndf = pd.DataFrame(json.loads(_rows_json))\n${table} = df`);
      const t0 = performance.now();
      py.globals.set('_user_code', editor.value);
      const res = JSON.parse(await py.runPythonAsync('_run(_user_code)'));
      const ms = performance.now() - t0;
      if (res.table) {
        draw(JSON.parse(res.table), res.total, ms);
        if (res.text) out.insertAdjacentHTML('beforeend', `<pre class="lab-print">${esc(res.text)}</pre>`);
      } else {
        out.innerHTML = res.text ? `<pre class="lab-print">${esc(res.text)}</pre>` : '<p class="lab-empty">The code ran and printed nothing. End with an expression such as df.head() to see a table.</p>';
        stat.textContent = `done in ${ms.toFixed(0)} ms`;
      }
    };

    const run = async () => {
      runBtn.disabled = true;
      try {
        await (mode === 'sql' ? runSql() : runPy());
      } catch (e) {
        stat.classList.add('is-error');
        const m = String((e as any)?.message ?? e).trim().split('\n');
        stat.textContent = (m[m.length - 1] || 'Error').slice(0, 200);
      } finally {
        runBtn.disabled = false;
      }
    };

    const setMode = (m: string) => {
      drafts[mode] = editor.value;
      mode = m;
      modes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      chipBoxes.forEach((c) => (c.hidden = c.dataset.chips !== m));
      editor.value = drafts[m];
      hint.textContent = m === 'sql' ? 'Ctrl + Enter' : 'Ctrl + Enter. Python loads on first run';
      stat.classList.remove('is-error');
    };
    modes.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode!)));

    runBtn.addEventListener('click', run);
    editor.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        run();
      }
      if (e.key === 'Tab' && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
        e.preventDefault();
        editor.setRangeText('    ', editor.selectionStart, editor.selectionEnd, 'end');
      }
    });
    lab.querySelectorAll<HTMLButtonElement>('[data-code]').forEach((chip) =>
      chip.addEventListener('click', () => {
        chip.parentElement!.querySelectorAll('[data-code]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        editor.value = chip.dataset.code!;
        run();
      }),
    );
    new IntersectionObserver((es, io) => {
      if (es.some((e) => e.isIntersecting)) {
        io.disconnect();
        if (mode === 'sql') run();
      }
    }, { threshold: 0.2 }).observe(lab);
  });
</script>
