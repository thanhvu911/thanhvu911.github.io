---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/portfolio';
---

<Base title="Projects" description="Data engineering and analytics projects by Thanh Vu: Microsoft Fabric, SQL Server warehouses, Power BI, and statistics.">
  <section class="section">
    <div class="container-page">
      <h1 class="section-title">All projects</h1>
      <p class="section-lede">
        Seven end-to-end projects on public and business data. Each has a written case study and the full code on GitHub.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</Base>
