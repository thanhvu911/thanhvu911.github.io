---
// The case study for one project, in five numbered parts: problem and context,
// my role and approach, tech stack, results, and what I learned. Each part is
// a row on the site grid: label on the left, content on the right.
import Icon from './Icon.astro';
import type { ProjectDetail } from '../data/details';
import { repoFile, type Project } from '../data/portfolio';

interface Props {
  project: Project;
  detail?: ProjectDetail;
}
const { project, detail } = Astro.props;
const kindLabel = { fact: 'Fact table', dim: 'Dimension', measures: 'Measures' } as const;
---

<div class="case">
  <section class="row" aria-labelledby="case-problem">
    <h2 id="case-problem" class="label"><span class="mono">01 //</span>Problem &amp; context</h2>
    <div class="body">
      <p class="lead">{project.problem}</p>
      <p class="mt-5 max-w-[46rem] leading-relaxed text-ink">{project.why}</p>
      {project.context && <p class="note mt-5">{project.context}</p>}
      {
        detail && (
          <div class="mt-6 max-w-[46rem] space-y-3 leading-relaxed text-muted">
            {detail.overview.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="row" aria-labelledby="case-role">
    <h2 id="case-role" class="label"><span class="mono">02 //</span>My role &amp; approach</h2>
    <div class="body">
      <p class="font-medium text-strong">{project.role}</p>
      <ol class="mt-6 space-y-4">
        {
          project.approach.map((step, i) => (
            <li class="flex gap-4">
              <span class="step">{String(i + 1).padStart(2, '0')}</span>
              <p class="max-w-[46rem] pt-0.5 leading-relaxed text-ink">{step}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-8 overflow-x-auto">
        <ol class="flex min-w-max items-center gap-2" aria-label="Pipeline">
          {
            project.architecture.map((node, i) => (
              <li class="flex items-center gap-2">
                <span class:list={['flow', { last: i === project.architecture.length - 1 }]}>{node}</span>
                {i < project.architecture.length - 1 && <Icon name="arrow-right" size={14} class="text-muted" />}
              </li>
            ))
          }
        </ol>
      </div>
      <h3 class="mono mt-10">Hard parts I solved</h3>
      <ul class="dot-list mt-4 max-w-[46rem] space-y-3 leading-relaxed text-ink">
        {project.challenges.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="row" aria-labelledby="case-stack">
    <h2 id="case-stack" class="label"><span class="mono">03 //</span>Tech stack</h2>
    <div class="body">
      {
        detail ? (
          <ul class="cells sm:grid-cols-2">
            {detail.tools.map((t) => (
              <li class="tool">
                <h3 class="font-semibold text-strong">{t.name}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.use}</p>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <li class="pill">{t}</li>
            ))}
          </ul>
        )
      }
      {
        detail?.model && (
          <>
            <h3 class="mono mt-10">Data model</h3>
            <p class="mt-3 max-w-[46rem] leading-relaxed text-ink">{detail.model.note}</p>
            <ul class="cells mt-5 sm:grid-cols-2">
              {detail.model.tables.map((t) => (
                <li class:list={['tool', { fact: t.kind === 'fact' }]}>
                  <p class="mono">{kindLabel[t.kind]}</p>
                  <h4 class="mt-1 font-mono text-sm font-semibold text-strong">{t.name}</h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.desc}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h3 class="mono mt-10">Skills shown</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.skills.map((s) => <li class="pill">{s}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-2">
        {
          project.repo && (
            <a href={project.repo} target="_blank" rel="noopener" class="btn btn-primary" data-goatcounter-click={`repo-${project.slug}`}>
              <Icon name="github" size={16} />
              Repository
            </a>
          )
        }
        {
          project.pbix?.map((f) => (
            <a href={repoFile(project.repo, f.file)} class="btn btn-outline" data-goatcounter-click={`pbix-${project.slug}`}>
              <Icon name="download" size={16} />
              {f.label.replace(/ \(.*/, '')} (.pbix)
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="row" aria-labelledby="case-results">
    <h2 id="case-results" class="label"><span class="mono">04 //</span>Results &amp; impact</h2>
    <div class="body">
      <ul class="space-y-4">
        {
          project.results.map((r) => (
            <li class="result">
              <Icon name="check" size={16} class="mt-1 shrink-0 text-teal-ink" />
              <span>{r}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    (project.learned || project.improve) && (
      <section class="row" aria-labelledby="case-learned">
        <h2 id="case-learned" class="label">
          <span class="mono">05 //</span>What I learned &amp; would improve
        </h2>
        <div class="body grid gap-8 md:grid-cols-2 md:gap-10">
          {project.learned && (
            <div>
              <h3 class="mono">Lessons</h3>
              <ul class="dot-list mt-4 space-y-3 leading-relaxed text-ink">
                {project.learned.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </div>
          )}
          {project.improve && (
            <div>
              <h3 class="mono">What I would do next</h3>
              <ul class="mt-4 space-y-3 leading-relaxed text-ink">
                {project.improve.map((l) => (
                  <li class="flex gap-3">
                    <Icon name="arrow-right" size={15} class="mt-1.5 shrink-0 text-teal-ink" />
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }
</div>

<style>
  .row {
    display: grid;
    border-bottom: 1px solid var(--color-line);
  }
  .label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.5rem 1rem 0;
    color: var(--color-strong);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .body {
    min-width: 0;
    padding: 1.25rem 1rem 2.25rem;
  }
  @media (min-width: 768px) {
    .label {
      padding-inline: 2.5rem;
    }
    .body {
      padding-inline: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .row {
      grid-template-columns: 30% 1fr;
    }
    .label {
      flex-direction: column;
      gap: 0.5rem;
      padding-block: 2.5rem;
      border-right: 1px solid var(--color-line);
    }
    .body {
      padding-block: 2.5rem 3rem;
    }
  }
  .lead {
    max-width: 46rem;
    color: var(--color-strong);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.4;
  }
  @media (min-width: 768px) {
    .lead {
      font-size: 1.625rem;
    }
  }
  .note {
    max-width: 46rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-cyan);
    background: var(--color-teal-wash);
    color: var(--color-ink);
  }
  .step {
    flex-shrink: 0;
    width: 2rem;
    color: var(--color-teal-ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    padding-top: 0.25rem;
  }
  .flow {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .flow.last {
    border-color: var(--color-cyan);
    background: var(--color-teal-wash);
    color: var(--color-strong);
  }
  .tool {
    padding: 1.125rem 1.25rem;
  }
  .tool.fact {
    box-shadow: inset 3px 0 0 var(--color-cyan);
  }
  .result {
    display: flex;
    gap: 0.75rem;
    max-width: 48rem;
    color: var(--color-strong);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
</style>
