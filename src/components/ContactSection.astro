---
import Icon from './Icon.astro';
import { profile } from '../data/portfolio';

const hasForm = Boolean(profile.web3formsKey);
const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${profile.email}&su=${encodeURIComponent('Opportunity for Thanh Vu')}`;

const quick = [
  { id: 'gmail', icon: 'external-link', title: 'Write in Gmail', href: gmailHref, external: true },
  { id: 'linkedin', icon: 'linkedin', title: 'LinkedIn', href: profile.linkedin, external: true },
  { id: 'github', icon: 'github', title: 'GitHub', href: profile.github, external: true },
] as const;
---

<section id="contact" class="ct border-b border-line">
  <div class="ct-side">
    <p class="flex items-start gap-3"><span class="sq mt-0.5"></span><span class="mono">07 // Contact</span></p>
    <div class="mt-auto hidden lg:block">
      <p class="mono">{profile.location}<br />Eastern time</p>
      <p class="mono mt-4">Usually replies<br />within a day</p>
    </div>
  </div>

  <div class="ct-main">
    <h2 class="display ct-title" data-reveal>Get in<br />touch</h2>
    <p class="mt-6 max-w-[34rem] text-lg text-muted" data-reveal>
      Questions about my work, a project, or a role? Use whichever is easiest.
    </p>

    <a href={`mailto:${profile.email}`} class="mail" data-goatcounter-click="contact-email" data-reveal>
      <span class="truncate">{profile.email}</span>
      <Icon name="arrow-up-right" size={28} class="shrink-0 text-teal-ink" />
    </a>

    <div class="mt-10 flex flex-wrap gap-2" data-reveal>
      <a href={`mailto:${profile.email}`} class="btn btn-primary" data-goatcounter-click="contact-email-btn">
        <Icon name="mail" size={16} />
        Send an email
      </a>
      {
        quick.map((q) => (
          <a href={q.href} target="_blank" rel="noopener" class="btn btn-outline" data-goatcounter-click={`contact-${q.id}`}>
            <Icon name={q.icon} size={16} />
            {q.title}
          </a>
        ))
      }
      <a href="#contact" class="btn btn-outline" data-phone={profile.phoneReversed} data-goatcounter-click="contact-phone" hidden>
        <Icon name="phone" size={16} />
        <span data-phone-text></span>
      </a>
    </div>

    <button
      type="button"
      class="mono mt-6 inline-flex min-h-11 items-center gap-2 hover:text-strong"
      data-copy-email={profile.email}
    >
      <Icon name="copy" size={14} />
      <span data-copy-label>Copy email address</span>
    </button>
    <span class="sr-only" aria-live="polite" data-copy-status></span>

    {
      hasForm && (
        <form class="card mt-10 max-w-[40rem] space-y-5 p-6 md:p-8" data-contact-form data-key={profile.web3formsKey} novalidate>
          <h3 class="display-md text-lg">Send a message</h3>
          <div>
            <label for="cf-name" class="mono mb-1.5 block">Name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" class="field" required />
          </div>
          <div>
            <label for="cf-email" class="mono mb-1.5 block">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" class="field" required />
          </div>
          <div>
            <label for="cf-message" class="mono mb-1.5 block">Message</label>
            <textarea id="cf-message" name="message" rows="5" placeholder="What role, program, or project is this about?" class="field resize-y" required />
          </div>
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <p class="hidden px-3 py-2 text-sm" role="status" data-form-status />
          <button type="submit" class="btn btn-primary w-full" data-submit>
            Send message
          </button>
        </form>
      )
    }
  </div>
</section>

<style>
  .ct {
    display: grid;
  }
  .ct-side {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--color-line);
  }
  .ct-main {
    min-width: 0;
    padding: 2.5rem 1rem 4rem;
  }
  @media (min-width: 768px) {
    .ct-side {
      padding-inline: 2.5rem;
    }
    .ct-main {
      padding: 4rem 2.5rem 5rem;
    }
  }
  @media (min-width: 1024px) {
    .ct {
      grid-template-columns: 30% 1fr;
      min-height: 40rem;
    }
    .ct-side {
      padding-block: 2.25rem;
      border-right: 1px solid var(--color-line);
      border-bottom: 0;
    }
  }
  .ct-title {
    font-size: clamp(3.25rem, 9vw, 7.5rem);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    margin-top: 2.5rem;
    padding-bottom: 0.375rem;
    border-bottom: 2px solid var(--color-strong);
    color: var(--color-strong);
    font-size: clamp(1.125rem, 3.2vw, 2.125rem);
    font-weight: 500;
    transition: border-color 200ms;
  }
  .mail:hover {
    border-color: var(--color-cyan);
  }
  .mail :global(svg) {
    transition: transform 250ms;
  }
  .mail:hover :global(svg) {
    transform: translate(3px, -3px);
  }
  [data-phone][hidden] {
    display: none;
  }
</style>

<script>
  // Copy email
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  copyBtn?.addEventListener('click', async () => {
    const label = copyBtn.querySelector('[data-copy-label]')!;
    const status = document.querySelector('[data-copy-status]')!;
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.copyEmail!);
      label.textContent = 'Copied';
      status.textContent = 'Email address copied';
    } catch {
      label.textContent = copyBtn.dataset.copyEmail!;
    }
    setTimeout(() => {
      label.textContent = 'Copy email address';
      status.textContent = '';
    }, 2200);
  });

  // Web3Forms submission (only rendered when an access key is configured).
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const data = new FormData(form);
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.className = `px-3 py-2 text-sm ${ok ? 'bg-teal-wash text-teal-ink' : 'bg-red-500/10 text-red-600'}`;
    };

    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    if (!name || !email || !message) {
      show('Fill in your name, email, and message to send.', false);
      form.querySelector<HTMLElement>(!name ? '#cf-name' : !email ? '#cf-email' : '#cf-message')?.focus();
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Sending…';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: form.dataset.key,
          subject: `Portfolio message from ${name}`,
          from_name: 'Thanh Vu portfolio',
          name,
          email,
          message,
          botcheck: data.get('botcheck') ? true : '',
        }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      show('Message sent. I will reply to your email soon.', true);
    } catch {
      show('The message did not go through. Email me directly or use LinkedIn instead.', false);
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send message';
    }
  });
</script>
