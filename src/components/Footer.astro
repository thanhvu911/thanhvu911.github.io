---
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import ResumeMenu from './ResumeMenu.astro';
import { profile } from '../data/portfolio';
---

<footer id="contact" class="border-t border-line">
  <div class="container-page py-20 md:py-28">
    <p class="eyebrow">Contact</p>
    <h2 class="mt-4 max-w-3xl font-serif text-5xl leading-[1.05] tracking-tight text-ink md:text-7xl">
      Have messy data and a decision to make? <em class="text-accent">Let's talk.</em>
    </h2>
    <p class="mt-6 max-w-xl text-muted">
      {profile.availability}. Based in {profile.location}, {profile.locationNote.toLowerCase()}.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">
        <Icon name="mail" />
        Email me
      </a>
      <CopyEmail />
      <ResumeMenu />
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-4 py-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono">© {new Date().getFullYear()} {profile.name}</p>
      <div class="flex items-center gap-5 font-mono">
        <a href={profile.github} class="hover:text-ink" target="_blank" rel="noopener">GitHub</a>
        <a href={profile.linkedin} class="hover:text-ink" target="_blank" rel="noopener">LinkedIn</a>
        <a href={`mailto:${profile.email}`} class="hover:text-ink">Email</a>
      </div>
    </div>
  </div>
</footer>
