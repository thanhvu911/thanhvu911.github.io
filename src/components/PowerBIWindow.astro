---
// Frames an interactive dashboard the way a reader sees a published report in
// the Power BI Service: dark app header, action bar, Pages pane, report canvas
// with a Filters pane, and a footer with page navigation and zoom. Page 1 is
// the live demo (slot); the other pages are the original report screenshots.
// The demo's controls block (marked data-pbi-filters) becomes the Filters pane
// through CSS alone, so the demo scripts are untouched.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, repoFile, type Project } from '../data/portfolio';
import { projectImage } from '../lib/images';

interface Props {
  project: Project;
}
const { project } = Astro.props;

// "powerbi-page-2-district-category-table.png" -> "District category table";
// other report screenshots use their caption ("Filtered to Cook County").
const pageName = (s: { file: string; caption: string }) => {
  if (!s.file.startsWith('powerbi-page-')) return s.caption.replace(/^Report overview: /, 'Overview, ');
  const words = s.file.replace(/^powerbi-page-\d+-/, '').replace(/\.png$/, '').replaceAll('-', ' ');
  return words.charAt(0).toUpperCase() + words.slice(1);
};
const shots = project.images.filter((i) => i.category === 'Power BI' && i.file.startsWith('powerbi-') && !i.file.includes('data-model')).slice(0, 4);
const model = project.images.find((i) => i.file === 'powerbi-data-model.png');
const pages = [
  { label: 'Interactive overview' },
  ...shots.map((s) => ({ label: pageName(s), image: s })),
  ...(model ? [{ label: 'Data model', image: model }] : []),
];
const pbix = project.pbix?.[0];
const id = `pbi-${project.slug}`;
---

<figure class="pbi-window" data-pbi aria-label={`${project.title}, interactive report in Power BI style`}>
  <!-- App header, as in app.powerbi.com -->
  <header class="svc-head">
    <span class="waffle" aria-hidden="true">{Array.from({ length: 9 }, () => <i></i>)}</span>
    <svg viewBox="0 0 24 24" class="size-5 shrink-0" aria-hidden="true">
      <rect x="3" y="10" width="4.5" height="11" rx="1" fill="#f2c811" />
      <rect x="9.75" y="6" width="4.5" height="15" rx="1" fill="#f2c811" opacity="0.85" />
      <rect x="16.5" y="2.5" width="4.5" height="18.5" rx="1" fill="#f2c811" opacity="0.7" />
    </svg>
    <span class="whitespace-nowrap font-semibold">Power BI</span>
    <span class="crumbs min-w-0">
      <span class="hide-sm">{profile.name}</span>
      <span class="hide-sm" aria-hidden="true">›</span>
      <span class="truncate">{project.title}</span>
    </span>
    <span class="search hide-md" aria-hidden="true"><Icon name="search" size={14} /> Search</span>
    <span class="avatar" aria-hidden="true">TV</span>
  </header>

  <!-- Action bar: Export downloads the real .pbix when the repo has one -->
  <div class="svc-actions">
    <span class="act" aria-hidden="true">File <Icon name="chevron-down" size={13} /></span>
    {
      pbix ? (
        <a href={repoFile(project.repo, pbix.file)} class="act act-link" data-goatcounter-click={`pbix-${project.slug}`} title="Download the .pbix file">
          <Icon name="download" size={14} /> Export .pbix
        </a>
      ) : (
        <span class="act" aria-hidden="true">Export <Icon name="chevron-down" size={13} /></span>
      )
    }
    <span class="act hide-sm" aria-hidden="true">Share</span>
    <span class="ml-auto act hide-sm" aria-hidden="true">Reset to default</span>
    <span class="act hide-sm" aria-hidden="true">View <Icon name="chevron-down" size={13} /></span>
    <span class="reading hide-sm ml-auto sm:ml-0">Reading view</span>
  </div>

  <div class="svc-body">
    <nav class="svc-pages" aria-label="Report pages">
      <p class="pane-title">Pages</p>
      <div role="tablist" aria-orientation="vertical">
        {
          pages.map((p, i) => (
            <button type="button" role="tab" class="page-item" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`${id}-${i}`} data-pbi-tab={i}>
              {p.label}
            </button>
          ))
        }
      </div>
    </nav>

    <div class="svc-canvas">
      {
        pages.map((p, i) => (
          <div class="pbi-page" role="tabpanel" id={`${id}-${i}`} aria-label={p.label} hidden={i > 0} data-pbi-page={i}>
            {'image' in p && p.image ? (
              <div class="pbi-shot">
                <Image src={projectImage(project.slug, p.image.file)} alt={p.image.caption} widths={[800, 1200, 1600]} sizes="(min-width: 1152px) 900px, 100vw" class="h-auto w-full" />
              </div>
            ) : (
              <div class="pbi-canvas">
                <slot />
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Footer: page navigation, zoom, and full screen -->
  <footer class="svc-foot">
    <span class="brand hide-sm">Microsoft Power BI</span>
    <span class="pager">
      <button type="button" class="foot-btn" aria-label="Previous page" data-pbi-prev><Icon name="chevron-left" size={16} /></button>
      <span data-pbi-count>1 of {pages.length}</span>
      <button type="button" class="foot-btn" aria-label="Next page" data-pbi-next><Icon name="chevron-right" size={16} /></button>
    </span>
    <span class="zoom hide-sm" aria-hidden="true">− <span class="zoom-track"><i></i></span> + 100%</span>
    <button type="button" class="foot-btn" aria-label="Full screen" title="Full screen" data-pbi-full><Icon name="maximize" size={15} /></button>
  </footer>
</figure>

<style>
  /* Power BI's own light chrome in every site theme. Re-pointing the site's
     tokens here makes the demos' utility classes render in Power BI colors. */
  .pbi-window {
    container: svc / inline-size;
    color-scheme: light;
    --color-strong: #252423;
    --color-ink: #252423;
    --color-muted: #605e5c;
    --color-line: #e1dfdd;
    --color-soft: #f3f2f1;
    --color-surface: #ffffff;
    --color-teal-ink: #0b5394;
    --color-cyan: #118dff;
    --color-teal: #118dff;
    --chip-bg: #ffffff;
    --chip-border: #c8c6c4;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #c8c6c4;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #252423;
    font-family: 'Segoe UI', 'Segoe UI Web (West European)', -apple-system, 'Public Sans Variable', system-ui, sans-serif;
    box-shadow: 0 24px 60px -30px rgb(15 39 87 / 0.45);
  }
  .pbi-window:fullscreen {
    border: 0;
    border-radius: 0;
  }
  .pbi-window:fullscreen .svc-body {
    flex: 1;
    min-height: 0;
  }
  .pbi-window:fullscreen .svc-canvas {
    overflow: auto;
  }

  .svc-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    background: #201f1e;
    color: #ffffff;
    font-size: 0.875rem;
  }
  .waffle {
    display: grid;
    grid-template-columns: repeat(3, 3px);
    gap: 3px;
    padding: 0.25rem;
  }
  .waffle i {
    width: 3px;
    height: 3px;
    background: #fff;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.75rem;
    border-left: 1px solid rgb(255 255 255 / 0.25);
    color: rgb(255 255 255 / 0.85);
  }
  .search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: 14rem;
    height: 1.875rem;
    margin-left: auto;
    padding: 0 0.625rem;
    border-radius: 0.25rem;
    background: #ffffff;
    color: #605e5c;
    font-size: 0.8125rem;
  }
  .avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    margin-left: auto;
    border-radius: 999px;
    background: #0e7a8a;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .search + .avatar {
    margin-left: 0;
  }

  .svc-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.5rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid #e1dfdd;
    background: #ffffff;
    font-size: 0.8125rem;
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    color: #252423;
    cursor: default;
  }
  .act-link {
    cursor: pointer;
  }
  .act-link:hover {
    background: #f3f2f1;
  }
  .reading {
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    background: #f3f2f1;
    color: #252423;
    font-weight: 600;
  }

  .svc-body {
    display: flex;
    min-height: 0;
    background: #eaeaea;
  }
  .svc-pages {
    display: none;
    flex-shrink: 0;
    width: 12.5rem;
    border-right: 1px solid #e1dfdd;
    background: #ffffff;
    font-size: 0.8125rem;
  }
  .pane-title {
    padding: 0.875rem 1rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .page-item {
    display: block;
    width: 100%;
    padding: 0.5rem 1rem;
    border-left: 3px solid transparent;
    color: #252423;
    text-align: left;
    cursor: pointer;
  }
  .page-item:hover {
    background: #f3f2f1;
  }
  .page-item[aria-selected='true'] {
    border-left-color: #f2c811;
    background: #edebe9;
    font-weight: 600;
  }
  .svc-canvas {
    flex: 1;
    min-width: 0;
    padding: 0.75rem;
  }
  .pbi-shot {
    background: #ffffff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.16);
  }

  /* The report page: a light page background with white visuals, and the demo's
     controls as the Filters pane on the right (a strip on top when narrow). */
  .pbi-canvas {
    container: pbi / inline-size;
    background: #ffffff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.16);
  }
  .pbi-canvas :global(.demo) {
    padding-block: 0.875rem;
    background: #f3f3f6;
  }
  .pbi-canvas :global(.demo > *) {
    margin-inline: 0.875rem;
  }
  .pbi-canvas :global([data-pbi-filters]) {
    margin: -0.875rem 0 0.875rem !important;
    padding: 0.875rem !important;
    border: 0 !important;
    border-bottom: 1px solid #e1dfdd !important;
    border-radius: 0 !important;
    background: #ffffff !important;
  }
  .pbi-canvas :global([data-pbi-filters])::before {
    content: 'Filters';
    display: block;
    width: 100%;
    margin-bottom: 0.25rem;
    color: #252423;
    font-size: 1rem;
    font-weight: 600;
  }
  @container pbi (min-width: 720px) {
    .pbi-canvas :global(.demo) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 14.5rem;
      align-items: start;
      background: linear-gradient(to right, #f3f3f6 calc(100% - 14.5rem), #ffffff 0);
    }
    .pbi-canvas :global(.demo > *) {
      grid-column: 1;
    }
    .pbi-canvas :global([data-pbi-filters]) {
      grid-column: 2;
      grid-row: 1 / span 30;
      align-self: stretch;
      display: flex !important;
      flex-direction: column;
      gap: 0.875rem;
      margin: -0.875rem 0 !important;
      border-bottom: 0 !important;
      border-left: 1px solid #e1dfdd !important;
    }
  }

  .svc-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.5rem;
    padding: 0 0.5rem 0 0.875rem;
    border-top: 1px solid #e1dfdd;
    background: #ffffff;
    color: #252423;
    font-size: 0.75rem;
  }
  .brand {
    color: #605e5c;
    font-weight: 600;
  }
  .pager {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline: auto;
    font-variant-numeric: tabular-nums;
  }
  .foot-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    color: #252423;
    cursor: pointer;
  }
  .foot-btn:hover {
    background: #f3f2f1;
  }
  .foot-btn:disabled {
    color: #c8c6c4;
    cursor: default;
    background: none;
  }
  .zoom {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #605e5c;
  }
  .zoom-track {
    position: relative;
    width: 5rem;
    height: 2px;
    background: #8a8886;
  }
  .zoom-track i {
    position: absolute;
    top: -4px;
    left: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #252423;
  }

  /* Phone: the Power BI mobile layout, with no Pages pane and a slim header. */
  @container svc (max-width: 639px) {
    .hide-sm {
      display: none;
    }
    .svc-canvas {
      padding: 0.5rem;
    }
  }
  @container svc (max-width: 899px) {
    .hide-md {
      display: none !important;
    }
  }
  @container svc (min-width: 900px) {
    .svc-pages {
      display: block;
    }
    .svc-canvas {
      padding: 1rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pbi]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-pbi-tab]')];
    const pages = [...root.querySelectorAll<HTMLElement>('[data-pbi-page]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-pbi-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-pbi-next]')!;
    const count = root.querySelector<HTMLElement>('[data-pbi-count]')!;
    let current = 0;
    const show = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        if (i === j && focus) t.focus();
      });
      pages.forEach((p, j) => (p.hidden = i !== j));
      count.textContent = `${i + 1} of ${pages.length}`;
      prev.disabled = i === 0;
      next.disabled = i === pages.length - 1;
      window.dispatchEvent(new Event('resize')); // charts on a re-shown page need a resize
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (dir) {
          e.preventDefault();
          show((i + dir + tabs.length) % tabs.length, true);
        }
      });
    });
    prev.addEventListener('click', () => current > 0 && show(current - 1));
    next.addEventListener('click', () => current < pages.length - 1 && show(current + 1));

    // Full screen, like the Service's full-screen view; hidden where unsupported (iPhone).
    const full = root.querySelector<HTMLButtonElement>('[data-pbi-full]')!;
    if (!root.requestFullscreen) full.hidden = true;
    full.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else root.requestFullscreen().catch(() => {});
    });
    show(0);
  });
</script>
