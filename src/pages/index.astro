---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MotionGraphic from '../components/MotionGraphic.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/photo/thanh-portrait.jpg';
import { credentials, dashboardSlugs, education, experience, profile, projects, skills } from '../data/portfolio';

// Six projects, one strength each: pipelines, warehousing, ML evaluation, BI, statistics, reporting.
const featuredOrder = ['can-mail-data-predict-housing-vacancy', 'grocery-transaction-data-warehouse', 'vacancy-nowcast-ml', 'sales-planning-analysis', 'medical-cost-regression', 'lancaster-economic-indicators-dashboard'];
const featured = featuredOrder.map((slug) => projects.find((p) => p.slug === slug)!).filter(Boolean);
const facts = [
  { label: 'Now', value: 'Data Analyst Fellow, EDC Lancaster County' },
  { label: 'Education', value: `${education.degree}, ${education.school}, ${education.honorsShort}` },
  { label: 'Certified', value: 'Fabric Data Engineer Associate (DP-700)' },
  { label: 'Based in', value: profile.location },
];
---

<Base>
  <!-- Hero and About share a scroll stage: on laptops the page holds while the
       accent band sweeps across, the hero pans out left, and About pans in. -->
  <div class="stage" data-stage>
  <div class="stage-pin">
  <!-- Hero: a measured grid with my name, my photo, and my role. -->
  <section id="home" class="border-b border-line">
    <div class="frame hero">
      <p class="h-blurb rise" style="--d:0">
        
        <span class="lg:hidden">Data engineer and analyst. I build pipelines, warehouses, and Power BI reports. At EDC Lancaster County I turn federal data (BLS, BEA) into dashboards that refresh daily.</span>
        <span class="hidden lg:inline">I build data pipelines, warehouses, and Power BI reports. At EDC Lancaster County I turn federal data (BLS, BEA) into star-schema dashboards that refresh daily.</span>
        <span class="h-proofs">
        <a href="/projects/can-mail-data-predict-housing-vacancy" class="h-proof" aria-label="Case study: USPS mail data vs Census vacancy">
          <span class="h-proof-n">Mail tracks vacancy overall (<span class="nb">r = 0.77</span>), not in one county <Icon name="arrow-right" size={16} /></span>
          <span class="h-proof-t">USPS mail data vs Census vacancy: r is 0.77 pooled and −0.01 in one county. Read the case study.</span>
        </a>
        <a href="/projects/melbourne-housing-price-prediction" class="h-proof">
          <span class="h-proof-n">Model error 13.1% on random folds, 18–38% on a new region <Icon name="arrow-right" size={16} /></span>
          <span class="h-proof-t">Melbourne housing: tested on regions the model never saw. Read the case study.</span>
        </a>
        </span>
        <span class="h-cred">Data Analyst Fellow, EDC Lancaster County · {education.degree}, {education.school} · {education.gpa}</span>
        <span class="h-stack mono" aria-label="Main tools">SQL · Python · Power BI · DAX · Microsoft Fabric · scikit-learn</span>
      </p>
      <h1 class="h-name display" aria-label="Thanh Vu">
        <span class="line"><span style="--d:1">Thanh</span></span>
        <span class="line"><span style="--d:2">Vu</span></span>
      </h1>
      <!-- The pipeline at work: records flow from raw files through the
           Bronze, Silver, and Gold layers into a Power BI chart. -->
      <div class="h-band" aria-hidden="true">
        <div class="pipe">
          <span class="pipe-track">{[-7, 5, -3, 8, -6, 2, 7, -4].map((y, i) => <span class="pkt" style={`--i:${i};--jy:${y}px`}></span>)}</span>
          <ol class="pipe-nodes">
            <li><span class="pn pn-raw"></span><span class="pl mono">Raw</span></li>
            <li><span class="pn pn-bronze"></span><span class="pl mono">Bronze</span></li>
            <li><span class="pn pn-silver"></span><span class="pl mono">Silver</span></li>
            <li><span class="pn pn-gold"></span><span class="pl mono">Gold</span></li>
            <li><span class="pn pn-bi"><i></i><i></i><i></i><i></i></span><span class="pl mono">Power BI</span></li>
          </ol>
        </div>
      </div>
      <figure class="h-photo">
        <div class="frame-img">
          <Image
            src={portrait}
            alt="Portrait of Thanh Vu"
            widths={[360, 520, 720, 960]}
            sizes="(min-width: 1024px) 28vw, 92vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover object-[50%_22%]"
          />
        </div>
        <figcaption class="mono mt-2.5">Lancaster, PA</figcaption>
      </figure>
      <p class="h-role display rise" style="--d:3">Data engineer<br /><span class="text-accent-ink">&amp; analyst</span></p>
      <a href="#projects" class="h-go go">
        <span class="arr"><Icon name="arrow-right" size={24} /></span>
        <span class="lbl">See my work</span>
      </a>
      <div class="h-strip">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <li><a href={profile.github} target="_blank" rel="noopener" class="soc" data-goatcounter-click="hero-github">GitHub <Icon name="arrow-up-right" size={13} /></a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener" class="soc" data-goatcounter-click="hero-linkedin">LinkedIn <Icon name="arrow-up-right" size={13} /></a></li>
          <li><a href={`mailto:${profile.email}`} class="soc" data-goatcounter-click="hero-email">Email <Icon name="arrow-up-right" size={13} /></a></li>
          <li class="hidden sm:list-item"><a href="/resume" class="soc">Resume <Icon name="arrow-up-right" size={13} /></a></li>
        </ul>
        <a href="#about" class="mono hidden min-h-11 items-center gap-2 hover:text-strong lg:mr-14 lg:inline-flex">Scroll <Icon name="arrow-down" size={14} class="cue" /></a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">About</span></p>
        <h2 class="ttl section-title" data-reveal>About me</h2>
      </div>
      <div class="about">
        <dl class="facts">
          {
            facts.map((f) => (
              <div data-reveal>
                <dt class="mono">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="about-txt" data-reveal>
          <p>
            At EDC Lancaster County I turn federal data from <mark>BLS, BEA, Census, and USPS</mark> into Power BI reports that refresh every day, so staff can brief officials and investors without rebuilding a spreadsheet first.
          </p>
          <p>
            In personal projects I build the same way: land raw data once, clean it, test it, model it. Projects include a <mark>131M-row SQL Server warehouse</mark> and a Fabric pipeline.
          </p>
          <dl class="about-stats">
            <div><dt class="mono">Warehouse</dt><dd>131M+ transaction lines</dd></div>
            <div><dt class="mono">Vacancy study</dt><dd>84 county-years, 6 counties</dd></div>
            <div><dt class="mono">Model testing</dt><dd>13,580 Melbourne sales</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
  </div>
  </div>

  <!-- Selected work -->
  <section id="projects" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">Selected work<br />{projects.length} projects in total</span></p>
        <h2 class="ttl section-title" data-reveal>Selected work</h2>
      </div>
      <div class="work" data-showcase>
        <div class="sc-stage">
          <span class="sc-cursor" aria-hidden="true">View</span>
          {
            featured.map((p, i) => (
              <article class="sc-panel" data-panel={i} hidden={i !== 0}>
                <a href={`/projects/${p.slug}`} class="sc-vis" tabindex="-1" aria-hidden="true">
                  {p.animation ? <MotionGraphic slug={p.slug} alt={p.animation} replay={false} /> : null}
                </a>
                <div class="sc-cap">
                  <p class="sc-stat">
                    <span class="display" data-count={p.metrics[0].value}>{p.metrics[0].value}</span>
                    <span>{p.metrics[0].label}</span>
                  </p>
                  <a href={dashboardSlugs.includes(p.slug) ? `/projects/${p.slug}#dashboard` : `/projects/${p.slug}`} class="sc-open">
                    {dashboardSlugs.includes(p.slug) ? 'Open dashboard' : 'Read case study'}
                    <Icon name="arrow-right" size={18} />
                  </a>
                </div>
              </article>
            ))
          }
        </div>
        <div class="sc-dots" role="group" aria-label="Choose a project">
          {featured.map((p, i) => <button type="button" data-dot={i} aria-label={p.title} aria-current={i === 0 ? 'true' : 'false'}></button>)}
        </div>
        <ol class="work-list" aria-label="Projects">
          {
            featured.map((p, i) => (
              <li>
                <a href={`/projects/${p.slug}`} class="work-row" data-pick={i} data-on={i === 0 ? 'true' : 'false'}>
                  <span class="work-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="work-body">
                    <span class="work-ttl">{p.title}</span>
                    <span class="mono">{p.kind.split(' · ')[0]} · {p.year}</span>
                  </span>
                  <span class="work-arr" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <a href="/projects" class="go border-t border-line">
        <span class="arr"><Icon name="arrow-right" size={24} /></span>
        <span class="lbl">See all {projects.length} projects</span>
      </a>
    </div>
  </section>

  <!-- Skills, each group backed by a project -->
  <section id="skills" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">Skills<br />Each group links to proof</span></p>
        <h2 class="ttl section-title" data-reveal>Skills</h2>
      </div>
      <ul class="skill-rows">
        {
          skills.map((g, n) => (
            <li class="skill" data-reveal style={`--reveal-delay:${n * 70}ms`}>
              <div class="skill-head">
                <span class="mono">0{n + 1}</span>
                <h3 class="display-md skill-h text-lg">{g.group}</h3>
              </div>
              <ul class="skill-list">
                {g.items.map((i) => (
                  <li class="skill-item">{i}</li>
                ))}
              </ul>
              <a href={g.proof.href} class="proof">
                <span class="mono">Seen in</span>
                <span class="flex items-start justify-between gap-2"><span>{g.proof.label}</span> <Icon name="arrow-right" size={18} class="mt-0.5 shrink-0" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Experience and education -->
  <section id="experience" class="border-b border-line">
    <div class="frame">
      <div class="shead">
        <p class="idx"><span class="sq"></span><span class="mono">Experience</span></p>
        <h2 class="ttl section-title" data-reveal>Experience</h2>
      </div>
      <ol>
        {
          experience.map((job) => (
            <li class:list={['job', { 'is-now': 'current' in job && job.current }]} data-reveal>
              <p class="job-when mono">
                {job.dates}
                <br />
                {job.location}
              </p>
              <div class="job-what">
                <h3 class="display-md text-[1.375rem] md:text-[1.625rem]">{job.role}</h3>
                <p class="mt-1 font-medium text-strong">{job.company}</p>
                <p class="mt-2 max-w-[38rem] leading-relaxed text-muted">{job.bullets[0]}</p>
              </div>
              <ul class="job-tags flex flex-wrap content-start gap-x-3 gap-y-1" aria-label="Tools used">
                {job.tech.map((t) => (
                  <li class="job-tag">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <div id="education" class="cells md:grid-cols-3">
        <div class="edu" data-reveal>
          <h3 class="display-md text-xl">{education.school}</h3>
          <p class="mt-2 text-muted">Education · {education.degree}, {education.date}. {education.gpa.replace(' · ', ', ')}. {education.honorsShort}.</p>
          <a href="/academics" class="text-link mt-4 inline-block text-[0.9375rem]">Coursework and projects</a>
        </div>
        {
          credentials.map((c) => (
            <div class="edu" data-reveal>
              <h3 class="display-md text-xl">{c.title.replace('Microsoft Certified: ', '')}</h3>
              <p class="mt-2 text-muted">Certification · {c.detail.split(' · ').reverse().slice(0, 2).reverse().join(', ')}</p>
              {'note' in c && <p class="mono mt-3">{c.note}</p>}
            </div>
          ))
        }
      </div>
      <a href="/resume" class="go border-t border-line">
        <span class="arr"><Icon name="arrow-right" size={24} /></span>
        <span class="lbl">View full resume</span>
      </a>
    </div>
  </section>

  <div class="frame">
    <ContactSection />
  </div>
</Base>

<style>
  .work {
    display: grid;
    gap: 1.5rem;
    padding: 0 1rem 1rem;
  }
  .sc-stage {
    position: relative;
    touch-action: pan-y;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .sc-panel:not([hidden]) {
    animation: sc-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes sc-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .sc-vis {
    display: block;
  }
  .sc-dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: -0.75rem;
  }
  .sc-dots button {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .sc-dots button::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-line);
    transform: translate(-50%, -50%);
    transition: width 350ms cubic-bezier(0.22, 1, 0.36, 1), background 250ms;
  }
  .sc-dots button[aria-current='true']::after {
    width: 1.6rem;
    background: var(--color-accent);
  }
  @media (min-width: 1024px) {
    .sc-dots {
      display: none;
    }
  }
  .sc-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .sc-stat {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .sc-stat .display {
    font-size: 2rem;
    color: var(--color-strong);
  }
  .sc-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-strong);
    border-bottom: 1px solid var(--color-accent);
    transition: gap 300ms cubic-bezier(0.22, 1, 0.36, 1), color 200ms;
  }
  @media (hover: hover) and (pointer: fine) {
    .sc-open:hover {
      gap: 0.9rem;
      color: var(--color-accent);
    }
  }
  .work-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 1.1rem 0.25rem;
    text-align: left;
    text-decoration: none;
    background: none;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-line) 55%, transparent);
    cursor: pointer;
    transition: padding-left 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-list li:first-child .work-row {
    border-top: 0;
  }
  .work-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-row[data-on='true'] {
    opacity: 1;
  }
  .work-row[data-on='true']::before {
    transform: scaleX(var(--p, 1));
  }
  .work.auto .work-row[data-on='true']::before {
    transition: none;
  }
  .sc-cursor {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .sc-cursor {
      position: absolute;
      left: 0;
      top: 0;
      z-index: 3;
      display: grid;
      place-items: center;
      width: 4.5rem;
      height: 4.5rem;
      margin: -2.25rem 0 0 -2.25rem;
      border-radius: 50%;
      background: var(--color-accent);
      color: var(--color-strong-on-accent, #0b1b33);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      pointer-events: none;
      opacity: 0;
      scale: 0.4;
      transition: opacity 200ms, scale 300ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sc-cursor.on {
      opacity: 1;
      scale: 1;
    }
  }
  .work-row:hover,
  .work-row:focus-visible {
    opacity: 1;
  }
  .work-row:focus-visible,
  .sc-open:focus-visible {
    outline: 2px solid var(--color-accent-ink);
    outline-offset: 2px;
  }
  .work-no {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .work-row[data-on='true'] .work-no {
    color: var(--color-accent-ink);
  }
  .work-body {
    display: grid;
    gap: 0.35rem;
  }
  .work-ttl {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.55vw, 1.5rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color 300ms;
  }
  .work-row[data-on='true'] .work-ttl {
    color: var(--color-strong);
  }
  .work-arr {
    color: var(--color-muted);
    transform: translateX(-6px);
    opacity: 0;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 300ms, color 300ms;
  }
  .work-row[data-on='true'] .work-arr {
    opacity: 1;
    transform: none;
    color: var(--color-accent);
  }
  @media (min-width: 1024px) {
    .work {
      align-items: center;
      grid-template-columns: 1.35fr 1fr;
      gap: 0 clamp(2rem, 4vw, 4.5rem);
      padding: 0 clamp(1rem, 3vw, 3rem) 1rem;
    }
    .work-row {
      padding: 1.15rem 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-panel:not([hidden]) {
      animation: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'blurb' 'name' 'photo' 'role' 'lab1' 'go' 'strip';
  }
  .h-blurb {
    grid-area: blurb;
    text-wrap: balance;
    max-width: 22rem;
    padding: 2rem 1rem 0;
    color: var(--color-strong);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .h-name {
    grid-area: name;
    padding: 1.75rem 1rem 2rem;
    font-size: clamp(3.5rem, 17.5vw, 9.75rem);
  }
  .h-name .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .h-name .line > span {
    display: block;
    animation: up 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--d) * 110ms);
  }
  .h-lab1 {
    grid-area: lab1;
    display: none;
  }
  .h-band {
    grid-area: band;
    height: 6.25rem;
    padding: 0 1rem 1rem;
  }
  .h-photo {
    grid-area: photo;
    padding: 0 1rem 1.75rem;
  }
  .frame-img {
    aspect-ratio: 1 / 1.04;
    overflow: hidden;
    border: 1px solid var(--color-strong);
    background: var(--color-surface);
    animation: wipe 1200ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
  }
  .frame-img :global(img) {
    animation: settle 1800ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
  }
  .h-role {
    grid-area: role;
    padding: 1.75rem 1rem 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-strong);
    font-size: clamp(2rem, 8.5vw, 6rem);
  }
  .h-lab2 {
    grid-area: lab2;
    display: none;
  }
  .h-go {
    grid-area: go;
    border-top: 1px solid var(--color-line);
  }
  .h-strip {
    grid-area: strip;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1rem;
    border-top: 1px solid var(--color-line);
  }
  .soc {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    color: var(--color-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (hover: hover) and (pointer: fine) {
    .soc:hover {
      color: var(--color-accent-ink);
    }
  }
  .cue {
    animation: nudge 2.4s ease-in-out 3;
  }

  @media (min-width: 640px) {
    .h-photo {
      max-width: 32rem;
    }
    .h-name,
    .h-role,
    .h-blurb,
    .h-photo,
    .h-strip {
      padding-inline: 2.5rem;
    }
  }

  /* Phones and tablets: name with a small photo beside it, then the role,
     a one-line blurb, and the button, all on the first screen. */
  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name photo' 'band band' 'role role' 'blurb blurb' 'go go' 'strip strip';
    }
    .h-name {
      align-self: center;
      padding: 1.75rem 0.75rem 1.5rem 1rem;
