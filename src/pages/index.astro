---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import heroPhoto from '../assets/photo/thanh-hero.jpg';
import { bio, courseworkGroups, credentials, education, experience, profile, projects, skills } from '../data/portfolio';
import { projectImage } from '../lib/images';

const featuredCover = projectImage(projects[0].slug, projects[0].cover);
---

<Base>
  <!-- Hero -->
  <section id="home" class="hero relative isolate flex min-h-dvh items-center overflow-hidden">
    <div class="hero-mesh" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="container-page grid items-center gap-12 pb-28 pt-28 lg:grid-cols-[1.15fr_1fr]">
      <div class="hero-copy order-2 text-center lg:order-1 lg:text-left">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm text-white/90 backdrop-blur">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-teal opacity-70 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-teal"></span>
          </span>
          {profile.availability}
        </p>
        <h1 class="mt-6 text-5xl font-bold tracking-tight text-white md:text-7xl">{profile.name}</h1>
        <p class="mt-4 h-[1.3em] overflow-hidden text-2xl font-light text-white/90 md:text-3xl">
          <span class="inline-block" data-rotate={profile.roles.join('|')}>{profile.roles[0]}</span>
        </p>
        <p class="mx-auto mt-6 max-w-xl text-lg text-white/80 lg:mx-0">{profile.tagline}</p>
        <p class="mt-3 text-white/75">
          <span class="block">Data Analyst Fellow at EDC Lancaster County</span>
          <span class="block">Microsoft Certified: Fabric Data Engineer Associate (DP-700)</span>
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
          <a href="#projects" class="btn btn-teal shadow-lg shadow-teal/20" data-magnetic>View Projects</a>
          <a href="#contact" class="btn btn-glass" data-magnetic>Contact Me</a>
          <a href="/resume" class="btn btn-glass" data-magnetic>
            <Icon name="download" size={16} />
            Resume
          </a>
        </div>

        <div class="mt-8 flex justify-center gap-2 lg:justify-start">
          <a href={profile.linkedin} target="_blank" rel="noopener" class="hero-icon" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
          <a href={profile.github} target="_blank" rel="noopener" class="hero-icon" aria-label="GitHub"><Icon name="github" size={20} /></a>
          <a href={`mailto:${profile.email}`} class="hero-icon" aria-label="Email"><Icon name="mail" size={20} /></a>
        </div>
      </div>

      <div class="hero-photo order-1 flex justify-center lg:order-2 lg:justify-end">
        <div class="relative">
          <div class="photo-ring absolute -inset-4 rounded-full" aria-hidden="true"></div>
          <div class="absolute -inset-10 rounded-full bg-teal/25 blur-3xl" aria-hidden="true"></div>
          <Image
            src={heroPhoto}
            alt="Thanh Vu"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 384px, 256px"
            loading="eager"
            fetchpriority="high"
            class="relative size-64 rounded-full border-8 border-white/90 object-cover shadow-2xl md:size-80 lg:size-96"
          />
        </div>
      </div>
    </div>

    <a href="#about" class="scroll-cue absolute bottom-24 left-1/2 hidden -translate-x-1/2 text-white/80 hover:text-white md:block" aria-label="Scroll to About">
      <Icon name="arrow-down" size={26} />
    </a>
  </section>

  <!-- Bento highlights -->
  <section aria-label="Highlights" class="relative z-10 -mt-20">
    <div class="container-page">
      <div class="bento grid gap-4 md:grid-cols-4 md:grid-rows-[auto_auto]" data-stagger>
        <!-- Current role -->
        <div class="card sheen p-6 md:col-span-2 md:p-8" data-tilt>
          <p class="flex items-center gap-2 text-sm font-semibold text-teal-ink">
            <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-teal opacity-70 motion-reduce:hidden"></span><span class="relative inline-flex size-2 rounded-full bg-teal"></span></span>
            Now
          </p>
          <h3 class="mt-3 text-2xl font-bold leading-snug text-navy">Data Analyst Fellow at EDC Lancaster County</h3>
          <p class="mt-3 text-muted">
            Automated 25+ federal economic data series (BLS, BEA) into a Power BI model with daily refresh, saving the team 15+ hours a month, and built a Gemini-assisted web app 6+ non-technical staff use without code.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {['Power BI', 'Microsoft Fabric', 'Apps Script', 'APIs'].map((t) => <li class="pill">{t}</li>)}
          </ul>
        </div>

        <!-- Certification -->
        <div class="bento-cert relative overflow-hidden rounded-xl p-6 text-white md:p-8">
          <span class="icon-tile bg-white/15 text-teal"><Icon name="award" size={22} /></span>
          <p class="mt-4 text-sm text-white/75">Microsoft Certified</p>
          <h3 class="mt-1 text-xl font-bold leading-snug">Fabric Data Engineer Associate</h3>
          <p class="mt-3 inline-flex rounded-full bg-teal px-3 py-1 text-sm font-bold text-navy">DP-700</p>
          <p class="mt-3 text-xs text-white/60">Credential ID 5CE20E8CF4AC4CE3</p>
        </div>

        <!-- Rows count -->
        <div class="card flex flex-col justify-between p-6 md:p-8">
          <span class="icon-tile"><Icon name="database" size={22} /></span>
          <div class="mt-6">
            <p class="text-5xl font-bold tabular-nums tracking-tight text-navy"><span data-count="131">131</span>M+</p>
            <p class="mt-1 text-sm text-muted">rows modeled in a Medallion warehouse</p>
          </div>
        </div>

        <!-- Featured project -->
        <a href={`/projects/${projects[0].slug}`} class="card sheen group relative overflow-hidden md:col-span-2" data-tilt>
          <div class="grid h-full sm:grid-cols-[1fr_1.1fr]">
            <div class="flex flex-col justify-between p-6 md:p-8">
              <div>
                <p class="text-sm font-semibold text-teal-ink">Featured project</p>
                <h3 class="mt-2 text-xl font-bold leading-snug text-navy group-hover:text-teal-ink">{projects[0].title}</h3>
                <p class="mt-2 text-sm text-muted">Microsoft Fabric pipeline testing USPS data against the Census across 6 counties and 15 years.</p>
              </div>
              <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-navy">
                Read the case study <Icon name="arrow-right" size={15} class="transition-transform group-hover:translate-x-1" />
              </p>
            </div>
            <div class="relative min-h-40 overflow-hidden bg-soft">
              <Image src={featuredCover} alt="" widths={[480, 720]} sizes="(min-width: 768px) 360px, 100vw" class="absolute inset-0 size-full object-cover object-[65%_0%] transition-transform duration-500 group-hover:scale-105" />
            </div>
          </div>
        </a>

        <!-- Projects count -->
        <div class="card flex flex-col justify-between p-6 md:p-8">
          <span class="icon-tile"><Icon name="layers" size={22} /></span>
          <div class="mt-6">
            <p class="text-5xl font-bold tabular-nums tracking-tight text-navy"><span data-count={projects.length}>{projects.length}</span></p>
            <p class="mt-1 text-sm text-muted">end-to-end data projects, all on GitHub</p>
          </div>
        </div>

        <!-- Education -->
        <div class="card flex flex-col justify-between p-6 md:p-8">
          <span class="icon-tile"><Icon name="graduation-cap" size={22} /></span>
          <div class="mt-6">
            <p class="text-5xl font-bold tabular-nums tracking-tight text-navy"><span data-count="3.82" data-decimals="2">3.82</span></p>
            <p class="mt-1 text-sm text-muted">major GPA, B.A. Computer Science, Franklin &amp; Marshall</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="bg-gradient-to-b from-white to-soft/60 py-24">
    <div class="container-page max-w-5xl">
      <h2 class="section-title" data-reveal>About Me</h2>
      <div class="card mt-12 space-y-4 p-6 leading-relaxed text-muted md:p-8 md:text-lg" data-reveal>
        {bio.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="mt-14 text-2xl font-bold text-navy" data-reveal>Relevant Coursework</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-3" data-stagger>
        {
          courseworkGroups.map((g) => (
            <div class="card sheen p-6" data-tilt>
              <div class="flex items-center gap-3">
                <span class="icon-tile">
                  <Icon name={g.icon as 'code'} size={22} />
                </span>
                <h4 class="text-lg font-bold leading-snug text-navy">{g.group}</h4>
              </div>
              <ul class="dot-list mt-5 space-y-2 text-[0.9375rem] text-ink/85">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="bg-white py-24">
    <div class="container-page max-w-5xl">
      <h2 class="section-title" data-reveal>Education</h2>
      <div class="card mt-12 p-6 md:p-8" data-reveal>
        <div class="flex gap-4">
          <span class="icon-tile"><Icon name="graduation-cap" size={22} /></span>
          <div class="min-w-0 flex-1">
            <h3 class="text-2xl font-bold text-navy">Bachelor of Arts, Computer Science</h3>
            <p class="mt-1 text-muted">{education.school}, {education.location}</p>
            <div class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
              <p><span class="font-semibold text-ink">Graduated:</span> <span class="text-muted">{education.date}</span></p>
              <p><span class="font-semibold text-ink">GPA:</span> <span class="font-semibold text-teal-ink">3.72/4.0</span> <span class="text-muted">(Major 3.82)</span></p>
            </div>

            <div class="mt-6 grid gap-6 border-t border-line pt-6 sm:grid-cols-2">
              <div>
                <h4 class="flex items-center gap-2 font-semibold text-ink"><Icon name="award" size={18} class="text-teal-ink" /> Honors &amp; Recognition</h4>
                <ul class="mt-3 space-y-1.5 text-sm text-muted">
                  <li>Dean's List, Spring 2022</li>
                  <li>Honors List, Fall 2021, 2023, 2024, 2025</li>
                </ul>
              </div>
              <div>
                <h4 class="flex items-center gap-2 font-semibold text-ink"><Icon name="award" size={18} class="text-teal-ink" /> Certifications</h4>
                <ul class="mt-3 space-y-1.5 text-sm text-muted">
                  {credentials.map((c) => <li><span class="text-ink">{c.title}</span>, {c.detail.split(' · ').slice(-2).join(', ')}{'note' in c && <span class="block text-xs text-muted">{c.note}</span>}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience (dark) -->
  <section id="experience" class="dark-section relative isolate overflow-hidden py-24 text-white">
    <div class="dark-glow" aria-hidden="true"></div>
    <div class="container-page max-w-5xl">
      <h2 class="section-title section-title-light" data-reveal>Experience</h2>
      <p class="mx-auto mt-6 max-w-2xl text-center text-white/75" data-reveal>
        From ETL pipelines in Hanoi to economic dashboards in Lancaster: four roles, three of them in data.
      </p>
      <div class="timeline relative mt-14 pl-10 md:pl-14" data-timeline>
        <span class="timeline-track" aria-hidden="true"></span>
        <span class="timeline-fill" aria-hidden="true" data-timeline-fill></span>
        <ol class="space-y-8">
        {
          experience.map((job) => (
            <li class="relative" data-reveal>
              <span class:list={['timeline-dot', job.current && 'is-current']} aria-hidden="true" />
              <article class="glass-card p-6 md:p-8">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="text-xl font-bold md:text-2xl">{job.role}</h3>
                    <p class="mt-0.5 text-white/80">{job.company}</p>
                  </div>
                  {job.current && <span class="rounded-full bg-teal px-3 py-1 text-xs font-bold text-navy">Current</span>}
                </div>
                <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-white/70">
                  <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={15} /> {job.dates}</span>
                  <span class="inline-flex items-center gap-1.5"><Icon name="map-pin" size={15} /> {job.location}</span>
                </p>
                <ul class="dot-list mt-4 space-y-2 text-[0.9375rem] leading-relaxed text-white/85">
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tools used">
                  {job.tech.map((t) => <li class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-medium text-white">{t}</li>)}
                </ul>
              </article>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="bg-white py-24">
    <div class="container-page">
      <h2 class="section-title" data-reveal>Skills</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          skills.map((g) => (
            <div class="card sheen p-6" data-tilt>
              <div class="flex items-center gap-3">
                <span class="icon-tile">
                  <Icon name={g.icon as 'code'} size={22} />
                </span>
                <h3 class="text-lg font-bold leading-snug text-navy">{g.group}</h3>
              </div>
              <ul class="dot-list mt-5 space-y-2 text-[0.9375rem] text-ink/85">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="dark-section relative isolate overflow-hidden py-24 text-white">
    <div class="dark-glow dark-glow-right" aria-hidden="true"></div>
    <div class="container-page">
      <h2 class="section-title section-title-light" data-reveal>Featured Projects</h2>
      <p class="mx-auto mt-6 max-w-2xl text-center text-white/75" data-reveal>
        End-to-end work on real public and business data. Each project has the business problem, what I built, the challenges I solved, and the results.
      </p>
      <p class="mt-4 text-center" data-reveal>
        <a href="/projects" class="inline-flex items-center gap-1.5 font-medium text-teal hover:underline">
          View All Projects ({projects.length})
          <Icon name="external-link" size={15} />
        </a>
      </p>
      <div class="mt-8" data-reveal>
        <ProjectCarousel />
      </div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .hero {
    background: linear-gradient(135deg, #0f2757 0%, #175e82 100%);
  }

  /* Slow-drifting color blobs for depth. */
  .hero-mesh {
    position: absolute;
    inset: 0;
    z-index: -2;
    filter: blur(70px);
    opacity: 0.75;
  }
  .blob {
    position: absolute;
    border-radius: 999px;
    mix-blend-mode: screen;
  }
  .blob-a {
    width: 42rem;
    height: 42rem;
    left: -12rem;
    top: -14rem;
    background: #1d4ed8;
    animation: drift-a 22s ease-in-out infinite alternate;
  }
  .blob-b {
    width: 36rem;
    height: 36rem;
    right: -10rem;
    top: 10%;
    background: #0e9aa7;
    animation: drift-b 26s ease-in-out infinite alternate;
  }
  .blob-c {
    width: 30rem;
    height: 30rem;
    left: 30%;
    bottom: -16rem;
    background: #11d4d4;
    opacity: 0.45;
    animation: drift-c 30s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate(10rem, 6rem) scale(1.1);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(-8rem, 8rem) scale(0.9);
    }
  }
  @keyframes drift-c {
    to {
      transform: translate(6rem, -6rem) scale(1.15);
    }
  }

  /* Faint data grid that fades toward the edges. */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at 50% 45%, #000 20%, transparent 75%);
  }

  .photo-ring {
    background: conic-gradient(from 0deg, transparent, rgb(17 212 212 / 0.8), transparent 40%);
    animation: spin 8s linear infinite;
    mask: radial-gradient(circle, transparent 66%, #000 67%);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: rgb(255 255 255 / 0.85);
    transition: background-color 150ms, color 150ms;
  }
  .hero-icon:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  /* One orchestrated entrance on load. */
  .hero-copy > *,
  .hero-photo {
    animation: rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-copy > :nth-child(2) { animation-delay: 80ms; }
  .hero-copy > :nth-child(3) { animation-delay: 160ms; }
  .hero-copy > :nth-child(4) { animation-delay: 240ms; }
  .hero-copy > :nth-child(5) { animation-delay: 300ms; }
  .hero-copy > :nth-child(6) { animation-delay: 360ms; }
  .hero-copy > :nth-child(7) { animation-delay: 420ms; }
  .hero-photo {
    animation-delay: 150ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .scroll-cue {
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translate(-50%, 8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .photo-ring,
    .scroll-cue,
    .hero-copy > *,
    .hero-photo {
      animation: none;
    }
  }
</style>
