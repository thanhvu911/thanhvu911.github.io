---
import { ticker } from '../data/portfolio';
const items = [...ticker, ...ticker];
---

<div class="ticker border-b border-line bg-surface/60 text-[11px] text-muted" aria-label="Highlights">
  <div class="ticker-track flex w-max gap-10 py-2 font-mono">
    {
      items.map((t, i) => (
        <span class="flex items-center gap-10 whitespace-nowrap" aria-hidden={i >= ticker.length ? 'true' : undefined}>
          <span class="inline-block size-1.5 rounded-full bg-accent/80" />
          {t}
        </span>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker-track {
    animation: ticker 48s linear infinite;
  }
  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
