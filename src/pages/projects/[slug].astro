---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { projects, type Project } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const highlightIcons = ['trending-up', 'bar-chart', 'layers', 'target'] as const;
---

<Base title={project.title} description={project.summary}>
  <article class="bg-gradient-to-b from-white to-soft/60 pb-20 pt-28">
    <div class="container-page max-w-5xl">
      <a href="/projects" class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-teal-ink">
        <Icon name="arrow-left" size={16} />
        Back to Projects
      </a>

      <h1 class="mt-6 text-4xl font-bold leading-tight tracking-tight text-navy md:text-5xl">{project.title}</h1>
      <p class="mt-3 text-lg text-muted">{project.kind}, {project.year}</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
        {project.tags.map((t) => <li class="pill">{t}</li>)}
      </ul>

      <section class="card mt-10 p-6 md:p-8" aria-labelledby="overview">
        <h2 id="overview" class="text-2xl font-bold text-navy">Project Overview</h2>
        {project.context && <p class="mt-4 rounded-lg bg-teal-wash px-4 py-3 text-sm text-ink">{project.context}</p>}
        <p class="mt-4 leading-relaxed text-ink/85">{project.summary}</p>
        <p class="mt-3 leading-relaxed text-ink/85">{project.problem}</p>

        <ul class:list={['mt-8 grid gap-4', project.metrics.length === 3 ? 'sm:grid-cols-3' : 'grid-cols-2 sm:grid-cols-4']}>
          {
            project.metrics.map((m, i) => (
              <li class="rounded-xl border border-teal/30 bg-teal-wash/60 p-4 text-center">
                <Icon name={highlightIcons[i % highlightIcons.length]} size={20} class="mx-auto text-teal-ink" />
                <p class="mt-2 text-xl font-bold text-navy">{m.value}</p>
                <p class="text-xs text-muted">{m.label}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card mt-6 p-6 md:p-8" aria-labelledby="approach">
        <h2 id="approach" class="text-2xl font-bold text-navy">What I Did</h2>
        <ul class="dot-list mt-4 space-y-2.5 leading-relaxed text-ink/85">
          {project.approach.map((a) => <li>{a}</li>)}
        </ul>
      </section>

      <section class="card mt-6 p-6 md:p-8" aria-labelledby="results">
        <h2 id="results" class="text-2xl font-bold text-navy">Key Results</h2>
        <ul class="mt-4 space-y-3">
          {
            project.results.map((r) => (
              <li class="flex gap-3 leading-relaxed text-ink/85">
                <Icon name="check" size={18} class="mt-1 shrink-0 text-teal-ink" />
                {r}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card mt-6 p-6 md:p-8" aria-labelledby="gallery">
        <h2 id="gallery" class="text-2xl font-bold text-navy">Dashboards &amp; Diagrams</h2>
        <div class="mt-6">
          <Gallery project={project} />
        </div>
      </section>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={project.repo} target="_blank" rel="noopener" class="btn btn-teal">
          <Icon name="github" size={16} />
          View Code on GitHub
        </a>
        <a href={`/projects/${next.slug}`} class="btn btn-outline">
          Next: {next.title}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </article>
</Base>
